#!/usr/bin/env python3
"""ferry - carry Claude Code sessions between machines, using a git repo.

sync carries a transcript between ~/.claude/projects/<cwd>/ and a store,
whichever way it needs to go: the copy holding everything the other holds, and
more, is the one that gets copied. That is the whole idea - scp with a git repo
in the middle, and a rule that keeps it from ever copying the wrong way.
Nothing runs on its own, nothing is linked, nothing is watched: it does exactly
what you type, when you type it.
"""
import argparse
import base64
import contextlib
import fcntl
import filecmp
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

# Set by the release workflow from the tag it was built for. A copy taken
# straight from the repo says so, rather than claiming to be a release.
__version__ = "0.0.0+dev"

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "ferry"
CONFIG_FILE = CONFIG / "repos.json"
CLAUDE_PROJECTS = Path.home() / ".claude" / "projects"
SLUG_MAX = 200


def die(msg):
    print(f"ferry: {msg}", file=sys.stderr)
    sys.exit(1)


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


# ------------------------------------------------------------------ the slug
# Claude Code stores transcripts in ~/.claude/projects/<slug>/, where the slug
# is the directory's absolute path with every non-alphanumeric character turned
# into a dash. Over 200 characters it is truncated and a hash appended.

def _jhash(s):
    t = 0
    for ch in s:
        t = (t * 31 + ord(ch)) & 0xFFFFFFFF
        t = t - 0x100000000 if t >= 0x80000000 else t
    return t


def slug_dir(path=None):
    p = str(Path(path or Path.cwd()).resolve())
    t = re.sub(r"[^a-zA-Z0-9]", "-", p)
    if len(t) > SLUG_MAX:
        n, digits = abs(_jhash(p)), "0123456789abcdefghijklmnopqrstuvwxyz"
        b36 = ""
        while n:
            n, r = divmod(n, 36)
            b36 = digits[r] + b36
        t = f"{t[:SLUG_MAX]}-{b36 or '0'}"
    return CLAUDE_PROJECTS / t


# ------------------------------------------------------------------ repos

def repos():
    try:
        return json.loads(CONFIG_FILE.read_text())
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError as e:
        die(f"{CONFIG_FILE} is not valid JSON: {e}")


def save_repos(d):
    """Write the registry so that an interrupted write cannot damage it.

    write_text truncates first, so a crash between the two leaves half a file
    and every later command failing on it. Writing beside it and renaming into
    place means the file is either the old one or the new one, never part of
    both - rename is atomic within a filesystem, which is the same guarantee a
    database would be giving you here.
    """
    CONFIG.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_FILE.with_name(CONFIG_FILE.name + f".{os.getpid()}.new")
    try:
        tmp.write_text(json.dumps(d, indent=2, sort_keys=True) + "\n")
        os.replace(tmp, CONFIG_FILE)
    finally:
        if tmp.exists():
            tmp.unlink()


@contextlib.contextmanager
def registry(wait=5.0):
    """The registry, held for a read-modify-write.

    `add`, `rename` and `remove` all read it, change one entry and write it
    back; without this, two at once would both read the old copy and the
    second would undo the first.

    It waits rather than failing outright, because the part it guards is a
    small file being rewritten - milliseconds - and never the clone or the
    push, which are the slow things `add` does. flock is released by the
    kernel when the process ends, so a crash cannot leave it stuck.
    """
    CONFIG.mkdir(parents=True, exist_ok=True)
    lock = CONFIG / "lock"
    fh = lock.open("w")
    until = time.monotonic() + wait
    try:
        while True:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= until:
                    die(f"another ferry is changing the list of stores "
                        f"(waited {wait:g}s). Try again in a moment.")
                time.sleep(0.05)
        d = repos()
        yield d
        save_repos(d)
    finally:
        fh.close()


# What this ferry knows how to read. A store written by a newer ferry says so
# in its marker, and this one stops rather than misreading it - which is what
# the version before this one could not do, and why a store it did not
# understand looked to it like a set of sessions named after uuids.
LAYOUT = 2
MARKER = ".ferry"


def read_layout(repo):
    """The layout a store was written for. 1 is before the marker existed."""
    try:
        for line in (repo / MARKER).read_text().splitlines():
            if line.startswith("layout "):
                return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return 1


def check_layout(repo):
    """Refuse a store this ferry is too old to read.

    Kept unencrypted so it can be read before the store is unlocked - a clone
    that cannot be understood is exactly the case worth being told about.
    """
    found = read_layout(repo)
    if found > LAYOUT:
        die(f"{repo} was written by a newer ferry (store layout {found}, "
            f"this one reads {LAYOUT}).\n"
            f"       upgrade ferry:  curl -fsSL "
            f"https://raw.githubusercontent.com/gielfeldt/ferry/main/install.sh"
            f" | sh")


def mark_layout(repo):
    """Record the layout, and keep the marker readable without the key.

    Returns the paths that need committing, which is nothing at all once a
    store has been marked.
    """
    changed = []
    marker = repo / MARKER
    want = ("# The store layout ferry wrote this with. A ferry too old to read\n"
            "# it will say so rather than guess at what it holds.\n"
            f"layout {LAYOUT}\n")
    if not marker.is_file() or marker.read_text() != want:
        marker.write_text(want)
        changed.append(MARKER)

    # git-crypt encrypts everything by default, and this is the one thing worth
    # reading without the key.
    attrs = repo / ".gitattributes"
    line = f"{MARKER}          !filter !diff"
    try:
        text = attrs.read_text()
    except OSError:
        text = ""
    if text and MARKER not in text:
        attrs.write_text(text.rstrip("\n") + "\n" + line + "\n")
        changed.append(".gitattributes")
    return changed


def repo_dir(alias):
    r = repos().get(alias)
    if not r:
        known = ", ".join(sorted(repos())) or "none yet"
        die(f"unknown store '{alias}' (have: {known})\n"
            f"       ferry add {alias} <git-url>")
    p = Path(r["path"])
    if not p.is_dir():
        die(f"{p} is gone - re-add it:  ferry add {alias} {r.get('url','')}")
    check_layout(p)
    return p


def git(repo, *args, check=True):
    r = subprocess.run(["git", "-C", str(repo), *args],
                       capture_output=True, text=True)
    if check and r.returncode != 0:
        die(f"git {' '.join(args)}:\n{(r.stderr or r.stdout).strip()}")
    return r


def split_ref(ref, directory=False):
    """'work:acme/bug-hunt' -> ('work', 'acme/bug-hunt').

    With directory=True the path names a folder to put something in, and may
    be empty - `work:` means the top of the store.
    """
    if ":" not in ref:
        die(f"'{ref}' should look like <store>:<dir>, e.g. work:acme"
            if directory else
            f"'{ref}' should look like <store>:<path>, e.g. work:acme/bug-hunt")
    alias, _, path = ref.partition(":")
    path = path.strip("/")
    if path.startswith(".") or ".." in path.split("/"):
        die(f"bad path in '{ref}'")
    if not path and not directory:
        die(f"'{ref}' needs a path, e.g. work:acme/bug-hunt")
    return alias, path


# ------------------------------------------------------------------ layout
# A store keeps its two kinds of thing in two trees:
#
#     sessions/<dir>/<name>.jsonl
#     memories/<dir>/<note>.md
#
# Nothing about that reaches the command line: you still say `work:acme`, and
# --memory still says which kind you mean. It is a storage decision, and it is
# the whole reason the two cannot interfere. Memory is written by replacing its
# directory wholesale, so anything sharing that directory would be destroyed
# along with it - here nothing ever can, because transcripts are in the other
# tree. It also means a session may be called `memory` with nothing to resolve.

SESSIONS, MEMORIES = "sessions", "memories"


def in_store(path, memory=False):
    """Where a ref lives on disk. 'acme/bug-hunt' -> 'sessions/acme/bug-hunt'."""
    tree = MEMORIES if memory else SESSIONS
    return f"{tree}/{path}" if path else tree


def of_store(path):
    """The reverse, for anything ferry prints: strip the tree it came from."""
    for tree in (SESSIONS, MEMORIES):
        if path == tree:
            return ""
        if path.startswith(tree + "/"):
            return path[len(tree) + 1:]
    return path


# ------------------------------------------------------------------ sessions

def session_name(jsonl):
    """The name a session answers to, read out of its own transcript.

    Claude Code writes {"type":"custom-title","customTitle":...} whenever the
    name is set - by /rename, by /branch, or by `claude -n` at launch - and
    rewrites it as the session goes on, so the last one is current.

    Reading it here rather than from ~/.claude/history.jsonl is what makes a
    loaded session usable: history is machine-local and does not travel, while
    the transcript is the thing ferry copies.
    """
    name = None
    try:
        with jsonl.open(errors="replace") as fh:
            for line in fh:
                if '"custom-title"' not in line:
                    continue
                try:
                    o = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if o.get("type") == "custom-title" and o.get("customTitle"):
                    name = o["customTitle"]
    except OSError:
        pass
    return name


def names_here(where):
    """name -> transcript, for every named session in a directory."""
    out = {}
    if where.is_dir():
        for f in where.glob("*.jsonl"):
            n = session_name(f)
            if n:
                out[n] = f
    return out


def find_session(spec, where, whose=None):
    """Resolve a name or id prefix to a transcript in `where`.

    `whose` names the directory being searched, for the messages: a ref can
    point at another directory, and saying "here" then sends you to look in
    the wrong one.
    """
    where_said = whose or "this directory"
    if not where.is_dir():
        die(f"no sessions for {where_said} yet")
    here = {f.stem: f for f in where.glob("*.jsonl")}

    named = names_here(where)
    if spec in named:
        return named[spec]

    hits = [f for s, f in here.items() if s.startswith(spec)]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        die(f"'{spec}' matches {len(hits)} sessions in {where_said} - "
            f"use a longer id")

    die(f"no session called '{spec}' in {where_said}."
        + ("" if whose else "  Try:  ferry sessions"))


def ai_title(jsonl):
    """The title Claude gave a session, if it made one.

    Stored as aiTitle on a line near the start when it exists at all - not
    every session has one.
    """
    try:
        with jsonl.open(errors="replace") as fh:
            for line in fh:
                if '"aiTitle"' not in line:
                    continue
                try:
                    t = json.loads(line).get("aiTitle")
                except json.JSONDecodeError:
                    continue
                if t:
                    return t
    except OSError:
        pass
    return None


def first_prompt(jsonl):
    """The opening line of the conversation.

    A transcript need not carry any title at all - no name you set, and no
    aiTitle if Claude never made one. The picker still shows something for
    those, because the conversation itself says what it is about.
    """
    try:
        with jsonl.open(errors="replace") as fh:
            for line in fh:
                if '"type":"user"' not in line:
                    continue
                try:
                    c = (json.loads(line).get("message") or {}).get("content")
                except json.JSONDecodeError:
                    continue
                if isinstance(c, str) and c.strip() and not c.startswith("<"):
                    return " ".join(c.split())
    except OSError:
        pass
    return None


def note_description(md):
    """A one-line summary of a memory note.

    Notes carry a description in YAML frontmatter. Falling back to the first
    heading, then the first real line, means a hand-written note still shows
    something useful instead of a blank column.
    """
    try:
        text = md.read_text(errors="replace")
    except OSError:
        return ""
    lines = text.splitlines()
    if lines and lines[0].strip() == "---":
        for i, line in enumerate(lines[1:], 1):
            if line.strip() == "---":
                break
            if line.startswith("description:"):
                d = line.split(":", 1)[1].strip()
                # Strip one matched pair of quotes, not every quote at the
                # ends - an escaped quote lives right before the closing one.
                if len(d) >= 2 and d[0] == d[-1] and d[0] in "\"'":
                    d = d[1:-1]
                return (d.replace('\\"', '"').replace("\\'", "'")
                         .replace("\\\\", "\\"))
        lines = lines[i + 1:]
    for line in lines:
        line = line.strip()
        if line.startswith("#"):
            return line.lstrip("#").strip()
        if line and not line.startswith("---"):
            return line
    return ""


def session_id_of(jsonl):
    """The id a transcript is currently recorded under.

    The last one, not the first. Resuming a session opens the new transcript
    with the record the old one was interrupted on, and that record still
    carries the old id - so the first id in a resumed transcript names its
    parent. Claude Code agrees: the id it writes into that opening record is
    always the parent's *last* id, which is how the chain refers to itself.

    Taking the first id named a loaded session after its parent, landing it on
    the parent's transcript; and because the child is the larger file, the
    shrink check waved the overwrite straight through.

    Compacting does not change the id: it appends an isCompactSummary record to
    the same transcript, and every one of those carries the file's own id -
    checked across nine versions of Claude Code, one file having been compacted
    nine times.

    Progress and sidechain records are skipped as subagent traffic. Every such
    record seen so far carries the session's own id too, so skipping them
    changes no answer today - but they describe work done on the session's
    behalf rather than whose transcript this is, which is not a distinction
    worth betting on.
    """
    sid = None
    try:
        with jsonl.open(errors="replace") as fh:
            for line in fh:
                if '"sessionId"' not in line:
                    continue
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if record.get("isSidechain") or record.get("type") == "progress":
                    continue
                sid = record.get("sessionId") or sid
    except OSError:
        pass
    return sid


# ------------------------------------------------------------------ copying

def size_delta(src, dest):
    """How much bigger the incoming copy is than the one being replaced.

    Reported instead of a session id, which is the same before and after by
    definition and so says nothing about what a command did.
    """
    new = src.stat().st_size
    if not dest.exists():
        return f"{new/1e6:.1f} MB, new"
    old = dest.stat().st_size
    if new == old:
        return f"{new/1e6:.1f} MB, unchanged"
    d = new - old
    unit = f"{d:+,} bytes" if abs(d) < 100_000 else f"{d/1e6:+.1f} MB"
    return f"{new/1e6:.1f} MB, {unit}"


SAME, AHEAD, BEHIND, FORKED = "same", "ahead", "behind", "forked"

# What the listing says about a session it found in a store. STRANGER is not a
# fork: the two are different conversations that happen to share a name, and
# no amount of merging would reconcile them.
STRANGER = "different session"

# A store whose git-crypt is locked holds ciphertext, so nothing can be read
# out of it and no comparison means anything. That is not the same as the two
# copies disagreeing, and must not be reported as though it were.
UNREADABLE = "unreadable"

# Shown when no store has it. An em dash rather than a blank: "nowhere" is an
# answer, and a gap reads as a column that failed to fill in.
NOWHERE = "\u2014"

STATES = {SAME: "in sync", AHEAD: "ahead", BEHIND: "behind", FORKED: "forked"}


def record_key(line):
    """What makes one transcript line the same as another.

    Keys sorted first, because one record written twice is not always the same
    bytes. The one key is used both to compare two copies and to join them, so
    the two can never disagree about what counts as the same record - a merge
    that deduplicated on a different footing from the comparison could drop a
    record the comparison had just called unique.

    None for a blank line, which is not a record at all.
    """
    line = line.strip()
    if not line:
        return None
    try:
        record = json.loads(line)
    except json.JSONDecodeError:
        # Unparseable, so it can only be taken as it stands.
        return hashlib.sha1(line.encode()).hexdigest()
    keyed = json.dumps(record, sort_keys=True, separators=(",", ":"))
    return hashlib.sha1(keyed.encode()).hexdigest()


def line_set(jsonl):
    """A transcript as the set of records it holds.

    Hashed after sorting each record's keys, because one record written twice
    is not always the same bytes: two copies of a single custom-title record,
    identical in every field and value, can differ in key order alone. Compared
    as bytes that reads as a fork - two sessions on this machine are exactly
    that case. Compared as records it does not.

    A set rather than a list, because metadata records repeat verbatim - mode
    and custom-title are written again and again through a session - and a copy
    holding five of one line knows nothing more than a copy holding three.
    """
    out = set()
    try:
        with jsonl.open(errors="replace") as fh:
            for line in fh:
                key = record_key(line)
                if key:
                    out.add(key)
    except OSError:
        pass
    return out


def relation(mine, theirs):
    """How two copies of one thing relate, by what each holds.

    This decides which way a sync goes, and it decides it by content - not by
    size, not by clock. A copy may only be replaced by one holding everything
    it already held, so a direction is never a guess.

    FORKED means each holds something the other does not. No copy can then be
    made without dropping one of them, which is why sync stops there instead
    of choosing.
    """
    if mine == theirs:
        return SAME
    if theirs < mine:
        return AHEAD
    if mine < theirs:
        return BEHIND
    return FORKED


def encrypted(repo):
    return (repo / ".git" / "git-crypt").is_dir()


def check_encryption(repo, alias, allow):
    if encrypted(repo) or allow:
        return
    die(f"'{alias}' has no git-crypt, so transcripts would be committed in the "
        f"clear.\n       set it up:  cd {repo} && git-crypt init\n"
        f"       or override:  --allow-plaintext")


def has_upstream(repo):
    return (git(repo, "remote", check=False).stdout.strip()
            and git(repo, "rev-parse", "--abbrev-ref", "@{u}",
                    check=False).returncode == 0)


def fetch(repo):
    """Update the remote-tracking ref. Read-only: never fails on divergence."""
    if git(repo, "remote", check=False).stdout.strip():
        git(repo, "fetch", "--quiet", "origin", check=False)


def ahead_behind(repo):
    """(ahead, behind) relative to the upstream, from what was last fetched."""
    if not has_upstream(repo):
        return (0, 0)
    out = git(repo, "rev-list", "--left-right", "--count", "HEAD...@{u}",
              check=False).stdout.split()
    return (int(out[0]), int(out[1])) if len(out) == 2 else (0, 0)


def pull(repo):
    """Fetch and fast-forward. Used by the commands that must be up to date."""
    fetch(repo)
    if not has_upstream(repo):
        return
    if git(repo, "merge", "--ff-only", "@{u}", check=False).returncode != 0:
        ahead, behind = ahead_behind(repo)
        die(f"this clone has diverged from its remote "
            f"({ahead} local commit(s), {behind} on the remote).\n"
            f"       ferry update explains how to sort it out")


def commit_push(repo, message, paths):
    """Commit exactly the paths ferry wrote, and push.

    Never `git add -A`. Blanket staging commits whatever else happens to be in
    the store - editor leftovers, half-finished edits, a key someone dropped
    there - and the whole point of this repo is that its contents are
    deliberate. `paths` are repo-relative and are the only things staged.
    """
    # Whatever else is being written, the store says which layout wrote it -
    # so a ferry too old to read it can say so instead of guessing.
    paths = list(paths) + mark_layout(repo)
    for p in paths:
        # A path that is gone is a removal, and `git add` refuses a pathspec
        # matching nothing rather than staging one. Whatever removed it staged
        # that itself (`move` uses `git mv`), so there is nothing to add here.
        if (repo / p).exists():
            git(repo, "add", "--", p)
    if git(repo, "diff", "--cached", "--quiet", "--", *paths,
           check=False).returncode == 0:
        print("  nothing changed")
        return
    git(repo, "commit", "-q", "-m", message, "--", *paths)
    if git(repo, "remote", check=False).stdout.strip():
        if git(repo, "push", "--quiet", "origin", "HEAD", check=False).returncode:
            die("push rejected - another machine pushed first.\n"
                "       ferry update <repo>, then sync again")
        print("  pushed")


# ------------------------------------------------------------------ commands

def own_clone(alias):
    """Where ferry puts a store it cloned itself."""
    return Path.home() / ".local/share/ferry" / alias


def check_alias(alias):
    if not re.fullmatch(r"[A-Za-z0-9._-]+", alias):
        die("a store name may hold letters, digits, dot, dash and underscore")
    return alias


def cmd_add(args):
    alias = check_alias(args.name)
    known = repos().get(alias)
    if known and args.force:
        # Pointing the name elsewhere leaves the old checkout behind, which is
        # the same trouble as forgetting it.
        trouble = unsaved_work(Path(known["path"]))
        if trouble:
            print(f"  note: the old {alias} had {trouble}", file=sys.stderr)
            print(f"        {known['path']}", file=sys.stderr)
    if known and not args.force:
        die(f"'{alias}' is already a store, at {known['path']}\n"
            f"       ferry rename {alias} <new>   to free the name\n"
            f"       ferry remove {alias}         to forget it\n"
            f"       ferry add {alias} … --force  to point it somewhere else")
    path = Path(args.path).expanduser().resolve() if args.path else \
        own_clone(alias)
    if not (path / ".git").exists():
        if not args.url:
            die("give a git url, or --path to a checkout you already have")
        path.parent.mkdir(parents=True, exist_ok=True)
        print(f"cloning {args.url}")
        r = subprocess.run(["git", "clone", "--quiet", args.url, str(path)],
                           capture_output=True, text=True)
        if r.returncode:
            die(f"clone failed:\n{(r.stderr or r.stdout).strip()}")
    url = args.url or git(path, "remote", "get-url", "origin",
                          check=False).stdout.strip()
    # Held only for the rewrite - the clone above may take minutes, and
    # nothing else should be waiting on it.
    with registry() as d:
        d[alias] = {"url": url, "path": str(path), "added": now()}
    print(f"{alias} -> {path}")

    # A fresh clone of an encrypted store arrives locked. ferry does not manage
    # keys - it just hands yours to git-crypt, so you are not left guessing why
    # every save is refused.
    if args.key:
        key = Path(args.key).expanduser().resolve()
        if not key.is_file():
            die(f"no key at {key}")
        if encrypted(path):
            print("  already unlocked")
        elif not shutil.which("git-crypt"):
            die("git-crypt is not installed")
        else:
            r = subprocess.run(["git-crypt", "unlock", str(key)], cwd=path,
                               capture_output=True, text=True)
            if r.returncode:
                die(f"git-crypt unlock failed:\n{(r.stderr or r.stdout).strip()}")
            print(f"  unlocked with {key}")
    elif not encrypted(path):
        print(f"  locked or unencrypted. If it has a key:  "
              f"ferry add {alias} --path {path} --key <file>")
        print(f"  to encrypt it for the first time:  cd {path} && git-crypt init")


def unsaved_work(repo):
    """What this checkout holds that its remote does not.

    Forgetting a store leaves the directory, so nothing is deleted - but a sync
    that never reached the remote becomes a directory you have to remember,
    which is the same as losing it.
    """
    if not repo.is_dir() or not (repo / ".git").exists():
        return None          # gone, or never a repo: nothing ferry can vouch for
    if git(repo, "status", "--porcelain", check=False).stdout.strip():
        return "uncommitted changes"
    if not has_upstream(repo):
        return "no remote, so this checkout is the only copy"
    ahead, _ = ahead_behind(repo)
    return f"{ahead} commit(s) that are not on the remote" if ahead else None


def cmd_rename(args):
    """Give a store a different name.

    The checkout moves with it when ferry made it, so the directory goes on
    matching the name. One you adopted with --path stays where you put it -
    it was yours before ferry knew about it.
    """
    old, new = args.name, check_alias(args.new)
    with registry() as d:
        if old not in d:
            die(f"unknown store '{old}' "
                f"(have: {', '.join(sorted(d)) or 'none yet'})")
        if new in d:
            die(f"'{new}' is already a store, at {d[new]['path']}")

        path = Path(d[old]["path"])
        if path == own_clone(old):
            moved = own_clone(new)
            if moved.exists():
                die(f"{moved} is in the way")
            path.rename(moved)
            d[old]["path"] = str(moved)
            print(f"{old} -> {new}  ({moved})")
        else:
            print(f"{old} -> {new}  (checkout stays at {path})")
        d[new] = d.pop(old)


def cmd_remove(args):
    """Forget a store. The checkout is left alone.

    ferry did not create most of what is in it and cannot know whether the
    clone is wanted elsewhere, so it says where the directory is and leaves
    removing it to you.
    """
    with registry() as d:
        if args.name not in d:
            die(f"unknown store '{args.name}' "
                f"(have: {', '.join(sorted(d)) or 'none yet'})")
        path = Path(d[args.name]["path"])
        trouble = unsaved_work(path)
        if trouble and not args.force:
            die(f"'{args.name}' has {trouble}.\n"
                f"       {path}\n"
                f"       push it first, or --force to forget it anyway")
        d.pop(args.name)
    print(f"forgot {args.name}")
    print(f"  its checkout is still at {path}")
    print(f"  ferry add {args.name} --path {path}   to register it again")


def cmd_stores(args):
    d = repos()
    if not d:
        print("no stores yet:  ferry add <name> <git-url>")
    for alias in sorted(d):
        p = Path(d[alias]["path"])
        state = "" if p.is_dir() else "  MISSING"
        lock = "" if not p.is_dir() or encrypted(p) else "  NOT ENCRYPTED"
        print(f"  {alias:<14} {p}{state}{lock}")


def export_source(ref):
    """The transcript a ref names. Three forms, one rule.

        bug-hunt                    in the directory you are standing in
        work:acme/bug-hunt          in a store
        ~/develop/acme:bug-hunt     in another directory on this machine

    What is before the colon decides which: a store ferry knows about, or a
    path. Stores are checked first because they are a closed set of names ferry
    can be sure of - so a directory that shares a store's name is reached as
    ./work:bug-hunt, which is a path and cannot be mistaken for one.

    Naming the directory is what makes the third form unambiguous. Session
    names are only unique within a directory, so a bare name searched across
    the machine would sooner or later pick the wrong one silently.
    """
    if ":" not in ref:
        return find_session(ref, slug_dir())

    head, _, tail = ref.partition(":")
    if head in repos():
        alias, path = split_ref(ref)
        src = stored_at(repo_dir(alias), alias, path)
        if src is None or not src.is_file():
            die(f"nothing at {ref}")
        return src

    if not tail:
        die(f"'{ref}' needs a session after the colon, e.g. {head}:bug-hunt")
    where = Path(os.path.expanduser(head))
    if not where.is_dir():
        die(f"no such directory: {head}\n"
            f"       for a store, ferry knows: "
            f"{', '.join(sorted(repos())) or 'none yet'}")
    return find_session(tail, slug_dir(where), whose=str(where))


def render_markdown(jsonl, tools=False, media=None, out=sys.stdout):
    """The conversation, as markdown.

    What is left out is most of the file: tool results, which are the bulk of
    any real session, and the attachment records Claude Code keeps for its own
    bookkeeping - skill listings, task reminders. --tools puts the first back.

    Images cannot go in the text, so they are noted where they appeared and
    written out beside it when asked for.
    """
    name = session_name(jsonl) or jsonl.stem[:8]
    # In a store the filename is the name, so the id has to come from inside -
    # which is where it lives anyway.
    sid = session_id_of(jsonl) or jsonl.stem
    shot = 0
    if media:
        media.mkdir(parents=True, exist_ok=True)

    out.write(f"# {name}\n\n*{sid}*\n")
    first = last = None

    with jsonl.open(errors="replace") as fh:
        for line in fh:
            try:
                o = json.loads(line)
            except json.JSONDecodeError:
                continue
            if o.get("type") not in ("user", "assistant"):
                continue
            when = (o.get("timestamp") or "")[:16].replace("T", " ")
            first = first or when
            last = when or last
            msg = o.get("message") or {}
            body = msg.get("content")

            # A plain string is something you typed; a list is a turn Claude Code
            # assembled, which may be a tool result rather than anything said.
            if isinstance(body, str):
                if body.strip() and not body.startswith("<"):
                    out.write(f"\n## You · {when[11:]}\n\n{body.strip()}\n")
                continue

            for b in body or []:
                if not isinstance(b, dict):
                    continue
                kind = b.get("type")
                if kind == "text" and b.get("text", "").strip():
                    out.write(f"\n## Claude · {when[11:]}\n\n{b['text'].strip()}\n")
                elif kind == "tool_use":
                    out.write(render_tool_use(b, tools))
                elif kind == "tool_result" and tools:
                    r = b.get("content")
                    r = r if isinstance(r, str) else json.dumps(r, indent=2)
                    out.write(fenced(r))
                elif kind == "image":
                    shot += 1
                    out.write(render_image(b, shot, media, jsonl))

    if first:
        out.write(f"\n---\n\n*{first} - {last}*\n")


def render_tool_use(b, tools):
    """A tool call: one line to say it happened, or the whole call."""
    name = b.get("name", "tool")
    args = b.get("input") or {}
    if tools:
        return f"\n**{name}**\n" + fenced(json.dumps(args, indent=2), "json")
    # The one field worth a glance, which is not the same field every time.
    gist = args.get("command") or args.get("file_path") or args.get("pattern") \
        or args.get("description") or json.dumps(args)
    gist = " ".join(str(gist).split())
    if len(gist) > 80:
        gist = gist[:79] + "\u2026"
    return f"\n> **{name}** `{gist}`\n"


def render_image(b, n, media, jsonl):
    """Images cannot go in the text. Note them, or write them out and link.

    The link is the path you asked for, verbatim - `--media shots` links
    `shots/…`, `--media /tmp/shots` links `/tmp/shots/…`. ferry is writing to
    stdout and cannot know where that ends up, so anything cleverer would be a
    guess about where you are going to put the markdown.
    """
    src = b.get("source") or {}
    data = src.get("data") or ""
    kind = (src.get("media_type") or "image/png").split("/")[-1]
    size = len(data) * 3 // 4
    if not media:
        return f"\n> [image \u00b7 {kind} \u00b7 {size // 1024} KB]\n"
    name = f"{jsonl.stem[:8]}-{n}.{kind}"   # enough to tell sessions apart
    try:
        (media / name).write_bytes(base64.b64decode(data))
    except (ValueError, OSError) as e:
        return f"\n> [image {n}: could not be written - {e}]\n"
    return f"\n![image {n}]({media.as_posix()}/{name})\n"


def fenced(text, lang=""):
    """A code block that cannot be broken by backticks in what it holds."""
    text = (text or "").rstrip()
    fence = "```"
    while fence in text:
        fence += "`"
    return f"\n{fence}{lang}\n{text}\n{fence}\n"


def find_note(mem, name):
    """A note by name, with or without the .md - as sessions drop the .jsonl."""
    for candidate in (name, name + ".md"):
        p = mem / candidate
        if p.is_file() and p.parent == mem:
            return p
    return None


def memory_source(ref):
    """What a memory ref names: a directory of notes, or one of them.

        ~/develop/acme                  every note there
        ~/develop/acme:role             just that one
        work:acme                       the store's copy of them
        work:acme/role                  one of those

    The shape a session ref has, with a note where the session name goes. The
    separator differs for the same reason it does there: a path already has
    slashes in it, so the colon is what marks where the path stopped.

    Returns (directory, note or None).
    """
    if ":" in ref:
        head, _, tail = ref.partition(":")
        if head in repos():
            repo = repo_dir(head)
            alias, path = split_ref(ref, directory=True)
            mem = repo / in_store(path, memory=True)
            if mem.is_dir():
                return mem, None
            parent, _, leaf = path.rpartition("/")
            mem = repo / in_store(parent, memory=True)
            note = find_note(mem, leaf) if mem.is_dir() else None
            if note:
                return mem, note
            die(f"no memory at {ref}")
        where, wanted = Path(os.path.expanduser(head)), tail
    else:
        where, wanted = Path(os.path.expanduser(ref)), None

    if not where.is_dir():
        die(f"no such directory: {where}\n"
            f"       for a store, ferry knows: "
            f"{', '.join(sorted(repos())) or 'none yet'}")
    mem = slug_dir(where) / "memory"
    if not mem.is_dir() or not any(mem.glob("*.md")):
        die(f"no memory for {where}")
    if not wanted:
        return mem, None
    note = find_note(mem, wanted)
    if not note:
        die(f"no note called '{wanted}' in {where}.  Try:  ferry memory {where}")
    return mem, note


def render_memory(mem, out=sys.stdout, note=None):
    """A directory's memory as one document, or one note of it.

    The notes are markdown already, so this is mostly a matter of putting them
    in order and saying where each began. Frontmatter is turned into the
    heading it was describing rather than printed as itself.
    """
    if note is not None:
        out.write(f"# {note.name}\n")
        desc = note_description(note)
        body = strip_frontmatter(note.read_text(errors="replace"))
        if desc and desc not in body:
            out.write(f"\n*{desc}*\n")
        out.write("\n" + body.strip() + "\n")
        return

    notes = sorted(p for p in mem.glob("*.md") if p.name != "MEMORY.md")
    index = mem / "MEMORY.md"
    out.write(f"# memory\n\n*{len(notes)} note(s)*\n")

    if index.exists():
        out.write("\n## MEMORY.md\n\n"
                  + index.read_text(errors="replace").strip() + "\n")
    for n in notes:
        text = n.read_text(errors="replace")
        body = strip_frontmatter(text)
        desc = note_description(n)
        out.write(f"\n## {n.name}\n")
        if desc and desc not in body:
            out.write(f"\n*{desc}*\n")
        out.write("\n" + body.strip() + "\n")


def strip_frontmatter(text):
    """The note without its YAML header, which the heading already said."""
    if not text.startswith("---"):
        return text
    end = text.find("\n---", 3)
    return text[end + 4:] if end != -1 else text


def cmd_name(args):
    """Give a session a name, without resuming it to type /rename.

    The name is a record in the transcript, which is why it travels with the
    file - so setting one is a matter of appending the record Claude Code
    would have written. That is the only way to name a session you do not want
    to open: an unnamed 12 MB conversation cannot be saved, and until now the
    only way to fix that was to start it up again.

    Local sessions only. In a store the file is named after the session, so
    naming one there would leave the two disagreeing - which is the thing
    `move` refuses to do for the same reason.
    """
    if ":" in args.session and args.session.partition(":")[0] in repos():
        die("a session in a store cannot be named here - its filename is its "
            "name.\n       sync it here, name it, and sync it back")

    src = export_source(args.session)
    name = args.new
    if not name or name.startswith((".", "-")) or set("/:") & set(name):
        die("a session name becomes a filename in a store, so it cannot hold "
            "'/' or ':', or begin with '.' or '-'")

    was = session_name(src)
    if was == name:
        die(f"{name} is already its name")
    taken = names_here(src.parent).get(name)
    if taken and taken != src:
        die(f"'{name}' is already the name of {taken.stem} in that directory.\n"
            f"       names have to be unique there, or a ref would mean two "
            f"things")

    with src.open("a") as fh:
        fh.write(json.dumps({"type": "custom-title", "customTitle": name,
                             "sessionId": src.stem}) + "\n")
    print(f"{was or src.stem} -> {name}")
    print(f"  claude --resume {name}")


def cmd_export(args):
    """Print a session: as markdown, or exactly as it is on disk."""
    if args.memory:
        if args.raw or args.tools or args.media:
            die("--memory is a directory of notes, so --raw, --tools and "
                "--media have nothing to do there")
        mem, note = memory_source(args.session)
        return render_memory(mem, note=note)

    src = export_source(args.session)
    if args.raw:
        if args.tools or args.media:
            die("--raw is the file itself, so --tools and --media have "
                "nothing to add to it")
        with src.open(errors="replace") as fh:
            shutil.copyfileobj(fh, sys.stdout)
        return
    render_markdown(src, tools=args.tools,
                    media=Path(args.media) if args.media else None)


def sync_send(args, repo, alias, path, src, dest, what):
    """This directory's copy into the store. Only ever when it loses nothing.

    A session is stored under its id. The name is what you call it and what
    every listing shows, but it lives inside the transcript and changes
    whenever you rename - so it cannot also be where the file lives, or a
    rename would leave the store pointing at something that no longer exists.
    Storing by id also keeps the names out of a store's filenames, which
    git-crypt does not encrypt.
    """
    check_encryption(repo, alias, args.allow_plaintext)
    sid = session_id_of(src)
    if not sid:
        die(f"cannot tell which session {src} is - no id inside it")

    # Within a folder a name means one session. That used to be the filesystem's
    # doing - one file could have one name - and stored by id it has to be said.
    # It is reachable by renaming a session onto a name its folder already has,
    # which is one /rename away.
    folder = path.rsplit("/", 1)[0] if "/" in path else ""
    calling = session_name(src)
    if calling:
        for other, entry in sorted(catalogue(repo).items()):
            if (other != sid and entry["name"] == calling
                    and folder_of(entry) == folder):
                die(f"{alias}:{folder or 'the top of the store'} already has a "
                    f"session called '{calling}', and it is a different "
                    f"conversation:\n"
                    f"       this one:  {sid}\n"
                    f"       that one:  {other}\n"
                    f"       /rename one of them, then sync again")

    if dest is None:                        # not in this store yet
        folder = path.rsplit("/", 1)[0] if "/" in path else ""
        dest = repo / SESSIONS / folder / f"{sid}.jsonl"
    leaf = str(dest.relative_to(repo))
    dest.parent.mkdir(parents=True, exist_ok=True)
    delta = size_delta(src, dest)
    shutil.copyfile(src, dest)
    print(f"sent {what} -> {alias}:{path}  ({delta})")
    # The message says where, not what: a store's commit log is not encrypted.
    commit_push(repo, f"session: {folder_of({'path': leaf}) or 'top'}", [leaf])


def sync_receive(alias, path, src, dest):
    """The store's copy into this directory. Only ever when it loses nothing.

    The name travels inside the transcript, so it arrives already named, and
    --resume takes that name as readily as the id.
    """
    dest.parent.mkdir(parents=True, exist_ok=True)
    delta = size_delta(src, dest)
    shutil.copyfile(src, dest)
    print(f"received {alias}:{path}  ({delta})")
    print(f"  resume it here with:  claude --resume "
          f"{session_name(dest) or dest.stem}")


INDEX = "MEMORY.md"


def note_set(where):
    """A memory directory as the notes it holds, by name and content.

    The index is left out. MEMORY.md is a list of the notes rather than a note,
    so it is derivable from the rest and cannot be evidence of anything: two
    copies whose notes agree are in sync whatever their indexes say, and a join
    rebuilds the index rather than keeping either. Counting it here would make
    every difference in the notes look like a difference on both sides, because
    the index differs whenever the notes do.
    """
    out = set()
    if where.is_dir():
        for f in where.rglob("*.md"):
            if f.name == INDEX:
                continue
            out.add((str(f.relative_to(where)),
                     hashlib.sha1(f.read_bytes()).hexdigest()))
    return out


def memory_fork_message(what, ours, theirs):
    """A forked memory directory, and why this one is not joined.

    A transcript is a list of records, so two copies can be joined by keeping
    every record either had. A note is prose: two versions of the same note
    have no join that is not a guess at what the author meant. So memory says
    what differs and stops, where a session does not.

    Notes are compared by name and content together, which puts a note edited
    on both machines in both sets at once. Saying it is "not in the store"
    would be false - it is there, it just says something else - so the three
    ways a note can differ are kept apart.
    """
    a, b = dict(ours), dict(theirs)
    edited = sorted(n for n in a if n in b and a[n] != b[n])
    here = sorted(set(a) - set(b) - set(edited))
    there = sorted(set(b) - set(a) - set(edited))
    lines = [f"{what} has changed in both places."]
    for label, names in (("changed on both sides", edited),
                         ("only here", here), ("only there", there)):
        if names:
            shown = ", ".join(names[:4])
            lines.append(f"       {label}: {shown}"
                         + (", and more" if len(names) > 4 else ""))
    lines.append("       a note has no join that is not a guess at what you "
                 "meant, so\n       nothing was changed. "
                 "ferry export --memory shows the store's.")
    return "\n".join(lines)


def index_entries(mem):
    """The memory index as one line per note, keyed by the note it links to.

    MEMORY.md is not prose - it is a list, written one line to a note:

        - [Fix the design](fix-the-design.md) - guards are evidence …

    So two copies of it join the way a list joins, by the file each line points
    at, and the answer is derivable from the notes rather than guessed at. That
    is what makes memory joinable at all: the index is the part that always
    differs when two machines have written notes, and it is the part that never
    needed a judgement.

    A line that names no note is kept as it stands, under itself, so a heading
    or a note-to-self in the index survives.
    """
    out = {}
    f = mem / INDEX
    if not f.is_file():
        return out
    for line in f.read_text(errors="replace").splitlines():
        found = re.search(r"\]\(([^)]+\.md)\)", line)
        out[found.group(1) if found else line] = line
    return out


def notes_of(mem):
    """The notes in a memory directory, by path within it.

    Nested as well as top-level, and keyed by the relative path, because that
    is what note_set counts - a note in a subdirectory that the comparison sees
    and the join does not would be a note quietly dropped.

    The index is not one of them: it describes notes rather than being one.
    """
    if not mem.is_dir():
        return {}
    return {str(p.relative_to(mem)): p
            for p in sorted(mem.rglob("*.md")) if p.name != INDEX}


def merge_memory(ours, theirs, dest):
    """Join two memory directories into dest, which must not exist yet.

    A note is a file with a name, so notes join the way files join: whatever is
    only here, whatever is only there, and one copy of whatever is on both. The
    index is rebuilt from both indexes, this copy's line winning where both
    describe the same note - it is a description of a note that is being kept
    either way, so neither line can be wrong about anything that matters.

    Only a note that exists on both sides with different contents cannot be
    joined, and that is settled before this is called.
    """
    dest.mkdir(parents=True)
    mine, yours = notes_of(ours), notes_of(theirs)
    for name in sorted(set(mine) | set(yours)):
        src = mine.get(name) or yours[name]
        (dest / name).parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dest / name)
    entries = {**index_entries(theirs), **index_entries(ours)}
    if entries:
        kept = set(mine) | set(yours)
        # A line for a note that is no longer here would send a reader after a
        # file that is not there; a line that names no note is not about one.
        lines = [entries[k] for k in sorted(entries)
                 if not k.endswith(".md") or k in kept]
        (dest / INDEX).write_text("\n".join(lines) + "\n")
    return len(set(mine) | set(yours)), len(set(yours) - set(mine))


def conflicting_notes(ours, theirs):
    """Notes held by both, saying different things. The only part of a memory
    directory that has no join: two versions of one note is prose, and picking
    one is a guess at what was meant."""
    mine, yours = notes_of(ours), notes_of(theirs)
    return sorted(n for n in set(mine) & set(yours)
                  if mine[n].read_bytes() != yours[n].read_bytes())


def sync_memory(args, repo, alias, path, here):
    """The same four states, over a directory of notes rather than a transcript.

    Memory is written by replacing the directory wholesale, so the question is
    the same one: does the copy about to be written hold everything the copy
    being replaced already held?
    """
    theirs, ours = repo / in_store(path, memory=True), here / "memory"
    a, b = note_set(ours), note_set(theirs)
    if not a and not b:
        die(f"no memory here, and none at {alias}:{path}")
    state = relation(a, b)
    if state == SAME:
        print(f"memory {alias}:{path} is already in sync  ({len(a)} note(s))")
        return
    if state == AHEAD:
        check_encryption(repo, alias, args.allow_plaintext)
        replace_dir(ours, theirs)
        print(f"sent memory -> {alias}:{path}  ({len(a)} note(s))")
        return commit_push(repo, f"memory: {path or 'top'}",
                           [in_store(path, memory=True)])
    if state == BEHIND:
        here.mkdir(parents=True, exist_ok=True)
        replace_dir(theirs, ours)
        print(f"received memory {alias}:{path}  ({len(b)} note(s))")
        return

    # Each side holds something the other does not. A note is a file with a
    # name, so notes join the way files join - the directory only refuses when
    # one note exists on both sides saying different things.
    clash = conflicting_notes(ours, theirs)
    if clash:
        die(f"the memory for {alias}:{path} has notes that say different "
            f"things in each place:\n"
            + "".join(f"       {n}\n" for n in clash)
            + f"       a note is prose, and picking one would be a guess at "
              f"what you meant.\n"
              f"       ferry export --memory {alias}:{path} shows the store's; "
              f"reconcile\n       those and sync again. Nothing was changed.")

    # Not the name replace_dir gives its own scratch copy, or it clears this
    # one out from under itself on the way to writing it.
    joined = ours.with_name(f"{ours.name}.ferry-merge-{os.getpid()}")
    try:
        total, gained = merge_memory(ours, theirs, joined)
        for other, side in ((ours, "this copy"), (theirs, "the store's copy")):
            if relation(note_set(joined), note_set(other)) not in (SAME, AHEAD):
                die(f"the merge would not have held every note {side} had, "
                    f"so nothing was changed.\n"
                    f"       this is a bug - please report it")
        check_encryption(repo, alias, args.allow_plaintext)
        here.mkdir(parents=True, exist_ok=True)
        replace_dir(joined, ours)
        replace_dir(joined, theirs)
    finally:
        if joined.is_dir():
            shutil.rmtree(joined)
    print(f"merged memory {alias}:{path}\n"
          f"  {total} note(s), {gained} of them from the store")
    commit_push(repo, f"memory: {path or 'top'}",
                [in_store(path, memory=True)])


def merge_transcripts(ours, theirs):
    """Join two copies of one session into one that holds everything both had.

    Every line this copy has, exactly as it stands, then every record the other
    holds that this one does not. Nothing is chosen between and nothing is
    dropped, which is the only join that keeps the promise the comparison makes.

    Not sorted into time order. Real transcripts are not in time order - 38 of
    the 43 on this machine step backwards at least once, one of them 249 times
    - so Claude Code plainly follows parentUuid to reconstruct a conversation
    rather than the order of the file, and sorting would impose an order these
    files never had. Appending also leaves this copy untouched at the front, so
    the joined file opens with every byte that was already here.

    parentUuid is never rewritten. Both sides of the branch keep pointing at
    the record they actually followed, which is what makes the result a shape
    Claude Code already reads: 55 of the 71 transcripts here hold a branch
    like it, written by Claude Code itself.
    """
    lines, seen = [], set()
    with ours.open(errors="replace") as fh:
        for line in fh:
            if not line.endswith("\n"):
                line += "\n"
            lines.append(line)
            key = record_key(line)
            if key:
                seen.add(key)
    gained = 0
    with theirs.open(errors="replace") as fh:
        for line in fh:
            key = record_key(line)
            if not key or key in seen:
                continue
            seen.add(key)
            if not line.endswith("\n"):
                line += "\n"
            lines.append(line)
            gained += 1
    return lines, gained


def merge_into(ours, theirs):
    """Write the join over this copy, once it is proved to hold both.

    Checked against the written file rather than against what was meant to be
    written, and checked before anything is replaced. A merge is the one thing
    ferry does that produces a file neither machine had, so it is the one place
    that cannot be argued safe from how the code reads.
    """
    lines, gained = merge_transcripts(ours, theirs)
    tmp = ours.with_suffix(f".ferry-{os.getpid()}.new")
    try:
        tmp.write_text("".join(lines))
        joined = line_set(tmp)
        for other, side in ((ours, "this copy"), (theirs, "the store's copy")):
            if relation(joined, line_set(other)) not in (SAME, AHEAD):
                die(f"the merge would not have held everything {side} had, "
                    f"so nothing was changed.\n"
                    f"       this is a bug - please report it")
        os.replace(tmp, ours)
    finally:
        if tmp.exists():
            tmp.unlink()
    return gained


def ref_for_name(name):
    """The store ref a bare session name stands for.

    Once a session has been synced its name is enough to say where it lives:
    the store files it under that name, and a session keeps one name on every
    machine. So `ferry sync bug-hunt` means what `ferry sync work:acme/bug-hunt`
    means, without having to remember which folder it went to.

    A name that no store holds cannot be resolved, because nothing here knows
    which folder it should go to - that is the one time the whole ref has to be
    typed, and it is the time you are deciding something rather than repeating
    it.
    """
    hits = store_index().get(name, [])
    if len(hits) == 1:
        return hits[0][0]
    if not hits:
        die(f"no store holds a session called '{name}'.\n"
            f"       say where it should go:  ferry sync <store>:<dir>/{name}\n"
            f"       ferry sessions       what is here, and where it is stored")
    die(f"'{name}' is in more than one store:\n"
        + "".join(f"       {ref}\n" for ref, _ in hits)
        + "       say which one")


def sync_everything(args):
    """Everything in this directory that a store already has.

    The same set `ferry sessions` lists, taking the same action it names, so
    the listing is the dry run: what it says about each session is what this
    does to it. Nothing new is decided here.

    A session no store has is left alone and said out loud. Where it should go
    is the one thing ferry cannot work out, and guessing a folder would file a
    conversation somewhere you did not choose.
    """
    here, index = slug_dir(), store_index()
    named = names_here(here)
    paired, alone, split = [], [], []
    for name in sorted(named):
        hits = index.get(name, [])
        if len(hits) == 1:
            paired.append((name, hits[0][0]))
        elif not hits:
            alone.append(name)
        else:
            split.append(name)

    mem = here / "memory"
    # Memory has no name to look up, but it belongs to this directory, and this
    # directory's sessions say which folder of the store that is. One folder
    # among them is an answer; two would be a guess.
    folders = {ref.rsplit("/", 1)[0] if "/" in ref.split(":", 1)[1] else
               ref.split(":")[0] + ":" for _, ref in paired}
    memory_ref = folders.pop() if len(folders) == 1 else None

    if not paired and not (memory_ref and any(mem.glob("*.md"))):
        die("nothing here is in a store yet.\n"
            "       ferry sessions                    what is here\n"
            "       ferry sync <store>:<dir>/<name>   to say where one goes")

    pulled, failed = set(), 0
    for name, ref in paired:
        try:
            sync_one(args, ref, pulled)
        except SystemExit:
            # die() has already said what went wrong. One session that cannot
            # be synced is not a reason to leave the rest of the directory
            # behind.
            failed += 1
    if memory_ref and any(mem.glob("*.md")):
        try:
            sync_one(argparse.Namespace(**{**vars(args), "memory": True}),
                     memory_ref, pulled)
        except SystemExit:
            failed += 1

    for name in alone:
        print(f"  {name} is in no store - "
              f"ferry sync <store>:<dir>/{name} to say where it goes")
    for name in split:
        print(f"  {name} is in more than one store - "
              f"name the one you mean")
    if not memory_ref and any(mem.glob("*.md")):
        print("  memory here belongs to no one folder of a store - "
              "ferry sync --memory <store>:<dir>")
    if failed:
        sys.exit(1)


# Not all of a transcript's bookkeeping is disposable. Most of it restates
# itself constantly - mode and permission-mode are written again every turn, a
# latch holds a flag nobody chose - so losing a copy of one costs nothing. These
# do not: each is the only record of something, and dropping it drops the thing.
CONSEQUENTIAL = {
    "custom-title": "the session's name - ferry finds sessions by it, and so "
                    "does claude --resume",
    "file-history-snapshot": "Claude Code's record of file edits, which is what "
                             "lets you rewind them",
    "file-history-delta": "Claude Code's record of file edits, which is what "
                          "lets you rewind them",
    "queue-operation": "a prompt queued and not yet sent",
    "last-prompt": "which turn a resume carries on from",
}


def record_text(record):
    """What a record says, when it says anything a person wrote or read.

    Only the message content, and only when it is plain text: a tool result or
    an attachment is bulk, and quoting it in a summary of what differs would
    bury the turns that tell you which piece of work this is.
    """
    message = record.get("message")
    if not isinstance(message, dict):
        return None
    content = message.get("content")
    if isinstance(content, list):
        content = " ".join(b.get("text", "") for b in content
                           if isinstance(b, dict) and b.get("type") == "text")
    if not isinstance(content, str) or not content.strip():
        return None
    text = " ".join(content.split())
    return None if text.startswith("<") else text


def only_in(jsonl, keys, limit=4):
    """A description of the records of jsonl whose key is in keys.

    Returns (how many are conversation, counts by type for the rest, a few
    lines of what was said).

    Conversation is told from bookkeeping by whether a record carries a uuid,
    which is exactly what divides them: user, assistant, system and attachment
    do; mode, permission-mode, custom-title, last-prompt and the rest do not.
    That distinction is the whole answer to "does this difference matter" - a
    lone `atis-latch` is Claude Code latching its own state, not something
    anybody wrote, and a count that does not say so leaves you to look up an
    internal name to find out nothing happened.
    """
    turns, state, said = 0, {}, []
    try:
        with jsonl.open(errors="replace") as fh:
            for line in fh:
                if record_key(line) not in keys:
                    continue
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    state["unparseable"] = state.get("unparseable", 0) + 1
                    continue
                kind = record.get("type", "?")
                if record.get("uuid"):
                    turns += 1
                else:
                    state[kind] = state.get(kind, 0) + 1
                    continue
                text = record_text(record) if kind == "user" else None
                if text and len(said) < limit:
                    said.append(text[:96] + ("…" if len(text) > 96 else ""))
    except OSError:
        pass
    return turns, state, said


def show_side(label, jsonl, keys):
    """One half of a diff, led by the part you would actually miss."""
    if not keys:
        print(f"  {label}: nothing")
        return
    turns, state, said = only_in(jsonl, keys)
    kinds = ", ".join(f"{n} {k}" for k, n in sorted(state.items(),
                                                    key=lambda kv: -kv[1]))
    if not turns:
        print(f"  {label}: {len(keys)} record(s), none of it conversation")
        print(f"       session state Claude Code keeps: {kinds}")
    else:
        tail = f", and {sum(state.values())} of session state" if state else ""
        print(f"  {label}: {turns} record(s) of conversation{tail}")
        for line in said:
            print(f"       > {line}")
    # Said whichever side it turns up on, because "none of it conversation"
    # otherwise reads as "nothing worth keeping" - and one of these is the
    # session's name.
    for kind in sorted(k for k in state if k in CONSEQUENTIAL):
        print(f"       ! {kind} is {CONSEQUENTIAL[kind]}")


def both_copies(args, target):
    """Resolve a ref to (alias, path, repo, this copy, the store's copy).

    Shared by diff and reset, which ask the same question sync asks - which two
    files are we talking about - and must answer it the same way, including the
    fetch. Comparing against a stale clone is how you are shown a difference
    that only git was behind on.
    """
    if ":" not in target and not args.memory:
        target = ref_for_name(target)
    alias, path = split_ref(target, directory=args.memory)
    repo, here = repo_dir(alias), slug_dir()
    pull(repo)
    if args.memory:
        return alias, path, repo, here / "memory", \
            repo / in_store(path, memory=True)
    theirs = stored_at(repo, alias, path)
    if theirs is None:
        die(f"nothing at {alias}:{path}")
    sid = session_id_of(theirs)
    if not sid:
        die(f"cannot tell which session {alias}:{path} is - no id inside it")
    return alias, path, repo, here / f"{sid}.jsonl", theirs


def cmd_diff(args):
    """What each copy of a session, or of a directory's memory, holds alone.

    `sessions` says a copy is ahead or forked; this says of what. A count is
    not enough to act on - forty records could be an afternoon's work or a
    metadata write - so the turns that were typed come with it.

    Reads only. Nothing here writes anything.
    """
    alias, path, _, ours, theirs = both_copies(args, args.target)
    print(f"{alias}:{path}")
    if args.memory:
        a, b = note_set(ours), note_set(theirs)
        names = lambda pairs: sorted({n for n, _ in pairs})
        both = set(names(a)) & set(names(b))
        clash = conflicting_notes(ours, theirs)
        print(f"  {len(set(names(a)) & set(names(b))) - len(clash)} "
              f"note(s) the same in both")
        for label, only in (("only here", set(names(a)) - set(names(b))),
                            ("only there", set(names(b)) - set(names(a)))):
            print(f"  {label}: {', '.join(sorted(only)) if only else 'nothing'}")
        print(f"  differing: {', '.join(clash) if clash else 'nothing'}")
        return
    if not ours.exists():
        print(f"  not on this machine - sync would bring it here")
        return
    a, b = line_set(ours), line_set(theirs)
    print(f"  {len(a & b)} record(s) in both")
    show_side("only here", ours, a - b)
    show_side("only there", theirs, b - a)
    if a == b:
        print("  the two are the same")


def confirm(question):
    """Ask before losing something. Refuses rather than assumes when there is
    nobody to ask - a script that meant it can say --yes."""
    if not sys.stdin.isatty():
        die(f"{question}\n       nothing to answer on, so nothing was done - "
            f"pass --yes if you meant it")
    try:
        return input(f"  {question} [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        return False


def cmd_reset(args):
    """Throw away what is only on this machine and take the store's copy.

    The one command in ferry that loses something on purpose. sync never picks
    between two copies; this picks the store's, which is what you want when the
    work here was a false start - and it is the way out of a fork for someone
    who does not want the join.

    It goes one way only. There is no reset that discards the store's copy in
    favour of this one: that is a larger thing to do to a machine you are not
    sitting at, and sync already keeps both without being asked.
    """
    alias, path, _, ours, theirs = both_copies(args, args.target)
    if args.memory:
        gone = sorted(n for n, _ in note_set(ours) - note_set(theirs))
        if not gone and relation(note_set(ours), note_set(theirs)) == SAME:
            print(f"memory {alias}:{path} is already the store's copy")
            return
        print(f"resetting memory {alias}:{path} to the store's copy")
        print(f"  losing: {', '.join(gone) if gone else 'nothing'}")
        if not (args.yes or confirm("replace this directory's memory?")):
            return print("  nothing was done")
        ours.parent.mkdir(parents=True, exist_ok=True)
        replace_dir(theirs, ours)
        print(f"  reset to {len(note_set(ours))} note(s)")
        return

    if not ours.exists():
        print(f"nothing here to reset - sync would bring {alias}:{path} here")
        return
    a, b = line_set(ours), line_set(theirs)
    if a == b:
        print(f"{alias}:{path} is already the store's copy")
        return
    print(f"resetting {alias}:{path} to the store's copy")
    show_side("losing", ours, a - b)
    show_side("gaining", theirs, b - a)
    if not (args.yes or confirm("replace this machine's copy?")):
        return print("  nothing was done")
    delta = size_delta(theirs, ours)
    shutil.copyfile(theirs, ours)
    print(f"  reset {alias}:{path}  ({delta})")


def cmd_sync(args):
    """Make a session, or a directory's memory, the same in both places.

    One argument, and the store ref carries the name, because the direction is
    not worth being told: it follows from which copy holds what. A copy is only
    ever replaced by one holding everything it already held, so there is no
    direction to get wrong and no flag to get wrong either.

    With no argument at all, everything in this directory that a store already
    has - which is what `ferry sessions` has just finished describing.
    """
    if args.target is None:
        return sync_everything(args)
    return sync_one(args, args.target)


def sync_one(args, target, pulled=None):
    """One session, or one directory's memory.

    `pulled` remembers which stores this run has already brought up to date, so
    syncing a directory's worth of sessions fetches each store once rather than
    once per session.
    """
    # A bare name is a session already in a store, which knows its own folder.
    # Memory has no name of its own - it belongs to the directory - so there is
    # nothing there for a bare word to mean.
    if ":" not in target and not args.memory:
        target = ref_for_name(target)
    alias, path = split_ref(target, directory=args.memory)
    repo, here = repo_dir(alias), slug_dir()
    # Before anything is compared: comparing against a stale store is how a
    # sync reports a fork that only git was behind on.
    if pulled is None or repo not in pulled:
        pull(repo)
        if pulled is not None:
            pulled.add(repo)

    if args.memory:
        return sync_memory(args, repo, alias, path, here)

    name = path.rsplit("/", 1)[-1]
    theirs = stored_at(repo, alias, path)
    mine = names_here(here).get(name)

    if theirs is None:
        if mine is None:
            look = ("ferry sessions", f"ferry list {alias}")
            w = max(len(c) for c in look) + 3
            die(f"nothing called '{name}' here, and nothing at "
                f"{alias}:{path}\n"
                f"       {look[0]:<{w}}what is here\n"
                f"       {look[1]:<{w}}what is there")
        # Nothing there yet, so there is nothing there to lose.
        return sync_send(args, repo, alias, path, mine, theirs, name)

    sid = session_id_of(theirs)
    if not sid:
        die(f"cannot tell which session {alias}:{path} is - no id inside it")

    # The name says where in the store to look; the id says which conversation
    # was found there. A local session wearing that name with a different id is
    # a different conversation, and neither may be written over the other.
    if mine is not None and mine.stem != sid:
        die(f"'{name}' is a different conversation in each place:\n"
            f"       here:  {mine.stem}\n"
            f"       there: {sid}\n"
            f"       ferry name {mine.stem} <another-name>  to free the name")

    # Found by id, not by name: a copy renamed here is still the same
    # conversation, and looking only for the name would take it for a stranger
    # and write the store's copy straight over it.
    ours = here / f"{sid}.jsonl"
    if not ours.exists():
        return sync_receive(alias, path, theirs, ours)

    a, b = line_set(ours), line_set(theirs)
    state = relation(a, b)
    if state == SAME:
        print(f"{alias}:{path} is already in sync")
        return
    if state == AHEAD:
        return sync_send(args, repo, alias, path, ours, theirs, name)
    if state == BEHIND:
        return sync_receive(alias, path, theirs, ours)

    # Each holds something the other has not. Joining them is the only outcome
    # that keeps what both have, and it is the same promise as the other three
    # rather than an exception to it - so it happens here, not under a separate
    # command you would have to know the state to reach for.
    mine, yours = session_name(ours), session_name(theirs)
    if mine != yours:
        die(f"{alias}:{path} has changed in both places, and the two do not "
            f"agree what it is called:\n"
            f"       here:  {mine or 'unnamed'}\n"
            f"       there: {yours or 'unnamed'}\n"
            f"       joining them would let the order of the file decide the "
            f"name.\n       rename one of them, then sync again")
    gained = merge_into(ours, theirs)
    print(f"merged {alias}:{path}\n"
          f"  {len(a & b)} record(s) in both, {len(a - b)} only here, "
          f"{gained} only there")
    sync_send(args, repo, alias, path, ours, theirs, name)


def cmd_move(args):
    """Re-file something inside a store, keeping the name it already has.

    The destination is a directory and the leaf comes along unchanged, the same
    way `sync` names the file after the session. That is not only symmetry: a
    session's name lives inside its own transcript, so a move able to rename the
    file could make the two disagree. Not being able to say a new name means it
    cannot happen. To rename, /rename the session and sync it again.

    --memory picks the tree, as everywhere else. There is nothing to resolve
    beyond that: the two trees cannot hold the same path.
    """
    src_alias, src_path = split_ref(args.source, directory=args.memory)
    dst_alias, dst_path = split_ref(args.dest, directory=True)
    if src_alias != dst_alias:
        die(f"move works inside one store, and '{src_alias}' and '{dst_alias}' "
            f"are two of them.\n"
            f"       they are encrypted with different keys - sync it out of "
            f"one and into the other")

    repo = repo_dir(src_alias)
    pull(repo)

    if args.memory:
        src = repo / in_store(src_path, memory=True)
        if not src.is_dir():
            die(f"no memory at {src_alias}:{src_path}")
        rel, name = src.relative_to(repo).as_posix(), None
        leaf = in_store(dst_path, memory=True)
    else:
        src = stored_at(repo, src_alias, src_path)
        if src is None:
            # A folder rather than a session, which is how a whole project is
            # re-filed. Both live under the same tree, so one lookup covers it.
            src = repo / in_store(src_path)
            if not src.exists():
                die(f"nothing at {src_alias}:{src_path}")
        rel = src.relative_to(repo).as_posix()
        # The file keeps the name it has, which for a session is its id. That
        # is the same promise as before said more plainly: move cannot rename,
        # because the filename no longer spells a name at all.
        leaf = in_store(f"{dst_path}/{src.name}" if dst_path else src.name)

    dest = repo / leaf
    if dest == src:
        die(f"{src_alias}:{of_store(rel)} is already there")
    if src in dest.parents:
        die(f"cannot move {src_alias}:{of_store(rel)} into itself")
    if dest.exists():
        if not args.force:
            die(f"{src_alias}:{of_store(leaf)} already exists - "
                f"--force to replace it")
        # Clear the destination rather than letting `git mv -f` decide: moving
        # onto an existing *directory* would put the source inside it, which is
        # mv's rule and not the one promised here.
        git(repo, "rm", "-r", "-q", "--", leaf, check=False)
        if dest.is_dir():
            shutil.rmtree(dest, ignore_errors=True)
        elif dest.exists():
            dest.unlink()

    dest.parent.mkdir(parents=True, exist_ok=True)
    git(repo, "mv", "--", rel, leaf)
    # Say where it went in the words you would type, not in the words on disk:
    # a session's file is named after its id and that is not what you call it.
    what = session_name(dest) if dest.is_file() else None
    landed = of_store(leaf)
    if what:
        landed = f"{Path(of_store(leaf)).parent}/{what}".lstrip("./")
    print(f"moved {src_alias}:{src_path} -> {src_alias}:{landed}")
    commit_push(repo, f"move: {of_store(rel)} -> {of_store(leaf)}", [rel, leaf])


def replace_dir(src, dest):
    """Put a copy of src at dest, without a long moment where dest is neither.

    rmtree then copytree leaves the destination empty for as long as the copy
    takes, and half-full if it is interrupted - which for `sync --memory` is
    your own notes. Copying alongside and swapping narrows that to two renames:
    stop it anywhere earlier and the old notes are still there.
    """
    tag = f".ferry-{os.getpid()}"
    new, old = dest.with_name(dest.name + tag + ".new"), \
        dest.with_name(dest.name + tag + ".old")
    # These are cleared before use, so a source named like one of them would be
    # deleted on the way to being copied.
    if src in (new, old):
        die(f"cannot copy {src} onto {dest}: it is where the copy would be "
            f"staged.\n       this is a bug - please report it")
    shutil.rmtree(new, ignore_errors=True)
    shutil.rmtree(old, ignore_errors=True)
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(src, new)
    try:
        if dest.exists():
            dest.rename(old)
        new.rename(dest)
    finally:
        shutil.rmtree(old, ignore_errors=True)
        shutil.rmtree(new, ignore_errors=True)


def print_notes(mem):
    """The notes in a memory directory, one per line, with their descriptions.

    Shared by `memory` and `list` so a folder reads the same whether it is the
    one you are standing in or one in a store.
    """
    notes = sorted(p for p in mem.glob("*.md") if p.name != "MEMORY.md")
    index = mem / "MEMORY.md"
    width = min(max((len(p.name) for p in notes), default=0), 32)
    for p in notes:
        d = note_description(p)
        if len(d) > 68:
            d = d[:67] + "…"
        print(f"  {p.name:<{width}}  {d}")
    if index.exists():
        entries = sum(1 for l in index.read_text(errors="replace").splitlines()
                      if l.strip().startswith(("-", "*")))
        print(f"\n  {'MEMORY.md':<{width}}  index of {entries} note(s)")


def cmd_list(args):
    """What a store holds: its sessions, or with --memory its memory.

    Paths are printed the way you would type them, so the two trees a store
    keeps on disk never show up here.
    """
    if not args.ref:
        if not args.memory:
            return cmd_stores(args)   # bare `list` is the same question
        for alias in sorted(repos()):
            list_one(alias, "", True)
        return
    alias, _, path = args.ref.partition(":")
    list_one(alias, path.strip("/"), args.memory)


def written_dates(log):
    """path -> the date it was last written, from one `git log --name-status`.

    Renames are walked backwards: the log runs newest first, so when a rename
    appears, everything older knows the file by its old name. Following them
    here rather than asking git per file is the difference between one process
    and one per session - and `git log --follow` is slow enough (rename
    detection, every time) that it was most of what listing a store cost.

    Pure lines-in, dict-out, so it can be tested without a repo.
    """
    dates, was = {}, {}      # path -> date ; historical name -> name today
    date = ""
    for line in log.splitlines():
        if line.startswith("\0"):
            date = line[1:].strip()
            continue
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        status = parts[0]
        if status.startswith("R") and len(parts) == 3:
            old, new = parts[1], parts[2]
            was[old] = was.pop(new, new)
        elif status[0] in "AM":
            # setdefault: the walk is newest-first, so the first one wins
            dates.setdefault(was.get(parts[1], parts[1]), date)
    return dates


def local_index():
    """Every named session on this machine, by the name it answers to.

    The mirror of store_index: that one finds a store's copy of what is here,
    this one finds what is here of a store's copy. A name can be held in more
    than one directory - sync writes to wherever you are standing, so the same
    stored session can be brought down in two places - which is why this maps
    to a list.
    """
    found = {}
    if not CLAUDE_PROJECTS.is_dir():
        return found
    for d in sorted(CLAUDE_PROJECTS.iterdir()):
        if not d.is_dir():
            continue
        for f in sorted(d.glob("*.jsonl")):
            name = session_name(f)
            if name:
                found.setdefault(name, []).append(f)
    return found


# Worst first. When one stored session has been brought down in several
# directories, the listing has room for one verdict, and it must be the one
# that most needs attention - saying "in sync" while another copy has forked
# would be the listing telling you not to look.
SEVERITY = [FORKED, STRANGER, UNREADABLE, BEHIND, AHEAD, SAME]


def local_state(stored, name, index):
    """Where a stored session sits on this machine, and how the copies relate.

    Returns (where, state, extra) - the directory, the verdict, and how many
    further copies there are beyond the one named. (None, None, 0) when this
    machine has nothing by that name.
    """
    here = index.get(name or "", [])
    if not here:
        return None, None, 0
    seen = []
    for f in here:
        if same_bytes(f, stored):
            seen.append((f, SAME))
        elif starts_with(stored, f):
            seen.append((f, BEHIND))
        elif starts_with(f, stored):
            seen.append((f, AHEAD))
        else:
            sid = session_id_of(stored)
            seen.append((f, UNREADABLE if not sid else
                         STRANGER if sid != f.stem else
                         relation(line_set(f), line_set(stored))))
    seen.sort(key=lambda pair: SEVERITY.index(pair[1]))
    worst, state = seen[0]
    label = state if state in (STRANGER, UNREADABLE) else STATES[state]
    # The slug names the directory outright when it can be checked; only when
    # it cannot is the transcript read for a cwd, which on a large one costs
    # more than everything else here put together.
    where = from_slug(worst.parent.name) or session_cwd(worst)
    # Only a directory that is really there. The transcript's own folder is
    # ~/.claude/projects/<slug>, which is where the file sits but never where
    # you would stand to use it - printing that as the answer would be sending
    # you somewhere you cannot work.
    return (where if where and Path(where).is_dir() else None), label, \
        len(seen) - 1


def list_one(alias, path, memory):
    repo = repo_dir(alias)
    # Fetch but never merge. Listing has to see what another machine saved, yet
    # a read should not be the thing that fails because the clone diverged.
    fetch(repo)
    root = repo / in_store(path, memory)
    shown = f"{alias}:{path}" if path else f"{alias}:"
    found = False

    if memory:
        # The folder itself, when it is the one asked for - rglob yields a
        # directory's children but never the directory.
        if any(root.glob("*.md")):
            print(f"  {shown}")
            print_notes(root)
            found = True
        for d in sorted(root.rglob("*")):
            if d.is_dir() and any(d.glob("*.md")):
                found = True
                rel = of_store(d.relative_to(repo).as_posix())
                print(f"  {alias}:{rel:<40} "
                      f"{len(list(d.glob('*.md'))):6} note(s)")
    else:
        sessions = sorted(root.rglob("*.jsonl"))
        # One walk of the history for all of them, rather than one per file.
        dates = written_dates(
            git(repo, "log", "--format=%x00%ad", "--date=short",
                "--name-status", "-M", check=False).stdout) if sessions else {}
        index = local_index()
        held = catalogue(repo)
        by_path = {e["path"]: e for e in held.values()}
        rows = []
        for f in sessions:
            found = True
            disk = f.relative_to(repo).as_posix()
            # The name comes from the catalogue, not the filename: a store
            # names its files after the session id.
            entry = by_path.get(disk, {"name": f.stem, "path": disk})
            where, state, extra = local_state(f, entry["name"], index)
            rows.append((ref_of(alias, entry), f.stat().st_size,
                         dates.get(disk, ""), where, state or "", extra,
                         entry["name"]))
        refs = max((len(r[0]) for r in rows), default=0)
        states = max((len(r[4]) for r in rows), default=0)
        for ref, size, when, where, state, extra, name in rows:
            # The state describes the copy on this machine, the same way it
            # does in `sessions` - "ahead" is always this machine having more.
            #
            # <dir>:<name>, not the bare directory: it is the same shape as the
            # store ref beside it, with the name on both sides, and it is a ref
            # in its own right - `ferry export` takes it as it stands.
            tail = (f"{tilde(where)}:{name}"
                    + (f"  +{extra}" if extra else "")) if where else ""
            print(f"  {ref:<{refs}} {size/1e6:6.1f} MB  {when}  "
                  f"{state or NOWHERE:<{states}}  {tail}".rstrip())

    if not found:
        print(f"  {shown} has no {'memory' if memory else 'sessions'}")

    _, behind = ahead_behind(repo)
    if behind:
        print(f"\n  {behind} commit(s) waiting on the remote - "
              f"ferry update {alias}")


# Options whose value is a path on this machine.
# Both spellings: completion sees the words as typed, and -k is the same
# flag as --key. Only --media has no short form, by design.
FILE_FLAGS = {"--key", "-k", "--path", "-p", "--media"}

# Commands that name one thing held in both places - the same ref, and so the
# same candidates. A command added here without being added to the completion
# dispatch offers nothing at all, which is how diff and reset shipped.
PAIRED = {"sync", "diff", "reset"}

# Commands whose first word is a store already registered here.
NAMES_A_STORE = {"update", "rename", "remove"}

# Commands that take nothing at all after them.
NO_ARGS = {"stores"}

# `ferry complete` answers in three ways, because an empty list cannot say
# which kind of nothing it means:
#
#   0   these candidates (an empty list means no match)
#   1   nothing belongs here - do not guess, not even a filename
#   2   a path belongs here - let the shell complete files
NOTHING, FILES = 1, 2

COMMANDS = {
    "add":      ["--key", "--path", "--force"],
    "rename":   [],
    "remove":   ["--force"],
    "stores":   [],
    "sessions": ["--global", "--all"],
    "memory":   ["--global"],
    "sync":     ["--memory", "--allow-plaintext"],
    "diff":     ["--memory"],
    "reset":    ["--memory", "--yes"],
    "move":     ["--memory", "--force"],
    "export":   ["--tools", "--media", "--raw", "--all", "--memory"],
    "name":     [],
    "list":     ["--memory"],
    "update":   [],
}


def refs_in(where, everything=False):
    """What can be typed to reach a session in `where`: its name, or with
    --all the id of one that has none."""
    out = set(names_here(where))
    if everything and where.is_dir():
        out.update(f.stem for f in where.glob("*.jsonl") if not session_name(f))
    return out


def notes_in(mem):
    """The notes in a memory directory, named as you would type them - without
    the .md, as a session is named without its .jsonl."""
    return sorted(p.stem for p in mem.glob("*.md")) if mem.is_dir() else []


def dir_refs(everything=False):
    """`<dir>:` for every directory a ref could reach into, ready for a name.

    Offered with the colon already there, the way stores are - what follows is
    a session, and the colon is what says so.
    """
    return sorted({tilde(d) + ":" for d in session_dirs(everything)})


def synced_refs(prefix, where=None):
    """The sessions in this directory that a store already has, by name.

    The one you mean to sync is nearly always one you are standing in, and its
    name is all sync needs once the store has it - so the name is what is
    offered, not the ref three levels down the store that it stands for.

    Matched on the name alone, which is what makes it cheap enough for a TAB:
    no stored transcript is opened. A name that turns out to belong to another
    conversation is caught by `sync`, which refuses and says so.
    """
    index = store_index()
    if not index:
        return []
    here = slug_dir(where)
    out = []
    for f in sorted(here.glob("*.jsonl")) if here.is_dir() else []:
        name = session_name(f)
        if name and name in index and name.startswith(prefix):
            out.append(name)
    return sorted(set(out))


def store_refs(prefix, kind="any"):
    """<store>: and <store>:<path> candidates for whatever is typed so far.

    One level at a time, the way filename completion works: `work:` offers the
    folders, and only once you are inside one does it offer what is in it. The
    alternative - every path in the store at once - buries the answer in
    everything else the store has ever held.

    A folder comes back with a trailing slash, which with `complete -o nospace`
    leaves the cursor ready to go deeper. Folders are read off the tree;
    sessions come from the catalogue, because what a session is called is
    inside it and the file is named after its id.
    """
    names = sorted(repos())
    if ":" not in prefix:
        return [n + ":" for n in names if n.startswith(prefix)]

    alias, _, path = prefix.partition(":")
    if alias not in names:
        return []
    root = Path(repos()[alias]["path"])
    if not root.is_dir():
        return []

    # Everything up to the last slash is settled; the rest is being typed.
    head, _, _typing = path.rpartition("/")
    trees = [MEMORIES] if kind == "memory" else \
            [SESSIONS] if kind == "session" else [SESSIONS, MEMORIES]
    out = []
    for tree in trees:
        base = root / tree / head if head else root / tree
        if not base.is_dir():
            continue
        for f in sorted(base.iterdir()):
            if f.name.startswith("."):
                continue
            rel = f"{head}/{f.name}" if head else f.name
            if f.is_dir():
                # --memory takes the folder itself, so that is an answer and
                # not just a step on the way to one.
                if kind == "memory" and any(f.glob("*.md")):
                    out.append(f"{alias}:{rel}")
                if kind != "memory" or any(c.is_dir() for c in f.iterdir()):
                    out.append(f"{alias}:{rel}/")
    # Sessions are not offered by filename - a store names them after their id,
    # and the name lives inside. The catalogue already knows both.
    if kind in ("session", "any"):
        for _, entry in catalogue(root).items():
            if folder_of(entry) == head:
                out.append(ref_of(alias, entry))
    return sorted(set(c for c in out if c.startswith(prefix)))


def given(words, long, short):
    """Was this flag typed, in either form?

    Matching the long spelling alone was enough until the short ones existed,
    and then `ferry sync -m store:` quietly completed as though --memory had
    not been given. Bunched shorts count too: -ag is both of them.
    """
    for w in words:
        if w in (long, short):
            return True
        if w.startswith("-") and not w.startswith("--") and short[1] in w[1:]:
            return True
    return False


def positionals(words):
    """The words that are arguments, with flags and their values dropped.

    Which argument you are typing is decided by counting these, so a flag's
    value must not be counted as one. It was: `ferry export --media /tmp/pics
    work:<TAB>` counted /tmp/pics as the ref and offered nothing at all, on a
    command line that is otherwise perfectly good.
    """
    out, skip = [], False
    for w in words:
        if skip:
            skip = False                    # this word is the flag's value
            continue
        if w.startswith("-"):
            skip = w in FILE_FLAGS
            continue
        out.append(w)
    return out


def cmd_complete(args):
    """Emit completion candidates. Driven by the shell, not by you.

    With --line the whole command line is parsed here rather than trusting the
    shell's word splitting: bash breaks words on ':' (it is in COMP_WORDBREAKS),
    so `store:pers` would arrive as three words and the store ref would be lost.
    """
    words = args.words
    if args.line is not None:
        try:
            words = shlex.split(args.line)
        except ValueError:
            words = args.line.split()
        if args.line[-1:].isspace():
            words.append("")
    cur = words[-1] if words else ""
    prev = positionals(words[:-1])

    # A flag that takes a file: let the shell complete filenames, which it
    # does better than ferry could.
    if len(words) >= 2 and words[-2] in FILE_FLAGS:
        sys.exit(FILES)

    if len(prev) <= 1:                      # still choosing the command
        out = ("--help", "--version") if cur.startswith("-") else sorted(COMMANDS)
        print("\n".join(c for c in out if c.startswith(cur)))
        return

    cmd = prev[1]
    # Nothing positional goes here. Flags still might: `sessions` takes no
    # arguments but does take --global.
    if cmd in NO_ARGS and not cur.startswith("-"):
        sys.exit(NOTHING)

    out = [f for f in COMMANDS.get(cmd, []) if f.startswith(cur)] if \
        cur.startswith("-") else []

    memory = given(words, "--memory", "-m")
    if not cur.startswith("-"):
        if cmd in ("sessions", "memory"):
            # A directory to look in. The ones that hold sessions come first;
            # anything else is an ordinary path, and the shell can finish it.
            if len(prev) == 2:
                here = memory_dirs() if cmd == "memory" else None
                # Anywhere with sessions, named or not: `sessions <dir>` says
                # how many are unnamed and how to see them, so a directory of
                # them is a useful answer rather than a dead end. That is not
                # true of `export`, which needs something it can name.
                out = sorted(tilde(d) for d in here) if here is not None else \
                    [d[:-1] for d in dir_refs(everything=True)]
                out = [d for d in out if d.startswith(cur)]
        elif cmd in NAMES_A_STORE and len(prev) == 2:
            # update, rename and remove all take a registered store first, and
            # ferry is the only thing that knows which names exist. rename's
            # second word is the new name, which nothing can guess.
            out = [n for n in sorted(repos()) if n.startswith(cur)]
        elif cmd == "list":
            out = store_refs(cur, "memory" if memory else "session")
        elif cmd in PAIRED:
            # sync, diff and reset all name one thing that exists in both
            # places, so they take the same ref and offer the same candidates.
            # The store's own tree is walked a level at a time, and the sessions
            # in this directory that the store already has are named outright -
            # they are the likely answer, and the walk to reach them is the
            # whole width of the store.
            out = store_refs(cur, "memory" if memory else "session")
            if not memory:
                mine = synced_refs(cur)
                out = mine + [r for r in out if r not in set(mine)]
        elif cmd == "name":
            # What is here, named or not - naming an unnamed one is the point.
            # The second word is a name you are inventing, so nothing.
            if len(prev) == 2:
                head, sep, tail = cur.partition(":")
                if sep:
                    where = Path(os.path.expanduser(head))
                    out = [f"{head}:{n}"
                           for n in sorted(refs_in(slug_dir(where), True))
                           if n.startswith(tail)] if where.is_dir() else []
                elif cur.startswith(("~", "/", ".")) or "/" in cur:
                    out = [d for d in dir_refs(everything=True)
                           if d.startswith(cur)]
                else:
                    out = sorted(n for n in refs_in(slug_dir(), True)
                                 if n.startswith(cur))
        elif cmd == "export":
            if len(prev) == 2 and given(words, "--memory", "-m"):
                head, sep, tail = cur.partition(":")
                if sep and head in repos():
                    # In a store: a folder of notes, or a note in one.
                    repo, path = repo_dir(head), tail.strip("/")
                    parent, _, leaf = path.rpartition("/")
                    base = repo / in_store(parent, memory=True)
                    if "/" in path and base.is_dir():
                        out = [f"{head}:{parent}/{n}" for n in notes_in(base)
                               if n.startswith(leaf)]
                    else:
                        # A folder carries on with '/', so no space after it.
                        out = [c if c.endswith(":") else c + "/"
                               for c in store_refs(cur, "memory")]
                        folder = repo / in_store(path, memory=True)
                        if folder.is_dir():
                            out += [f"{head}:{path}/{n}"
                                    for n in notes_in(folder)]
                elif sep:
                    # A note in that directory - the memory ref's equivalent of
                    # naming a session.
                    mem = slug_dir(Path(os.path.expanduser(head))) / "memory"
                    out = [f"{head}:{n}" for n in notes_in(mem)
                           if n.startswith(tail)]
                else:
                    # A folder is offered with what carries on from it - ':'
                    # here, '/' in a store - so the next TAB reaches its notes.
                    # Both still mean the whole folder if you stop there.
                    out = sorted(tilde(d) + ":" for d in memory_dirs()) \
                        + [c if c.endswith(":") else c + "/"
                           for c in store_refs(cur, "memory")]
                out = [c for c in out if c.startswith(cur)]
            elif len(prev) == 2:
                everything = given(words, "--all", "-a")
                head, sep, tail = cur.partition(":")
                if sep and head not in repos():
                    # A directory ref: the sessions in that directory are the
                    # answers, and only ferry knows their names.
                    where = Path(os.path.expanduser(head))
                    out = [f"{head}:{n}"
                           for n in sorted(refs_in(slug_dir(where), everything))
                           if n.startswith(tail)] if where.is_dir() else []
                elif not sep and (cur.startswith(("~", "/", ".")) or "/" in cur):
                    # A path is being typed: the directories that hold
                    # sessions. Not every directory - completing to one with
                    # nothing in it would be offering a ref that fails.
                    out = [d for d in dir_refs(everything) if d.startswith(cur)]
                else:
                    out = sorted(n for n in refs_in(slug_dir(), everything)
                                 if n.startswith(cur)) \
                        + store_refs(cur, "session") + dir_refs(everything)
        elif cmd == "move":
            # source takes what --memory says it takes; the destination is
            # always a folder to put it in
            out = store_refs(cur) if len(prev) >= 3 else \
                store_refs(cur, "memory" if memory else "session")
        elif cmd == "add" and len(prev) > 2:
            out = []                        # a url or a new name; nothing to offer
    print("\n".join(out))


def cmd_update(args):
    """Bring a clone up to date, and explain it if that is not possible."""
    aliases = [args.name] if args.name else sorted(repos())
    if not aliases:
        die("no stores yet:  ferry add <name> <git-url>")

    for alias in aliases:
        repo = repo_dir(alias)
        fetch(repo)
        if not has_upstream(repo):
            print(f"{alias}: no remote to update from")
            continue

        ahead, behind = ahead_behind(repo)
        if not behind and not ahead:
            print(f"{alias}: up to date")
            continue
        if ahead and not behind:
            print(f"{alias}: {ahead} commit(s) here that the remote lacks - "
                  f"they go up with your next sync")
            continue
        if behind and not ahead:
            git(repo, "merge", "--ff-only", "@{u}")
            print(f"{alias}: pulled {behind} commit(s)")
            continue

        # Diverged. ferry will not merge encrypted content, and it will not
        # throw away a commit it did not make, so this is where it stops and
        # says exactly what it is looking at.
        print(f"{alias}: DIVERGED - {ahead} commit(s) here, "
              f"{behind} on the remote, and they have split.")
        print(f"  ferry never merges, so this one is yours to settle:")
        print(f"    cd {repo}")
        print(f"    git log --oneline HEAD...@{{u}}       # see both sides")
        print(f"  then pick one:")
        print(f"    git rebase origin/main             # replay your commits on top")
        print(f"    git reset --hard origin/main       # discard yours, take the remote")
        print(f"  your sessions in ~/.claude are untouched either way - "
              f"the worst case is re-saving them.")


def memory_dirs():
    """Every directory on this machine that remembers something, as real paths.

    The same shape as session_dirs, and for the same reason: memory belongs to
    a directory, so saying which one is the only way to name it.
    """
    out = []
    if CLAUDE_PROJECTS.is_dir():
        for d in sorted(CLAUDE_PROJECTS.iterdir()):
            if not (d / "memory").is_dir() or not any((d / "memory").glob("*.md")):
                continue
            first = next(iter(sorted(d.glob("*.jsonl"))), None)
            where = session_cwd(first) if first else from_slug(d.name)
            if where and Path(where).is_dir():
                out.append(where)
    return out


def cmd_memory(args):
    """What a directory remembers - this one, another, or all of them."""
    if args.where and args.global_:
        die("a directory and --global ask different questions - "
            "one place, or all of them")
    if args.global_:
        return memory_everywhere()

    where = Path(os.path.expanduser(args.where)) if args.where else Path.cwd()
    if args.where and not where.is_dir():
        die(f"no such directory: {args.where}")
    mem = slug_dir(where) / "memory"
    notes = sorted(p for p in mem.glob("*.md") if p.name != "MEMORY.md") \
        if mem.is_dir() else []
    index = mem / "MEMORY.md"

    if not notes and not index.exists():
        print(f"no memory for {where}")
        return

    print_notes(mem)
    print(f"\n  {len(notes)} note(s) in {mem}")


def memory_everywhere():
    """Which directories remember anything, and how much."""
    rows = []
    for where in memory_dirs():
        mem = slug_dir(where) / "memory"
        n = len([p for p in mem.glob("*.md") if p.name != "MEMORY.md"])
        rows.append((tilde(where), n))
    if not rows:
        print("no memory anywhere on this machine")
        return
    width = min(max(len(r[0]) for r in rows), 48)
    for where, n in sorted(rows):
        print(f"  {where:<{width}}  {n:5} note(s)")
    print("\n  read one with:  ferry memory <dir>")


def from_slug(slug):
    """A path the slug could have come from, when it can be checked.

    The mapping is lossy - every non-alphanumeric character became a dash - so
    this is a guess. It is only ever returned when slugging it back gives the
    same slug and the directory is really there, which makes it a guess that
    has been verified rather than one being passed off as fact. Paths with a
    dash in a name will not survive that check, and get no answer at all.
    """
    guess = Path("/" + slug.strip("-").replace("-", "/"))
    if guess.is_dir() and slug_dir(guess).name == slug:
        return str(guess)
    return None


def session_cwd(jsonl):
    """The directory this transcript is filed under, as a real path.

    The slug cannot be reversed - every non-alphanumeric character became a
    dash, so `-home-a-b-c` could have been a/b/c or a/b-c. The records carry
    real paths, so the answer is in the file; the catch is that a session can
    `cd`, and then its later paths are not where the file lives.

    So take the recorded path that slugs back to this file's own directory.
    That is the one where `<dir>:<name>` will actually find it, which is the
    whole point of printing it. Anything else would be a ref that does not
    resolve - one such session on this machine ends in ~/develop/…/personal
    while its transcript sits under the slug for …/test.
    """
    want, tried = jsonl.parent.name, set()
    try:
        with jsonl.open(errors="replace") as fh:
            for line in fh:
                if '"cwd"' not in line:
                    continue
                try:
                    c = json.loads(line).get("cwd")
                except json.JSONDecodeError:
                    continue
                # Each distinct path once. A transcript records its cwd on
                # thousands of lines but only ever holds a handful of different
                # ones, and slugging a path resolves it on the filesystem - so
                # not doing that repeatedly is the difference between 9 calls
                # and 6763. On a machine where a home directory is not local,
                # the second version reads as a hang.
                if c in tried:
                    continue
                tried.add(c)
                # The first one that slugs back is enough: any that does names
                # this same directory, and stopping there reads the head of a
                # file rather than all of it, which is what makes listing every
                # session on the machine fast enough to sit behind a TAB.
                if c and slug_dir(c).name == want:
                    return c
    except OSError:
        pass
    return from_slug(want)


def session_dirs(everything=False):
    """Directories holding something a ref could name, as real paths.

    Not every directory with a transcript in it: one whose sessions are all
    unnamed has nothing `<dir>:<name>` can match, so offering it leads you
    somewhere with nothing behind it. With --all an id is a handle, so then
    they count.
    """
    out = []
    if CLAUDE_PROJECTS.is_dir():
        for d in sorted(CLAUDE_PROJECTS.iterdir()):
            if not d.is_dir():
                continue
            files = sorted(d.glob("*.jsonl"))
            if not files or not (everything or any(session_name(f) for f in files)):
                continue
            where = session_cwd(files[0])
            # A directory that has since been deleted would only be offered so
            # that `<dir>:<name>` could refuse it.
            if where and Path(where).is_dir():
                out.append(where)
    return out


CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "ferry"


def head_of(repo):
    """The store's current commit, or None if it has none yet."""
    got = git(repo, "rev-parse", "HEAD", check=False)
    return got.stdout.strip() if got.returncode == 0 else None


def catalogue_file(repo):
    """Where this store's catalogue is kept.

    Named after the path rather than the alias, because an alias can be
    renamed and a checkout cannot move without being re-added.
    """
    key = hashlib.sha1(str(repo.resolve()).encode()).hexdigest()[:16]
    return CACHE / f"{key}.json"


def read_sessions(repo, paths):
    """id -> {name, path} for the given session paths, read from the files.

    A file that says no id is still listed, under its path and by whatever it
    is called on disk. A locked git-crypt store is every file at once - it is
    ciphertext, so nothing can be read out of it - and a store that looks empty
    because it is locked would be a worse answer than one that lists what it
    has and says it cannot read it.
    """
    found = {}
    for rel in paths:
        f = repo / rel
        if not f.is_file():
            continue
        sid = session_id_of(f)
        found[sid or f"?{rel}"] = {"name": session_name(f) or f.stem,
                                   "path": rel, "readable": bool(sid)}
    return found


def catalogue(repo):
    """Every session a store holds, as id -> {name, path}.

    The store's filenames are not the answer to this - a session is identified
    by the id inside it, and what the file is called is storage. So the
    catalogue is read out of the transcripts, and kept because reading 50 of
    them takes a second and a half and a listing cannot.

    It is a cache, so it is never trusted: it records the commit it was built
    from, and anything else is rebuilt. When the store has merely moved on, the
    files git says changed are re-read and the rest are kept - one session per
    commit, in practice, so the usual cost is one sha comparison and one file.
    """
    head = head_of(repo)
    store = catalogue_file(repo)
    was = {}
    try:
        was = json.loads(store.read_text())
    except (OSError, ValueError):
        pass

    if was.get("head") == head and head is not None:
        return was.get("sessions", {})

    known = was.get("sessions", {})
    changed = None
    if known and was.get("head") and head:
        moved = git(repo, "diff", "--name-only", was["head"], head,
                    check=False)
        if moved.returncode == 0:
            changed = [line for line in moved.stdout.splitlines()
                       if line.startswith(f"{SESSIONS}/")]

    if changed is None:                     # no usable history to diff against
        sessions = read_sessions(repo, [
            str(f.relative_to(repo))
            for f in sorted((repo / SESSIONS).rglob("*.jsonl"))])
    else:
        gone = {rel for rel in changed if not (repo / rel).is_file()}
        sessions = {sid: e for sid, e in known.items()
                    if e["path"] not in gone and e["path"] not in changed}
        sessions.update(read_sessions(repo, [c for c in changed
                                             if c not in gone]))

    try:
        store.parent.mkdir(parents=True, exist_ok=True)
        store.write_text(json.dumps({"head": head, "sessions": sessions}))
    except OSError:
        pass                                # a cache that cannot be kept still works
    return sessions


def folder_of(entry):
    """The store folder a catalogued session sits in, '' for the top."""
    rel = Path(entry["path"]).relative_to(SESSIONS).parent
    return "" if str(rel) == "." else str(rel)


def ref_of(alias, entry):
    """What a catalogued session is called, as you would type it.

    Folder plus the name from inside the transcript - never the filename, which
    is storage and says nothing about which conversation this is.
    """
    folder = folder_of(entry)
    return f"{alias}:{folder}/{entry['name']}" if folder \
        else f"{alias}:{entry['name']}"


def store_index():
    """Every session in every registered store, by the name it answers to.

    The name is read from inside the transcript rather than taken from the
    filename, so a store may name its files whatever it likes - after the
    session id, as it now does - without any of this changing.
    """
    found = {}
    for alias, r in sorted(repos().items()):
        repo = Path(r["path"])
        for _, entry in sorted(catalogue(repo).items(),
                               key=lambda kv: kv[1]["path"]):
            found.setdefault(entry["name"], []).append(
                (ref_of(alias, entry), repo / entry["path"]))
    return found


def stored_at(repo, alias, path):
    """The file a <folder>/<name> ref points at in this store, or None.

    Names are unique within a folder because ferry refuses to file a second
    session under a name a folder already has - so at most one thing matches.
    """
    want = f"{alias}:{path}"
    for _, entry in sorted(catalogue(repo).items(),
                           key=lambda kv: kv[1]["path"]):
        if ref_of(alias, entry) == want:
            return repo / entry["path"]
    return None


def same_bytes(a, b):
    """Byte-for-byte identical, which for two transcripts settles it outright.

    Worth trying first: sync copies a file whole, so two copies that are in
    sync are usually identical bytes, and reading them as bytes is far cheaper
    than parsing every record of both. It can only ever say SAME - two copies
    holding the same records may still differ in byte order or in repeats - so
    a false answer here costs nothing but the slow path.
    """
    try:
        return (a.stat().st_size == b.stat().st_size
                and filecmp.cmp(str(a), str(b), shallow=False))
    except OSError:
        return False


def starts_with(big, small):
    """Whether one transcript's bytes open the other's, so its records are a
    subset outright - which settles ahead and behind without parsing either.

    Transcripts are appended to, so the copy that has been worked on since
    usually still opens with every byte the other has. Reading raw bytes is
    an order cheaper than parsing every record: on a 17 MB session here, 7 ms
    against 871.

    The shorter file has to end on a newline, or its last line is a fragment
    that the longer one continues rather than repeats - and a fragment is not
    a record either copy holds.
    """
    try:
        n = small.stat().st_size
        if n == 0 or n >= big.stat().st_size:
            return False
        with small.open("rb") as fs:
            fs.seek(-1, os.SEEK_END)
            if fs.read(1) != b"\n":
                return False
            fs.seek(0)
            with big.open("rb") as fb:
                while n > 0:
                    chunk = min(n, 1 << 20)
                    if fb.read(chunk) != fs.read(chunk):
                        return False
                    n -= chunk
        return True
    except OSError:
        return False


def store_state(jsonl, name, index):
    """Where a local session sits in a store, and how the two copies relate.

    Returns (ref, state), or (None, None) when the stores have nothing by that
    name. Both copies are read in full, which is the only honest way to answer
    it - and the reason is worth the cost: "is this safe to lose?" is the
    question the listing exists to answer, and a cheaper guess would answer it
    wrongly.

    Read against your clone, not the remote. `ferry update` first if the
    question is really about what another machine has pushed.
    """
    hits = index.get(name or "", [])
    if not hits:
        return None, None
    ref, theirs = hits[0]
    if len(hits) > 1:
        ref += f" +{len(hits) - 1}"
    if same_bytes(jsonl, theirs):
        return ref, STATES[SAME]
    if starts_with(jsonl, theirs):
        return ref, STATES[AHEAD]
    if starts_with(theirs, jsonl):
        return ref, STATES[BEHIND]
    sid = session_id_of(theirs)
    if not sid:
        return ref, UNREADABLE
    if sid != jsonl.stem:
        return ref, STRANGER
    return ref, STATES[relation(line_set(jsonl), line_set(theirs))]


def cmd_sessions(args):
    """What can be referred to here, so you know what you can sync or read.

    Named sessions only, unless --all. A session with no name cannot be named
    in a ref at all - `ferry sync` refuses it, and `<dir>:<name>` has nothing
    to match - so listing it by default was showing you things you could not
    then do anything with. --all brings them back, addressed by id, which is
    the only handle they have.
    """
    if args.where and args.global_:
        die("a directory and --global ask different questions - "
            "one place, or all of them")
    if args.global_:
        return sessions_everywhere(args.all)

    # A directory only says where to look. The flags keep meaning what they
    # mean; an argument that quietly turned one on would be a rule you had to
    # know rather than one you could read.
    where = Path(os.path.expanduser(args.where)) if args.where else Path.cwd()
    if args.where and not where.is_dir():
        die(f"no such directory: {args.where}")
    here = slug_dir(where)
    index = store_index()
    rows, unnamed = [], 0
    for f in sorted(here.glob("*.jsonl")) if here.is_dir() else []:
        name = session_name(f)
        # An unnamed session cannot be in a store - there is nothing to file it
        # under - so nothing is read for it either.
        ref, state = store_state(f, name, index) if name else (None, None)
        if not name:
            unnamed += 1
            if not args.all:
                continue
            hint = ai_title(f) or first_prompt(f) or ""
            name = "* " + (hint[:71] + "\u2026" if len(hint) > 72 else hint)
        rows.append((f.stat().st_mtime, f.stem, f.stat().st_size, name,
                     ref or "", state or ""))

    if not rows:
        print(f"no {'' if args.all else 'named '}sessions for {where}")
    names = max((len(r[3]) for r in rows), default=0)
    # The state is what you scan for, so it is the column that lines up; the
    # ref trails, unpadded, because it is there to be copied rather than read.
    states = max((len(r[5]) for r in rows), default=0)
    for mtime, sid, size, name, ref, state in sorted(rows, reverse=True):
        when = datetime.fromtimestamp(mtime).strftime("%Y-%m-%d")
        print(f"  {sid}  {when}  {size/1e6:6.1f} MB  {name:<{names}}  "
              f"{state or NOWHERE:<{states}}  {ref}".rstrip())

    n = len(list((here / "memory").glob("*.md"))) if (here / "memory").is_dir() else 0
    if n:
        # The hint only applies where you are standing: save reads the current
        # directory's memory, whatever this listing is pointed at.
        hint = "" if args.where else "(ferry sync --memory <store>:<dir>)"
        print(f"  {'memory':<36}  {'':10}  {n:6} md   {hint}".rstrip())
    if unnamed and not args.all:
        print(f"\n  {unnamed} unnamed - ferry sessions "
              f"{args.where + ' ' if args.where else ''}--all")
    elif any(r[3].startswith("* ") for r in rows):
        print("\n  * a title or opening line, not a name - "
              "/rename it before saving")


def sessions_everywhere(everything=False):
    """Every session on this machine, and the directory each belongs to.

    The directory is what makes a ref possible: names are unique within one and
    nowhere wider, so `<dir>:<name>` is the form that always means exactly one
    session. Unnamed ones are listed under --all by their full id, which is the
    only thing that can stand in for a name.
    """
    rows, index = [], store_index()
    if CLAUDE_PROJECTS.is_dir():
        for d in sorted(CLAUDE_PROJECTS.iterdir()):
            if not d.is_dir():
                continue
            where = None
            for f in sorted(d.glob("*.jsonl")):
                name, hint = session_name(f), ""
                # Only a named session can be in a store, so only a named one
                # is read - which keeps --all from costing more than --global.
                ref, state = store_state(f, name, index) if name else (None, None)
                if not name:
                    if not everything:
                        continue
                    # The id is what you would type; the title is how you know
                    # which one you want.
                    name = f.stem
                    hint = ai_title(f) or first_prompt(f) or ""
                    if len(hint) > 44:
                        hint = hint[:43] + "\u2026"
                    hint = f"  * {hint}" if hint else ""
                where = where or session_cwd(f)
                if where and Path(where).is_dir():
                    rows.append((f.stat().st_mtime, name, f.stat().st_size,
                                 where, hint, ref or "", state or ""))
    if not rows:
        print(f"no {'' if everything else 'named '}sessions on this machine")
        return
    width = min(max(len(r[1]) for r in rows), 36)
    paths = min(max(len(tilde(r[3])) for r in rows), 40)
    states = max(len(r[6]) for r in rows)
    for mtime, name, size, where, hint, ref, state in sorted(rows, reverse=True):
        when = datetime.fromtimestamp(mtime).strftime("%Y-%m-%d")
        print(f"  {name:<{width}}  {when}  {size/1e6:6.1f} MB  "
              f"{tilde(where):<{paths}}  {state or NOWHERE:<{states}}  "
              f"{ref}{hint}".rstrip())
    if any(r[4] for r in rows):
        print("\n  * a title or opening line, not a name - "
              "the id is what to type")
    print(f"\n  read one with:  ferry export <dir>:<name>"
          if not any(r[4] for r in rows) else
          "  read one with:  ferry export <dir>:<name>")


def tilde(path):
    """Home as ~, because these lines are meant to be read and retyped."""
    home = str(Path.home())
    return "~" + path[len(home):] if path.startswith(home) else path


USAGE = """\
  ferry add <name> <git-url> [--key <file>] [--path <dir>] [--force]
  ferry stores
  ferry rename <store> <new-name>
  ferry remove <store> [--force]
  ferry sessions [<dir>] [--global] [--all]
  ferry name <session>|<dir>:<session> <name>
  ferry memory [<dir>] [--global]
  ferry sync [<session>|<store>:<path>]   without either, everything here
  ferry sync --memory <store>:<dir>
  ferry diff <session>|<store>:<path> [--memory]
  ferry reset <session>|<store>:<path> [--memory] [--yes]
  ferry move <store>:<path> <store>:<dir> [--force]
  ferry move --memory <store>:<dir> <store>:<dir> [--force]
  ferry list [<store>[:<path>]]           without a store, same as `stores`
  ferry list --memory [<store>[:<dir>]]
  ferry export <session>|<store>:<path>|<dir>:<session>
               [--tools] [--media <dir>] [--raw] [--all]
  ferry export --memory <dir>[:<note>]|<store>:<dir>[/<note>]
  ferry update [<store>]\
"""

EXAMPLES = """\
examples:
  register a store, once per machine
    ferry add work git@github.com:you/sessions.git --key ~/sessions.key
    ferry add work --path ~/develop/sessions      adopt a checkout you have
    ferry rename work old-work                    same store, different name
    ferry remove old-work                         forget it; the clone stays
    ferry stores

  what have I got here
    ferry sessions
    ferry sessions --global                       everywhere, and where each is
    ferry sessions --all                          unnamed ones too, by id
    ferry sessions ~/develop/acme                 another directory
    ferry name 6af148fd deploy-fix                name one without resuming it
    ferry memory                                  notes here
    ferry memory --global                         everywhere that remembers

  move it between machines
    ferry sync                                    everything here, both kinds
    ferry sync bug-hunt                           one session, once stored
    ferry sync work:acme/bug-hunt                 the first time, to say where
    ferry sync --memory work:acme                 that folder's notes
    ferry diff bug-hunt                           what each copy has alone
    ferry reset bug-hunt                          take the store's, losing mine
    ferry list work                               what the store holds
    ferry list --memory work                      its memory
    ferry update work

  read one
    ferry export bug-hunt                         as markdown, to stdout
    ferry export work:acme/bug-hunt --tools       with what the tools did
    ferry export ~/develop/acme:bug-hunt          one in another directory
    ferry export --memory work:acme               a folder's notes, in full
    ferry export --memory work:acme/role          just the one note
    ferry export bug-hunt --raw > bug-hunt.jsonl  the transcript itself

  tidy the store up
    ferry move --memory work:acme work:acme-v2    -> acme-v2/memory
    ferry move work:acme/bug-hunt work:archive    -> archive/bug-hunt.jsonl

sync works out the direction itself: whichever copy holds everything the other
holds, and more, is the one that gets copied, and a copy is never replaced by
one holding less - so there is no direction to get wrong. When each holds
something the other does not, both are kept: every record either had, checked
to hold both before anything is replaced. Memory joins the same way - notes are
separate files - and stops only for a note that exists on both sides saying
different things.

diff says what each copy holds that the other does not, and reset takes the
store's copy and loses whatever was only here - the one thing ferry does that
throws work away, so it shows you what would go and asks first.

Once a store has a session its name is enough, because the store files it under
that name and a session keeps one name everywhere. The whole path is only
needed the first time, to say which folder it should go to.

With nothing after it, sync takes everything in this directory a store already
has, and this directory's memory with it. That is the same set `ferry sessions`
lists and the same action it names for each one, so the listing is the dry run.
A session no store has is left alone and said out loud - where it goes is the
one thing that cannot be worked out.

--memory is how you say which of the two you mean, everywhere. A store keeps
them in separate trees, so a session may be called `memory` like anything else.\
"""


def main():
    ap = argparse.ArgumentParser(
        prog="ferry", usage="\n" + USAGE, description=__doc__, epilog=EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-V", "--version", action="version", version=f"ferry {__version__}")
    # Not required: bare `ferry` should show the help rather than an error.
    sub = ap.add_subparsers(dest="cmd", metavar="<command>")

    p = sub.add_parser("add", help="register a store")
    p.add_argument("name", metavar="<name>")
    p.add_argument("url", nargs="?", metavar="<git-url>")
    p.add_argument("-p", "--path", metavar="<dir>",
                   help="adopt a checkout you already have")
    p.add_argument("-k", "--key", metavar="<file>",
                   help="git-crypt key to unlock it with")
    p.add_argument("-f", "--force", action="store_true",
                   help="replace a store of that name")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("rename", help="give a store a different name")
    p.add_argument("name", metavar="<store>")
    p.add_argument("new", metavar="<new-name>")
    p.set_defaults(func=cmd_rename)

    p = sub.add_parser("remove", help="forget a store; its checkout stays")
    p.add_argument("name", metavar="<store>")
    p.add_argument("-f", "--force", action="store_true",
                   help="forget it even with work the remote has not got")
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser("stores", help="the stores registered here")
    p.set_defaults(func=cmd_stores)

    p = sub.add_parser("sessions", help="sessions in this directory")
    p.add_argument("where", nargs="?", metavar="<dir>",
                   help="another directory, instead of this one")
    p.add_argument("-g", "--global", dest="global_", action="store_true",
                   help="every named session on this machine, and where")
    p.add_argument("-a", "--all", action="store_true",
                   help="include unnamed sessions, listed by id")
    p.set_defaults(func=cmd_sessions)

    p = sub.add_parser("memory", help="what a directory remembers")
    p.add_argument("where", nargs="?", metavar="<dir>",
                   help="another directory, instead of this one")
    p.add_argument("-g", "--global", dest="global_", action="store_true",
                   help="every directory that remembers anything")
    p.set_defaults(func=cmd_memory)

    p = sub.add_parser("sync", help="make a session the same in both places")
    p.add_argument("target", nargs="?",
                   metavar="<session>|<store>:<path>")
    p.add_argument("-m", "--memory", action="store_true",
                   help="this directory's memory, not a session")
    p.add_argument("--allow-plaintext", action="store_true",
                   help="commit even though the store has no git-crypt")
    p.set_defaults(func=cmd_sync)


    p = sub.add_parser("diff", help="what each copy holds that the other does not")
    p.add_argument("target", metavar="<session>|<store>:<path>")
    p.add_argument("-m", "--memory", action="store_true",
                   help="this directory's memory, not a session")
    p.set_defaults(func=cmd_diff)

    p = sub.add_parser("reset", help="take the store's copy, losing local changes")
    p.add_argument("target", metavar="<session>|<store>:<path>")
    p.add_argument("-m", "--memory", action="store_true",
                   help="this directory's memory, not a session")
    p.add_argument("-y", "--yes", action="store_true",
                   help="do not ask first")
    p.set_defaults(func=cmd_reset)

    p = sub.add_parser("move", help="re-file something inside a store")
    p.add_argument("source", metavar="<store>:<path>")
    p.add_argument("dest", metavar="<store>:<dir>")
    p.add_argument("-m", "--memory", action="store_true",
                   help="that folder's memory, not a session of the same name")
    p.add_argument("-f", "--force", action="store_true",
                   help="replace whatever is already at the destination")
    p.set_defaults(func=cmd_move)

    p = sub.add_parser("name", help="name a session without resuming it")
    p.add_argument("session", metavar="<session>|<dir>:<session>")
    p.add_argument("new", metavar="<name>")
    p.set_defaults(func=cmd_name)

    p = sub.add_parser("export", help="print a session as markdown")
    p.add_argument("session", metavar="<session>|<store>:<path>")
    p.add_argument("-t", "--tools", action="store_true",
                   help="include tool calls and their results")
    p.add_argument("--media", metavar="<dir>",
                   help="write images there and link them")
    p.add_argument("-r", "--raw", action="store_true",
                   help="the transcript exactly as it is")
    p.add_argument("-a", "--all", action="store_true",
                   help="complete unnamed sessions too, by id")
    p.add_argument("-m", "--memory", action="store_true",
                   help="a directory's memory, not a session")
    p.set_defaults(func=cmd_export)

    p = sub.add_parser("list", help="what a store holds, or the stores")
    p.add_argument("ref", nargs="?", metavar="<store>[:<path>]")
    p.add_argument("-m", "--memory", action="store_true",
                   help="memory rather than sessions")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("complete")          # no help: hidden from --help
    p.add_argument("--line", help="the raw command line, split here not by the shell")
    p.add_argument("words", nargs="*")
    p.set_defaults(func=cmd_complete)

    p = sub.add_parser("update", help="pull a store up to date")
    p.add_argument("name", nargs="?", metavar="<store>")
    p.set_defaults(func=cmd_update)

    args = ap.parse_args()
    if not args.cmd:
        ap.print_help()
        return

    # `save X to store:dir` reads better than `save X store:dir`, so the word
    # "to" is allowed and simply dropped.
    if isinstance(getattr(args, "target", None), list):
        words = [w for w in args.target if w != "to"]
        if len(words) != 1:
            die(f"expected one <store>:<path>, got: {' '.join(args.target)}")
        args.target = words[0]

    try:
        args.func(args)
    except BrokenPipeError:
        # `ferry export … | head`, or a pager quit early. Nothing went wrong,
        # and the traceback Python would print at shutdown says otherwise -
        # so point the rest of stdout at nowhere and leave quietly.
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        except OSError:
            pass
        sys.exit(0)


if __name__ == "__main__":
    main()
