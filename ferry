#!/usr/bin/env python3
"""ferry - carry Claude Code sessions between machines, using a git repo.

    ferry repo add mine git@github.com:you/my-sessions.git
    ferry save bug-hunt as mine:acme/bug-hunt
    ferry load mine:acme/bug-hunt

save copies a transcript out of ~/.claude/projects/<cwd>/ into the repo and
pushes. load pulls and copies it back. That is the whole idea - scp with a git
repo in the middle. Nothing runs on its own, nothing is linked, nothing is
watched: it does exactly what you type, when you type it.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

__version__ = "1.0.0"

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "ferry"
CONFIG_FILE = CONFIG / "repos.json"
CLAUDE_PROJECTS = Path.home() / ".claude" / "projects"
HISTORY = Path.home() / ".claude" / "history.jsonl"
SLUG_MAX = 200


def die(msg):
    print(f"ferry: {msg}", file=sys.stderr)
    sys.exit(1)


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


# ------------------------------------------------------------------ the slug
# Claude Code stores transcripts in ~/.claude/projects/<slug>/, where the slug
# is the directory's absolute path with every non-alphanumeric character turned
# into a dash. Over 200 characters it is truncated and a hash appended.

def _jhash(s):
    t = 0
    for ch in s:
        t = (t * 31 + ord(ch)) & 0xFFFFFFFF
        t = t - 0x100000000 if t >= 0x80000000 else t
    return t


def slug_dir(path=None):
    p = str(Path(path or Path.cwd()).resolve())
    t = re.sub(r"[^a-zA-Z0-9]", "-", p)
    if len(t) > SLUG_MAX:
        n, digits = abs(_jhash(p)), "0123456789abcdefghijklmnopqrstuvwxyz"
        b36 = ""
        while n:
            n, r = divmod(n, 36)
            b36 = digits[r] + b36
        t = f"{t[:SLUG_MAX]}-{b36 or '0'}"
    return CLAUDE_PROJECTS / t


# ------------------------------------------------------------------ repos

def repos():
    try:
        return json.loads(CONFIG_FILE.read_text())
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError as e:
        die(f"{CONFIG_FILE} is not valid JSON: {e}")


def save_repos(d):
    CONFIG.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(d, indent=2, sort_keys=True) + "\n")


def repo_dir(alias):
    r = repos().get(alias)
    if not r:
        known = ", ".join(sorted(repos())) or "none yet"
        die(f"unknown repo '{alias}' (have: {known})\n"
            f"       ferry repo add {alias} <git-url>")
    p = Path(r["path"])
    if not p.is_dir():
        die(f"{p} is gone - re-add it:  ferry repo add {alias} {r.get('url','')}")
    return p


def git(repo, *args, check=True):
    r = subprocess.run(["git", "-C", str(repo), *args],
                       capture_output=True, text=True)
    if check and r.returncode != 0:
        die(f"git {' '.join(args)}:\n{(r.stderr or r.stdout).strip()}")
    return r


def split_ref(ref):
    """'mine:acme/bug-hunt' -> ('mine', 'acme/bug-hunt')."""
    if ":" not in ref:
        die(f"'{ref}' should look like <repo>:<path>, e.g. mine:acme/bug-hunt")
    alias, _, path = ref.partition(":")
    path = path.strip("/")
    if not path or path.startswith(".") or ".." in path.split("/"):
        die(f"bad path in '{ref}'")
    return alias, path


# ------------------------------------------------------------------ sessions

def session_name_map():
    """name -> session id, from ~/.claude/history.jsonl.

    A session's /rename name is not stored in its transcript; this file is the
    only record of it. Later renames win.
    """
    names = {}
    try:
        for line in HISTORY.open(errors="replace"):
            try:
                o = json.loads(line)
            except json.JSONDecodeError:
                continue
            m = re.match(r"^/rename\s+(\S+)", (o.get("display") or "").strip())
            if m and o.get("sessionId"):
                names[m.group(1)] = o["sessionId"]
    except OSError:
        pass
    return names


def find_session(spec, where):
    """Resolve a name or id prefix to a transcript in `where`."""
    if not where.is_dir():
        die(f"no sessions for this directory yet ({where})")
    here = {f.stem: f for f in where.glob("*.jsonl")}

    sid = session_name_map().get(spec)
    if sid and sid in here:
        return here[sid]

    hits = [f for s, f in here.items() if s.startswith(spec)]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        die(f"'{spec}' matches {len(hits)} sessions here - use a longer id")

    if sid:
        die(f"'{spec}' is session {sid[:8]}, but it is not in {where}\n"
            f"       cd to the directory it was started in")
    die(f"no session called '{spec}' here. Try:  ferry sessions")


def session_id_of(jsonl):
    """The session id recorded inside a transcript."""
    try:
        for line in jsonl.open(errors="replace"):
            if '"sessionId"' not in line:
                continue
            try:
                sid = json.loads(line).get("sessionId")
            except json.JSONDecodeError:
                continue
            if sid:
                return sid
    except OSError:
        pass
    return None


# ------------------------------------------------------------------ copying

def refuse_shrink(src, dest, force, what):
    """Transcripts only grow, so a shorter replacement means lost turns."""
    if force or not dest.exists():
        return
    a, b = src.stat().st_size, dest.stat().st_size
    if a < b:
        die(f"{what} would shrink {b} -> {a} bytes.\n"
            f"       {dest}\n"
            f"       load the newer copy first, or pass --force to overwrite")


def encrypted(repo):
    return (repo / ".git" / "git-crypt").is_dir()


def check_encryption(repo, alias, allow):
    if encrypted(repo) or allow:
        return
    die(f"'{alias}' has no git-crypt, so transcripts would be committed in the "
        f"clear.\n       set it up:  cd {repo} && git-crypt init\n"
        f"       or override:  --allow-plaintext")


def pull(repo):
    if not git(repo, "remote", check=False).stdout.strip():
        return
    git(repo, "fetch", "--quiet", "origin", check=False)
    if git(repo, "rev-parse", "--abbrev-ref", "@{u}", check=False).returncode == 0:
        if git(repo, "merge", "--ff-only", "@{u}", check=False).returncode != 0:
            die("the repo has diverged from its remote - sort that out by hand")


def commit_push(repo, message):
    git(repo, "add", "-A")
    if git(repo, "diff", "--cached", "--quiet", check=False).returncode == 0:
        print("  nothing changed")
        return
    git(repo, "commit", "-q", "-m", message)
    if git(repo, "remote", check=False).stdout.strip():
        if git(repo, "push", "--quiet", "origin", "HEAD", check=False).returncode:
            die("push rejected - run the command again to pull and retry")
        print("  pushed")


# ------------------------------------------------------------------ commands

def cmd_repo_add(args):
    alias = args.alias
    if not re.fullmatch(r"[A-Za-z0-9._-]+", alias):
        die("a repo alias may hold letters, digits, dot, dash and underscore")
    path = Path(args.path).expanduser().resolve() if args.path else \
        (Path.home() / ".local/share/ferry" / alias)
    if not (path / ".git").exists():
        if not args.url:
            die("give a git url, or --path to a checkout you already have")
        path.parent.mkdir(parents=True, exist_ok=True)
        print(f"cloning {args.url}")
        r = subprocess.run(["git", "clone", "--quiet", args.url, str(path)],
                           capture_output=True, text=True)
        if r.returncode:
            die(f"clone failed:\n{(r.stderr or r.stdout).strip()}")
    url = args.url or git(path, "remote", "get-url", "origin",
                          check=False).stdout.strip()
    d = repos()
    d[alias] = {"url": url, "path": str(path), "added": now()}
    save_repos(d)
    print(f"{alias} -> {path}")
    if not encrypted(path):
        print(f"  no git-crypt yet:  cd {path} && git-crypt init")


def cmd_repo_list(args):
    d = repos()
    if not d:
        print("no repos yet:  ferry repo add mine <git-url>")
    for alias in sorted(d):
        p = Path(d[alias]["path"])
        state = "" if p.is_dir() else "  MISSING"
        lock = "" if not p.is_dir() or encrypted(p) else "  NOT ENCRYPTED"
        print(f"  {alias:<14} {p}{state}{lock}")


def cmd_save(args):
    alias, path = split_ref(args.target)
    repo, here = repo_dir(alias), slug_dir()
    check_encryption(repo, alias, args.allow_plaintext)
    pull(repo)

    if args.session == "memory":
        src = here / "memory"
        if not src.is_dir():
            die(f"no memory for this directory ({src})")
        dest = repo / path
        if dest.exists() and not dest.is_dir():
            die(f"{dest} exists and is not a directory")
        shutil.rmtree(dest, ignore_errors=True)
        shutil.copytree(src, dest)
        n = len(list(dest.rglob("*.md")))
        print(f"saved memory -> {alias}:{path}  ({n} file(s))")
        commit_push(repo, f"memory: {path}")
        return

    src = find_session(args.session, here)
    dest = repo / f"{path}.jsonl"
    refuse_shrink(src, dest, args.force, "saving")
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(src, dest)
    named = {v: k for k, v in session_name_map().items()}
    dest.with_suffix(".json").write_text(json.dumps({
        "name": named.get(src.stem, ""), "session": src.stem, "saved": now(),
        "from": str(Path.cwd()),
    }, indent=2, sort_keys=True) + "\n")
    print(f"saved {src.stem[:8]} -> {alias}:{path}  "
          f"({dest.stat().st_size/1e6:.1f} MB)")
    commit_push(repo, f"session: {path}")


def cmd_load(args):
    alias, path = split_ref(args.target)
    repo, here = repo_dir(alias), slug_dir()
    pull(repo)

    jsonl, mem = repo / f"{path}.jsonl", repo / path
    if not jsonl.exists() and mem.is_dir():
        dest = here / "memory"
        # Claude Code creates an empty memory/ for every directory, so only an
        # existing one that actually holds notes is worth protecting.
        if any(dest.glob("*.md")) and not args.force:
            die(f"{dest} already holds {len(list(dest.glob('*.md')))} note(s) - "
                f"pass --force to replace them")
        here.mkdir(parents=True, exist_ok=True)
        shutil.rmtree(dest, ignore_errors=True)
        shutil.copytree(mem, dest)
        print(f"loaded memory {alias}:{path} -> {dest}  "
              f"({len(list(dest.rglob('*.md')))} file(s))")
        return

    if not jsonl.exists():
        die(f"nothing at {alias}:{path}")
    meta = {}
    side = jsonl.with_suffix(".json")
    if side.exists():
        meta = json.loads(side.read_text())
    sid = meta.get("session") or session_id_of(jsonl)
    if not sid:
        die(f"cannot tell which session {jsonl} is - no id inside it")

    dest = here / f"{sid}.jsonl"
    refuse_shrink(jsonl, dest, args.force, "loading")
    here.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(jsonl, dest)
    print(f"loaded {alias}:{path} -> {dest.name[:8]}  "
          f"({dest.stat().st_size/1e6:.1f} MB)")
    print(f"  resume it here with:  claude --resume {sid}")
    name = args.name or meta.get("name")
    if name:
        print(f"  it was called '{name}' - /rename {name} to restore that")


def cmd_list(args):
    if not args.ref:
        return cmd_repo_list(args)
    alias, _, path = args.ref.partition(":")
    repo = repo_dir(alias)
    root = repo / path.strip("/") if path else repo
    if not root.exists():
        die(f"nothing at {args.ref}")
    found = False
    for f in sorted(root.rglob("*.jsonl")):
        found = True
        rel = f.relative_to(repo).as_posix()[:-6]
        side = f.with_suffix(".json")
        meta = json.loads(side.read_text()) if side.exists() else {}
        print(f"  {alias}:{rel:<40} {f.stat().st_size/1e6:6.1f} MB  "
              f"{meta.get('saved','')[:10]}  {meta.get('name','')}")
    for d in sorted(root.rglob("*")):
        if d.is_dir() and any(d.glob("*.md")):
            found = True
            rel = d.relative_to(repo).as_posix()
            print(f"  {alias}:{rel:<40} {len(list(d.glob('*.md'))):6} md   memory")
    if not found:
        print(f"  {args.ref} is empty")


def cmd_sessions(args):
    """What is in this directory, so you know what you can save."""
    here = slug_dir()
    if not here.is_dir():
        print(f"no sessions for {Path.cwd()}")
        return
    by_id = {v: k for k, v in session_name_map().items()}
    rows = []
    for f in here.glob("*.jsonl"):
        rows.append((f.stat().st_mtime, f.stem, f.stat().st_size,
                     by_id.get(f.stem, "")))
    if not rows:
        print(f"no sessions for {Path.cwd()}")
    for mtime, sid, size, name in sorted(rows, reverse=True):
        when = datetime.fromtimestamp(mtime).strftime("%Y-%m-%d")
        print(f"  {sid[:8]}  {when}  {size/1e6:6.1f} MB  {name}")
    n = len(list((here / "memory").glob("*.md"))) if (here / "memory").is_dir() else 0
    if n:
        print(f"  memory    {'':10}  {n:6} md   (ferry save memory as <repo>:<path>)")


def main():
    ap = argparse.ArgumentParser(prog="ferry", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=f"ferry {__version__}")
    sub = ap.add_subparsers(dest="cmd", required=True, metavar="<command>")

    p = sub.add_parser("repo", help="the git repos you carry sessions to")
    ps = p.add_subparsers(dest="sub", required=True, metavar="<command>")
    q = ps.add_parser("add", help="register a repo")
    q.add_argument("alias")
    q.add_argument("url", nargs="?")
    q.add_argument("--path", help="use a checkout you already have")
    q.set_defaults(func=cmd_repo_add)
    q = ps.add_parser("list", help="show registered repos")
    q.set_defaults(func=cmd_repo_list)

    p = sub.add_parser("save", help="copy a session (or memory) into a repo")
    p.add_argument("session", metavar="<name|id|memory>")
    p.add_argument("target", metavar="[as] <repo>:<path>", nargs="+")
    p.add_argument("--force", action="store_true",
                   help="overwrite even if the repo copy is longer")
    p.add_argument("--allow-plaintext", action="store_true",
                   help="commit even though the repo has no git-crypt")
    p.set_defaults(func=cmd_save)

    p = sub.add_parser("load", help="copy a session (or memory) into this directory")
    p.add_argument("target", metavar="<repo>:<path>", nargs="+")
    p.add_argument("--name", help="the name to suggest restoring")
    p.add_argument("--force", action="store_true",
                   help="overwrite even if the local copy is longer")
    p.set_defaults(func=cmd_load)

    p = sub.add_parser("list", help="what is in a repo")
    p.add_argument("ref", nargs="?", metavar="[<repo>[:<path>]]")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("sessions", help="what is in this directory")
    p.set_defaults(func=cmd_sessions)

    args = ap.parse_args()

    # `save X as repo:path` reads better than `save X repo:path`, so the word
    # "as" is allowed and simply ignored.
    if isinstance(getattr(args, "target", None), list):
        words = [w for w in args.target if w != "as"]
        if len(words) != 1:
            die(f"expected one <repo>:<path>, got: {' '.join(args.target)}")
        args.target = words[0]

    args.func(args)


if __name__ == "__main__":
    main()
