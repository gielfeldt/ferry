        """So it can be pasted straight into a sync."""
        body = '{"sessionId":"abc","uuid":"1"}\n'
        self.stored("bug-hunt", body)
        here = tmpfile(body, name="abc")
        ref, state = f.store_state(here, "bug-hunt", f.store_index())
        self.assertEqual(ref, "s:acme/bug-hunt")
        self.assertEqual(state, "in sync")

    def test_a_name_shared_by_two_conversations(self):
        """Same name, different id. Not a fork - no merge would reconcile them
        - so it must not be reported as one."""
        self.stored("bug-hunt", '{"sessionId":"other","uuid":"9"}\n')
        here = tmpfile('{"sessionId":"abc","uuid":"1"}\n', name="abc")
        _, state = f.store_state(here, "bug-hunt", f.store_index())
        self.assertEqual(state, f.STRANGER)

    def test_a_store_that_cannot_be_read(self):
        """A locked git-crypt store is ciphertext: no id comes out of it. That
        is not the two copies disagreeing, and saying so would send you
        looking for a conflict that is not there."""
        self.stored("bug-hunt", "\x00\x01 binary nonsense\n")
        here = tmpfile('{"sessionId":"abc","uuid":"1"}\n', name="abc")
        _, state = f.store_state(here, "bug-hunt", f.store_index())
        self.assertEqual(state, f.UNREADABLE)

    def test_being_in_two_stores_is_said_out_loud(self):
        other = Path(tempfile.mkdtemp())
        (other / "sessions" / "team").mkdir(parents=True)
        body = '{"sessionId":"abc","uuid":"1"}\n'
        self.stored("bug-hunt", body)
        (other / "sessions" / "team" / "bug-hunt.jsonl").write_text(body)
        f.repos = lambda: {"s": {"path": str(self.root)},
                           "t": {"path": str(other)}}
        ref, _ = f.store_state(tmpfile(body, name="abc"), "bug-hunt",
                               f.store_index())
        self.assertTrue(ref.endswith("+1"), ref)

    def test_an_unnamed_session_is_never_looked_up(self):
        """It cannot be in a store - there is nothing to file it under - so it
        must not cost a read either."""
        index = f.store_index()
        self.assertEqual(f.store_state(tmpfile("{}\n"), None, index),
                         (None, None))
        self.assertEqual(f.store_state(tmpfile("{}\n"), "", index),
                         (None, None))


class RefForName(unittest.TestCase):
    """A bare session name standing for the store ref it is already at.

    Once a session has been synced, the store files it under its name and a
    session keeps one name everywhere - so the name is enough, and `ferry sync
    bug-hunt` means what the whole ref means without having to remember which
    folder it went to.
    """

    def setUp(self):
        self.root = Path(tempfile.mkdtemp())
        self._repos = f.repos
        f.repos = lambda: {"s": {"path": str(self.root)}}

    def tearDown(self):
        f.repos = self._repos

    def stored(self, alias_path):
        p = self.root / "sessions" / f"{alias_path}.jsonl"
        p.parent.mkdir(parents=True, exist_ok=True)
        # A store is catalogued by the id inside each transcript, so a
        # fixture session needs one of its own.
        leaf = alias_path.rsplit("/", 1)[-1]
        p.write_text(f'{{"sessionId":"id-{leaf}","uuid":"u-{leaf}"}}\n'
                     f'{{"type":"custom-title","customTitle":"{leaf}",'
                     f'"sessionId":"id-{leaf}"}}\n')

    def test_one_store_entry_resolves(self):
        self.stored("acme/bug-hunt")
        self.assertEqual(f.ref_for_name("bug-hunt"), "s:acme/bug-hunt")

    def test_the_folder_does_not_have_to_be_remembered(self):
        """That is the whole point - the name is what you know."""
        self.stored("deep/nested/folder/bug-hunt")
        self.assertEqual(f.ref_for_name("bug-hunt"),
                         "s:deep/nested/folder/bug-hunt")

    def test_a_session_at_the_top_of_a_store(self):
        self.stored("bug-hunt")
        self.assertEqual(f.ref_for_name("bug-hunt"), "s:bug-hunt")

    def test_a_name_no_store_holds_says_where_to_say_it(self):
        """Nothing here knows which folder it should go to, and that is the
        one time the whole ref has to be typed - the time you are deciding
        something rather than repeating it."""
        with quiet() as (_, err), self.assertRaises(SystemExit):
            f.ref_for_name("never-synced")
        self.assertIn("no store holds", err.getvalue())
        self.assertIn("<store>:<dir>/never-synced", err.getvalue())

    def test_a_name_in_two_stores_lists_them(self):
        other = Path(tempfile.mkdtemp())
        (other / "sessions" / "team").mkdir(parents=True)
        (other / "sessions" / "team" / "bug-hunt.jsonl").write_text("{}\n")
        self.stored("acme/bug-hunt")
        f.repos = lambda: {"s": {"path": str(self.root)},
                           "t": {"path": str(other)}}
        with quiet() as (_, err), self.assertRaises(SystemExit):
            f.ref_for_name("bug-hunt")
        self.assertIn("s:acme/bug-hunt", err.getvalue())
        self.assertIn("t:team/bug-hunt", err.getvalue())

    def test_a_ref_is_left_alone(self):
        """Only a bare word is resolved; anything with a colon already says
        where it is."""
        self.stored("acme/bug-hunt")
        sys.argv = ["ferry", "sync", "s:acme/bug-hunt"]
        called = []
        real = f.repo_dir
        f.repo_dir = lambda a: called.append(a) or Path("/nonexistent")
        try:
            with quiet(), self.assertRaises(SystemExit):
                f.main()
        finally:
            f.repo_dir = real
        self.assertEqual(called, ["s"])


class SyncedRefs(unittest.TestCase):
    """What `ferry sync <TAB>` offers before you have typed a store.

    The name, not the ref it stands for: once the store has a session, its name
    is the whole of what sync needs, and walking the store to reach a session
    you are standing in is a lot of typing for something already known.
    """

    def setUp(self):
        self.root = Path(tempfile.mkdtemp())
        (self.root / "sessions" / "acme").mkdir(parents=True)
        self.here = Path(tempfile.mkdtemp())
        self._repos, self._slug = f.repos, f.slug_dir
        f.repos = lambda: {"s": {"path": str(self.root)}}
        f.slug_dir = lambda where=None: self.here

    def tearDown(self):
        f.repos, f.slug_dir = self._repos, self._slug

    def local(self, sid, name):
        (self.here / f"{sid}.jsonl").write_text(
            f'{{"sessionId":"{sid}","uuid":"1"}}\n'
            f'{{"type":"custom-title","customTitle":"{name}","sessionId":"{sid}"}}\n')

    def stored(self, folder, name):
        d = self.root / "sessions" / folder
        d.mkdir(parents=True, exist_ok=True)
        # Its own id: the store is catalogued by id, so two sessions
        # sharing one would be two names for a single conversation.
        (d / f"{name}.jsonl").write_text(
            f'{{"sessionId":"id-{name}","uuid":"u-{name}"}}\n'
            f'{{"type":"custom-title","customTitle":"{name}",'
            f'"sessionId":"id-{name}"}}\n')

    def test_a_local_session_the_store_has_is_offered_by_name(self):
        self.local("abc", "bug-hunt")
        self.stored("acme", "bug-hunt")
        self.assertEqual(f.synced_refs(""), ["bug-hunt"])

    def test_one_no_store_has_is_not_offered(self):
        """There is no ref to complete yet - that is what typing one is for."""
        self.local("abc", "only-here")
        self.assertEqual(f.synced_refs(""), [])

    def test_an_unnamed_session_is_not_offered(self):
        (self.here / "abc.jsonl").write_text('{"sessionId":"abc","uuid":"1"}\n')
        self.stored("acme", "bug-hunt")
        self.assertEqual(f.synced_refs(""), [])

    def test_it_narrows_as_you_type(self):
        self.local("abc", "bug-hunt")
        self.stored("acme", "bug-hunt")
        self.assertEqual(f.synced_refs("bug"), ["bug-hunt"])
        self.assertEqual(f.synced_refs("deploy"), [])

    def test_nothing_registered_is_not_an_error(self):
        f.repos = lambda: {}
        self.local("abc", "bug-hunt")
        self.assertEqual(f.synced_refs(""), [])

    def test_the_names_come_first(self):
        """The stores are still walkable, but the likely answer leads."""
        self.local("abc", "bug-hunt")
        self.stored("acme", "bug-hunt")
        sys.argv = ["ferry", "complete", "--line", "ferry sync "]
        with quiet() as (out, _):
            f.main()
        got = out.getvalue().split()
        self.assertEqual(got[0], "bug-hunt")
        self.assertIn("s:", got)

    def test_a_name_and_its_ref_do_not_collide(self):
        """The bare name and the ref it stands for are different words, so
        both can be offered without either being listed twice."""
        self.local("abc", "bug-hunt")
        self.stored("acme", "bug-hunt")
        mine = f.synced_refs("")
        merged = mine + [r for r in f.store_refs("", "session")
                         if r not in set(mine)]
        self.assertEqual(merged.count("bug-hunt"), 1)
        self.assertEqual(sorted(merged), ["bug-hunt", "s:"])


class LocalState(unittest.TestCase):
    """What `ferry list` says about a stored session: which directory on this
    machine has it, and how that copy relates to the store's.

    The mirror of what `sessions` shows. One stored session can be brought
    down in several directories - sync writes to wherever you are standing -
    so this is one-to-many, and the listing has room for one verdict.
    """

    def setUp(self):
        self.proj = Path(tempfile.mkdtemp())
        self._cp, self._cwd = f.CLAUDE_PROJECTS, f.session_cwd
        f.CLAUDE_PROJECTS = self.proj
        f.session_cwd = lambda p: str(p.parent)

    def tearDown(self):
        f.CLAUDE_PROJECTS, f.session_cwd = self._cp, self._cwd

    BODY = ('{"sessionId":"abc","uuid":"1"}\n'
            '{"type":"custom-title","customTitle":"bug-hunt","sessionId":"abc"}\n')

    def here(self, folder, text=None):
        d = self.proj / folder
        d.mkdir(parents=True, exist_ok=True)
        p = d / "abc.jsonl"
        p.write_text(text if text is not None else self.BODY)
        return p

    def test_a_stored_session_this_machine_does_not_have(self):
        stored = tmpfile(self.BODY, name="bug-hunt")
        self.assertEqual(f.local_state(stored, "bug-hunt", f.local_index()),
                         (None, None, 0))

    def test_one_copy_that_matches(self):
        self.here("-tmp-a")
        stored = tmpfile(self.BODY, name="bug-hunt")
        where, state, extra = f.local_state(stored, "bug-hunt", f.local_index())
        self.assertEqual((state, extra), ("in sync", 0))
        self.assertTrue(where.endswith("-tmp-a"))

    def test_ahead_means_this_machine_has_more(self):
        """The same sense as in `sessions`, so one word never means two
        things depending on which listing you are reading."""
        self.here("-tmp-a", self.BODY + '{"uuid":"2"}\n')
        stored = tmpfile(self.BODY, name="bug-hunt")
        self.assertEqual(f.local_state(stored, "bug-hunt", f.local_index())[1],
                         "ahead")

    def test_behind_means_the_store_has_more(self):
        self.here("-tmp-a")
        stored = tmpfile(self.BODY + '{"uuid":"2"}\n', name="bug-hunt")
        self.assertEqual(f.local_state(stored, "bug-hunt", f.local_index())[1],
                         "behind")

    def test_forked(self):
        self.here("-tmp-a", self.BODY + '{"uuid":"2"}\n')
        stored = tmpfile(self.BODY + '{"uuid":"3"}\n', name="bug-hunt")
        self.assertEqual(f.local_state(stored, "bug-hunt", f.local_index())[1],
                         "forked")

    def test_two_directories_are_counted(self):
        self.here("-tmp-a")
        self.here("-tmp-b")
        stored = tmpfile(self.BODY, name="bug-hunt")
        _, state, extra = f.local_state(stored, "bug-hunt", f.local_index())
        self.assertEqual((state, extra), ("in sync", 1))

    def test_the_worst_of_several_is_the_one_shown(self):
        """Saying "in sync" because one copy is, while another has forked,
        would be the listing telling you not to look."""
        self.here("-tmp-a")                                   # in sync
        self.here("-tmp-b", self.BODY + '{"uuid":"9"}\n')     # ahead
        stored = tmpfile(self.BODY + '{"uuid":"3"}\n', name="bug-hunt")
        where, state, extra = f.local_state(stored, "bug-hunt", f.local_index())
        self.assertEqual((state, extra), ("forked", 1))
        self.assertTrue(where.endswith("-tmp-b"), where)

    def test_a_name_shared_by_another_conversation(self):
        self.here("-tmp-a")
        stored = tmpfile('{"sessionId":"other","uuid":"9"}\n', name="bug-hunt")
        self.assertEqual(f.local_state(stored, "bug-hunt", f.local_index())[1],
                         f.STRANGER)

    def test_an_unreadable_store_copy(self):
        self.here("-tmp-a")
        stored = tmpfile("\x00 binary nonsense\n", name="bug-hunt")
        self.assertEqual(f.local_state(stored, "bug-hunt", f.local_index())[1],
                         f.UNREADABLE)

    def test_a_directory_that_is_not_there_is_not_named(self):
        """The transcript's own folder is ~/.claude/projects/<slug>, which is
        where the file sits and never where you would stand to use it. When the
        real directory cannot be worked out, the state is still worth saying
        and the location is not."""
        self.here("-tmp-a")
        f.session_cwd = lambda p: None
        stored = tmpfile(self.BODY, name="bug-hunt")
        where, state, _ = f.local_state(stored, "bug-hunt", f.local_index())
        self.assertIsNone(where)
        self.assertEqual(state, "in sync")

    def test_an_unnamed_local_session_is_not_indexed(self):
        self.here("-tmp-a", '{"sessionId":"abc","uuid":"1"}\n')
        self.assertEqual(f.local_index(), {})


class ListSymmetry(unittest.TestCase):
    """Both listings put a usable ref on each side of the row.

    `sessions` names the session and ends with its store ref; `list` names the
    store ref and ends with <dir>:<name>. The name is on both sides either way,
    and both trailing forms are refs ferry takes as they stand.
    """

    def setUp(self):
        self.root = Path(tempfile.mkdtemp())
        self.proj = Path(tempfile.mkdtemp())
        self.work = Path(tempfile.mkdtemp())
        (self.root / "sessions" / "acme").mkdir(parents=True)
        self._repos, self._cp, self._cwd = f.repos, f.CLAUDE_PROJECTS, f.session_cwd
        f.repos = lambda: {"s": {"path": str(self.root)}}
        f.CLAUDE_PROJECTS = self.proj
        f.session_cwd = lambda p: str(self.work)

    def tearDown(self):
        f.repos, f.CLAUDE_PROJECTS, f.session_cwd = \
            self._repos, self._cp, self._cwd

    BODY = ('{"sessionId":"abc","uuid":"1"}\n'
            '{"type":"custom-title","customTitle":"bug-hunt","sessionId":"abc"}\n')

    def both(self, folder):
        d = self.root / "sessions" / folder if folder else self.root / "sessions"
        d.mkdir(parents=True, exist_ok=True)
        (d / "bug-hunt.jsonl").write_text(self.BODY)
        p = self.proj / "-tmp-a"
        p.mkdir(parents=True, exist_ok=True)
        (p / "abc.jsonl").write_text(self.BODY)

    def listing(self, ref):
        sys.argv = ["ferry", "list", ref]
        with quiet() as (out, _):
            try:
                f.main()
            except SystemExit:
                pass
        return out.getvalue()

    def test_the_local_side_carries_the_name(self):
        self.both("acme")
        self.assertIn(f"{f.tilde(str(self.work))}:bug-hunt", self.listing("s:acme"))

    def test_a_session_at_the_top_of_a_store_too(self):
        """No folder means no slash in the ref, so a name taken from the ref
        by splitting on one would come back as the whole ref."""
        self.both(None)
        out = self.listing("s:")
        self.assertIn(f"{f.tilde(str(self.work))}:bug-hunt", out)
        self.assertNotIn("s:bug-hunt:", out)


class Merge(unittest.TestCase):
    """Joining two copies that have each moved.

    The promise is the same one the comparison makes: a copy is never replaced
    by one holding less. A join holds everything both had, so it keeps that
    promise on both sides at once - which is why it belongs to sync rather than
    to a command you would have to know the state to reach for.
    """

    SHARED = ('{"parentUuid":null,"sessionId":"s","type":"user","uuid":"a"}\n'
              '{"parentUuid":"a","sessionId":"s","type":"user","uuid":"b"}\n')

    def two(self, mine, theirs):
        return (tmpfile(self.SHARED + mine, name="s"),
                tmpfile(self.SHARED + theirs, name="s"))

    def test_it_holds_everything_both_had(self):
        ours, theirs = self.two('{"uuid":"L"}\n', '{"uuid":"R"}\n')
        before = f.line_set(ours)
        f.merge_into(ours, theirs)
        joined = f.line_set(ours)
        self.assertEqual(f.relation(joined, before), f.AHEAD)
        self.assertEqual(f.relation(joined, f.line_set(theirs)), f.AHEAD)

    def test_it_reports_what_it_gained(self):
        ours, theirs = self.two('{"uuid":"L"}\n', '{"uuid":"R"}\n{"uuid":"R2"}\n')
        self.assertEqual(f.merge_into(ours, theirs), 2)

    def test_this_copy_stays_at_the_front(self):
        """Appending, not rewriting: the file opens with every byte that was
        already here, so a session that loads keeps loading."""
        ours, theirs = self.two('{"uuid":"L"}\n', '{"uuid":"R"}\n')
        was = ours.read_bytes()
        f.merge_into(ours, theirs)
        self.assertTrue(ours.read_bytes().startswith(was))

    def test_parent_uuids_are_left_alone(self):
        """Both sides of the branch keep pointing at what they followed - that
        is what makes the result a shape Claude Code already reads."""
        ours, theirs = self.two('{"parentUuid":"b","uuid":"L"}\n',
                                '{"parentUuid":"b","uuid":"R"}\n')
        f.merge_into(ours, theirs)
        parents = [json.loads(l).get("parentUuid")
                   for l in ours.read_text().splitlines() if l.strip()]
        self.assertEqual(parents.count("b"), 2)

    def test_nothing_is_added_twice(self):
        ours, theirs = self.two('{"uuid":"L"}\n', '{"uuid":"L"}\n')
        self.assertEqual(f.merge_into(ours, theirs), 0)

    def test_a_repeated_record_is_not_multiplied(self):
        """Metadata repeats verbatim through a session. Joining must not turn
        three of a line here and five there into eight."""
        ours, theirs = self.two('{"type":"mode"}\n' * 3, '{"type":"mode"}\n' * 5)
        f.merge_into(ours, theirs)
        self.assertEqual(ours.read_text().count('{"type":"mode"}'), 3)

    def test_a_missing_final_newline_does_not_join_two_records(self):
        ours = tmpfile(self.SHARED + '{"uuid":"L"}', name="s")
        theirs = tmpfile(self.SHARED + '{"uuid":"R"}\n', name="s")
        f.merge_into(ours, theirs)
        for line in ours.read_text().splitlines():
            if line.strip():
                json.loads(line)          # every line still parses on its own

    def test_the_check_runs_before_anything_is_replaced(self):
        """A join is the one thing ferry writes that neither machine had, so a
        bug in it must not be able to land."""
        ours, theirs = self.two('{"uuid":"L"}\n', '{"uuid":"R"}\n')
        was = ours.read_bytes()
        real = f.merge_transcripts
        f.merge_transcripts = lambda a, b: (["{}\n"], 1)   # drops everything
        try:
            with quiet(), self.assertRaises(SystemExit):
                f.merge_into(ours, theirs)
        finally:
            f.merge_transcripts = real
        self.assertEqual(ours.read_bytes(), was)

    def test_it_leaves_no_working_file_behind(self):
        ours, theirs = self.two('{"uuid":"L"}\n', '{"uuid":"R"}\n')
        f.merge_into(ours, theirs)
        self.assertEqual(list(ours.parent.glob("*.new")), [])


class MemoryMerge(unittest.TestCase):
    """Joining two memory directories.

    A note is a file with a name, so notes join the way files join. The index
    is a list of the notes rather than a note, so it is rebuilt rather than
    chosen between - which is what makes memory joinable at all, since the
    index differs whenever the notes do.
    """

    def dirs(self, mine, theirs):
        a, b = Path(tempfile.mkdtemp()), Path(tempfile.mkdtemp())
        for d, files in ((a, mine), (b, theirs)):
            for name, text in files.items():
                (d / name).write_text(text)
        return a, b

    def test_notes_from_both_sides_are_kept(self):
        a, b = self.dirs({"here.md": "x"}, {"there.md": "y"})
        out = Path(tempfile.mkdtemp()) / "joined"
        total, gained = f.merge_memory(a, b, out)
        self.assertEqual(sorted(p.name for p in out.glob("*.md")),
                         ["here.md", "there.md"])
        self.assertEqual((total, gained), (2, 1))

    def test_a_note_on_both_sides_is_kept_once(self):
        a, b = self.dirs({"same.md": "x"}, {"same.md": "x"})
        out = Path(tempfile.mkdtemp()) / "joined"
        self.assertEqual(f.merge_memory(a, b, out), (1, 0))

    def test_the_index_is_rebuilt_from_both(self):
        a, b = self.dirs(
            {"here.md": "x", "MEMORY.md": "- [Here](here.md) - mine\n"},
            {"there.md": "y", "MEMORY.md": "- [There](there.md) - theirs\n"})
        out = Path(tempfile.mkdtemp()) / "joined"
        f.merge_memory(a, b, out)
        lines = (out / "MEMORY.md").read_text().splitlines()
        self.assertEqual(len(lines), 2)
        self.assertTrue(any("here.md" in l for l in lines))
        self.assertTrue(any("there.md" in l for l in lines))

    def test_this_copy_describes_a_note_both_indexes_name(self):
        """Both lines describe a note that is kept either way, so neither can
        be wrong about anything that matters - take the nearer one."""
        a, b = self.dirs(
            {"n.md": "x", "MEMORY.md": "- [N](n.md) - mine\n"},
            {"n.md": "x", "MEMORY.md": "- [N](n.md) - theirs\n"})
        out = Path(tempfile.mkdtemp()) / "joined"
        f.merge_memory(a, b, out)
        self.assertIn("mine", (out / "MEMORY.md").read_text())

    def test_an_index_line_for_a_vanished_note_is_dropped(self):
        """It would send a reader after a file that is not there."""
        a, b = self.dirs(
            {"n.md": "x", "MEMORY.md": "- [N](n.md) - here\n"
                                       "- [Gone](gone.md) - not here\n"}, {})
        out = Path(tempfile.mkdtemp()) / "joined"
        f.merge_memory(a, b, out)
        self.assertNotIn("gone.md", (out / "MEMORY.md").read_text())

    def test_an_index_line_naming_no_note_survives(self):
        """A heading, or a note to self - it is not about a note, so nothing
        can have happened to the note it does not name."""
        a, b = self.dirs(
            {"n.md": "x", "MEMORY.md": "# What I know\n- [N](n.md) - here\n"}, {})
        out = Path(tempfile.mkdtemp()) / "joined"
        f.merge_memory(a, b, out)
        self.assertIn("# What I know", (out / "MEMORY.md").read_text())

    def test_the_index_does_not_count_as_a_difference(self):
        """Two copies whose notes agree are in sync whatever their indexes
        say - otherwise every change to the notes would look like a change on
        both sides, because the index changes with them."""
        a, b = self.dirs({"n.md": "x", "MEMORY.md": "- [N](n.md) - mine\n"},
                         {"n.md": "x", "MEMORY.md": "- [N](n.md) - theirs\n"})
        self.assertEqual(f.relation(f.note_set(a), f.note_set(b)), f.SAME)

    def test_a_note_saying_different_things_is_the_one_conflict(self):
        a, b = self.dirs({"n.md": "mine", "ok.md": "s"},
                         {"n.md": "theirs", "ok.md": "s"})
        self.assertEqual(f.conflicting_notes(a, b), ["n.md"])

    def test_a_differing_index_is_not_a_conflict(self):
        a, b = self.dirs({"MEMORY.md": "- [A](a.md) - mine\n"},
                         {"MEMORY.md": "- [A](a.md) - theirs\n"})
        self.assertEqual(f.conflicting_notes(a, b), [])

    def test_notes_in_a_subdirectory_are_carried(self):
        """The comparison counts nested notes, so the join has to keep them -
        one it saw and the join did not would be a note quietly dropped."""
        a, b = self.dirs({"here.md": "x"}, {})
        (b / "sub").mkdir()
        (b / "sub" / "deep.md").write_text("y")
        out = Path(tempfile.mkdtemp()) / "joined"
        f.merge_memory(a, b, out)
        self.assertEqual(sorted(str(p.relative_to(out))
                                for p in out.rglob("*.md")),
                         ["here.md", "sub/deep.md"])
        for other in (a, b):
            self.assertIn(f.relation(f.note_set(out), f.note_set(other)),
                          (f.SAME, f.AHEAD))


class SyncEverything(unittest.TestCase):
    """`ferry sync` with no argument: this directory's worth.

    The same set `ferry sessions` lists, taking the action it names, so the
    listing is the dry run rather than a separate description of one.
    """

    def setUp(self):
        self.root = Path(tempfile.mkdtemp())
        self.here = Path(tempfile.mkdtemp())
        (self.root / "sessions" / "proj").mkdir(parents=True)
        self._repos, self._slug, self._one = f.repos, f.slug_dir, f.sync_one
        f.repos = lambda: {"s": {"path": str(self.root)}}
        f.slug_dir = lambda where=None: self.here
        self.synced = []
        f.sync_one = lambda a, t, pulled=None: self.synced.append(t)

    def tearDown(self):
        f.repos, f.slug_dir, f.sync_one = self._repos, self._slug, self._one

    def local(self, sid, name):
        (self.here / f"{sid}.jsonl").write_text(
            f'{{"sessionId":"{sid}","uuid":"1"}}\n'
            f'{{"type":"custom-title","customTitle":"{name}","sessionId":"{sid}"}}\n')

    def stored(self, folder, name):
        d = self.root / "sessions" / folder
        d.mkdir(parents=True, exist_ok=True)
        # Its own id: the store is catalogued by id, so two sessions
        # sharing one would be two names for a single conversation.
        (d / f"{name}.jsonl").write_text(
            f'{{"sessionId":"id-{name}","uuid":"u-{name}"}}\n'
            f'{{"type":"custom-title","customTitle":"{name}",'
            f'"sessionId":"id-{name}"}}\n')

    def run_it(self):
        with quiet() as (out, err):
            try:
                f.sync_everything(argparse.Namespace(memory=False,
                                                     allow_plaintext=True))
            except SystemExit:
                pass
        return out.getvalue() + err.getvalue()

    def test_it_syncs_what_a_store_already_has(self):
        self.local("a", "alpha"); self.stored("proj", "alpha")
        self.local("b", "beta"); self.stored("proj", "beta")
        self.run_it()
        self.assertEqual(sorted(self.synced), ["s:proj/alpha", "s:proj/beta"])

    def test_a_session_no_store_has_is_left_alone_and_said(self):
        """Where it should go is the one thing ferry cannot work out, and
        guessing a folder would file a conversation somewhere unchosen."""
        self.local("a", "alpha"); self.stored("proj", "alpha")
        self.local("c", "orphan")
        out = self.run_it()
        self.assertEqual(self.synced, ["s:proj/alpha"])
        self.assertIn("orphan is in no store", out)

    def test_an_unnamed_session_is_not_swept_up(self):
        (self.here / "u.jsonl").write_text('{"sessionId":"u","uuid":"1"}\n')
        self.local("a", "alpha"); self.stored("proj", "alpha")
        self.run_it()
        self.assertEqual(self.synced, ["s:proj/alpha"])

    def test_memory_follows_the_folder_its_sessions_are_in(self):
        """Memory has no name to look up, but it belongs to this directory,
        and this directory's sessions say which folder that is."""
        self.local("a", "alpha"); self.stored("proj", "alpha")
        (self.here / "memory").mkdir()
        (self.here / "memory" / "n.md").write_text("x")
        self.run_it()
        self.assertIn("s:proj", self.synced)

    def test_memory_is_left_when_the_folder_is_not_one_answer(self):
        """Sessions here living in two folders is a guess, not an answer."""
        self.local("a", "alpha"); self.stored("proj", "alpha")
        self.local("b", "beta"); self.stored("other", "beta")
        (self.here / "memory").mkdir()
        (self.here / "memory" / "n.md").write_text("x")
        out = self.run_it()
        self.assertNotIn("s:proj", self.synced)
        self.assertIn("belongs to no one folder", out)

    def test_nothing_paired_says_how_to_start(self):
        self.local("c", "orphan")
        out = self.run_it()
        self.assertEqual(self.synced, [])
        self.assertIn("nothing here is in a store yet", out)

    def test_one_failure_does_not_abandon_the_rest(self):
        """A session that cannot be synced is not a reason to leave the rest
        of the directory behind."""
        def boom(a, t, pulled=None):
            self.synced.append(t)
            if t.endswith("alpha"):
                raise SystemExit(1)
        f.sync_one = boom
        self.local("a", "alpha"); self.stored("proj", "alpha")
        self.local("b", "beta"); self.stored("proj", "beta")
        with quiet(), self.assertRaises(SystemExit) as e:
            f.sync_everything(argparse.Namespace(memory=False,
                                                 allow_plaintext=True))
        self.assertEqual(e.exception.code, 1)
        self.assertEqual(sorted(self.synced), ["s:proj/alpha", "s:proj/beta"])

    def test_each_store_is_brought_up_to_date_once(self):
        """Not once per session: a directory's worth of sessions in one store
        is one fetch."""
        seen = []
        f.sync_one = lambda a, t, pulled=None: seen.append(id(pulled))
        self.local("a", "alpha"); self.stored("proj", "alpha")
        self.local("b", "beta"); self.stored("proj", "beta")
        self.run_it()
        self.assertEqual(len(set(seen)), 1, "each call got its own pulled set")


class DiffDescription(unittest.TestCase):
    """What `diff` says about the records one copy holds alone.

    A count is not something you can act on: forty records could be an
    afternoon's work or a metadata write, and reset asks you to decide between
    them. So the turns that were typed come with the count - which is exactly
    the difference between "1 record" and "1 record, and it is a latch".
    """

    def test_conversation_is_counted_apart_from_bookkeeping(self):
        """Whether the difference contains anything a person wrote is the
        whole question, so it is the number that leads."""
        p = tmpfile('{"type":"user","uuid":"1"}\n'
                    '{"type":"assistant","uuid":"2"}\n'
                    '{"type":"mode","mode":"normal"}\n')
        turns, state, _ = f.only_in(p, f.line_set(p))
        self.assertEqual((turns, state), (2, {"mode": 1}))

    def test_the_state_that_matters_is_called_out(self):
        """"none of it conversation" reads as "nothing worth keeping", and one
        of these is the session's name - ferry finds sessions by it."""
        p = tmpfile('{"type":"custom-title","customTitle":"renamed"}\n')
        with quiet() as (out, _):
            f.show_side("losing", p, f.line_set(p))
        self.assertIn("custom-title is the session's name", out.getvalue())

    def test_it_is_called_out_beside_conversation_too(self):
        p = tmpfile('{"type":"user","uuid":"1","message":{"content":"hi"}}\n'
                    '{"type":"file-history-delta","messageId":"m"}\n')
        with quiet() as (out, _):
            f.show_side("losing", p, f.line_set(p))
        self.assertIn("1 record(s) of conversation", out.getvalue())
        self.assertIn("lets you rewind", out.getvalue())

    def test_disposable_state_is_not_called_out(self):
        """mode and permission-mode are rewritten every turn, and a latch holds
        a flag nobody chose - saying something about each would bury the one
        line that matters."""
        p = tmpfile('{"type":"mode","mode":"normal"}\n'
                    '{"type":"atis-latch","atis":""}\n'
                    '{"type":"ai-title","aiTitle":"x"}\n')
        with quiet() as (out, _):
            f.show_side("losing", p, f.line_set(p))
        self.assertNotIn("!", out.getvalue())

    def test_every_flagged_kind_says_what_it_is(self):
        for kind, why in f.CONSEQUENTIAL.items():
            with self.subTest(kind=kind):
                self.assertTrue(why and not why.endswith("."), kind)

    def test_a_difference_of_pure_bookkeeping_says_so(self):
        """An `atis-latch` is Claude Code latching its own state. Reporting it
        as "1 record" sends you looking up an internal name to discover that
        nothing happened."""
        p = tmpfile('{"type":"atis-latch","atis":"","sessionId":"x"}\n')
        turns, state, _ = f.only_in(p, f.line_set(p))
        self.assertEqual((turns, state), (0, {"atis-latch": 1}))

    def test_it_quotes_what_was_typed(self):
        p = tmpfile('{"type":"user","uuid":"1",'
                    '"message":{"role":"user","content":"fix the deploy"}}\n')
        _, _, said = f.only_in(p, f.line_set(p))
        self.assertEqual(said, ["fix the deploy"])

    def test_only_the_records_asked_for(self):
        p = tmpfile('{"type":"user","uuid":"1","message":{"content":"kept"}}\n'
                    '{"type":"user","uuid":"2","message":{"content":"skipped"}}\n')
        first = {f.record_key('{"type":"user","uuid":"1",'
                              '"message":{"content":"kept"}}')}
        turns, _, said = f.only_in(p, first)
        self.assertEqual((turns, said), (1, ["kept"]))

    def test_a_tool_result_is_not_quoted(self):
        """It is bulk, and quoting it would bury the turns that tell you which
        piece of work this is."""
        self.assertIsNone(f.record_text(
            {"message": {"content": "<tool_result>lots and lots</tool_result>"}}))

    def test_structured_content_is_read(self):
        self.assertEqual(f.record_text(
            {"message": {"content": [{"type": "text", "text": "hello"},
                                     {"type": "image"}]}}), "hello")

    def test_a_record_with_nothing_said_is_not_quoted(self):
        for r in ({}, {"message": None}, {"message": {}},
                  {"message": {"content": "   "}}):
            self.assertIsNone(f.record_text(r))

    def test_the_quote_is_capped(self):
        p = tmpfile('{"type":"user","uuid":"1","message":{"content":"%s"}}\n'
                    % ("x" * 400))
        _, _, said = f.only_in(p, f.line_set(p))
        self.assertLessEqual(len(said[0]), 97)

    def test_it_shows_only_a_few(self):
        lines = "".join('{"type":"user","uuid":"u%d","message":{"content":"t%d"}}\n'
                        % (i, i) for i in range(20))
        p = tmpfile(lines)
        _, _, said = f.only_in(p, f.line_set(p))
        self.assertEqual(len(said), 4)

    def test_an_unparseable_line_still_counts(self):
        p = tmpfile("not json at all\n")
        turns, state, _ = f.only_in(p, f.line_set(p))
        self.assertEqual((turns, state), (0, {"unparseable": 1}))


class Confirm(unittest.TestCase):
    """reset is the one command that loses something on purpose, so it asks."""

    def setUp(self):
        self._stdin = sys.stdin

    def tearDown(self):
        sys.stdin = self._stdin

    class Fake(io.StringIO):
        def __init__(self, text, tty):
            super().__init__(text)
            self._tty = tty

        def isatty(self):
            return self._tty

    def test_yes(self):
        for answer in ("y\n", "Y\n", "yes\n", " yes \n"):
            sys.stdin = self.Fake(answer, True)
            with quiet():
                got = f.confirm("go ahead?")
            self.assertTrue(got, answer)

    def test_anything_else_is_no(self):
        for answer in ("n\n", "\n", "later\n", "Ynot\n"):
            sys.stdin = self.Fake(answer, True)
            with quiet():
                got = f.confirm("go ahead?")
            self.assertFalse(got, answer)

    def test_end_of_input_is_no(self):
        sys.stdin = self.Fake("", True)
        with quiet():
            self.assertFalse(f.confirm("go ahead?"))

    def test_with_nobody_to_ask_it_refuses(self):
        """Not "assume yes" and not "assume no" - a pipe cannot answer, and
        guessing either way is worse than saying so."""
        sys.stdin = self.Fake("", False)
        with quiet() as (_, err), self.assertRaises(SystemExit):
            f.confirm("go ahead?")
        self.assertIn("--yes", err.getvalue())


class TheSuiteItself(unittest.TestCase):
    """The suite has to be able to say it ran everything.

    Two classes with the same name is not an error in Python - the second
    replaces the first, and unittest then finds only one of them. Six tests
    disappeared that way while this file was being edited, and the only symptom
    was a count that went up by less than it should have.
    """

    def test_no_two_test_classes_share_a_name(self):
        source = Path(__file__).read_text()
        names = re.findall(r"^class (\w+)\(unittest\.TestCase\):", source,
                           re.M)
        doubled = sorted({n for n in names if names.count(n) > 1})
        self.assertEqual(doubled, [],
                         "a later class of this name hides an earlier one, and "
                         "its tests stop running")


class SyncMemoryNoTarget(unittest.TestCase):
    """`ferry sync -m` with nothing after it.

    It used to walk every session this directory had in a store and write the
    directory's memory into a folder named after each - one invocation made 14
    folders, 462 files, 14 commits, all pushed. The flag says which kind the
    *target* is, and it was still set when the loop handed each session ref on.

    Worse than the write was the read that followed: a memory folder is walked
    recursively, so those subfolders counted as part of the memory itself, and
    the next `sync --memory` would have merged them all back down into the one
    directory whose notes get loaded into every session.
    """

    def setUp(self):
        self.root = Path(tempfile.mkdtemp())
        self.here = Path(tempfile.mkdtemp())
        (self.root / "sessions" / "proj").mkdir(parents=True)
        (self.root / "memories" / "proj").mkdir(parents=True)
        (self.here / "memory").mkdir()
        (self.here / "memory" / "note.md").write_text("a note\n")
        self._repos, self._slug, self._cache = f.repos, f.slug_dir, f.CACHE
        f.repos = lambda: {"s": {"path": str(self.root)}}
        f.slug_dir = lambda where=None: self.here
        f.CACHE = self.root / ".cache"
        self.sent = []
        self._one = f.sync_one
        f.sync_one = lambda a, t, pulled=None: self.sent.append((t, a.memory))

    def tearDown(self):
        f.repos, f.slug_dir, f.CACHE = self._repos, self._slug, self._cache
        f.sync_one = self._one

    def stored(self, name, sid):
        (self.root / "sessions" / "proj" / f"{sid}.jsonl").write_text(
            f'{{"sessionId":"{sid}","uuid":"u-{sid}"}}\n'
            f'{{"type":"custom-title","customTitle":"{name}",'
            f'"sessionId":"{sid}"}}\n')
        (self.here / f"{sid}.jsonl").write_text(
            f'{{"sessionId":"{sid}","uuid":"u-{sid}"}}\n'
            f'{{"type":"custom-title","customTitle":"{name}",'
            f'"sessionId":"{sid}"}}\n')

    def run_it(self, memory):
        with quiet() as (out, err):
            try:
                f.sync_everything(argparse.Namespace(memory=memory,
                                                     allow_plaintext=True))
            except SystemExit:
                pass
        return out.getvalue() + err.getvalue()

    def test_it_syncs_the_memory_and_nothing_else(self):
        self.stored("alpha", "aaaa")
        self.stored("beta", "bbbb")
        self.run_it(memory=True)
        self.assertEqual(self.sent, [("s:proj", True)])

    def test_no_session_is_ever_handed_on_as_memory(self):
        """The whole of the bug in one assertion: a session ref reaching
        sync_one with memory set is what named a memory folder after it."""
        self.stored("alpha", "aaaa")
        self.stored("beta", "bbbb")
        for memory in (True, False):
            self.sent = []
            self.run_it(memory=memory)
            for target, was_memory in self.sent:
                with self.subTest(target=target, memory=memory):
                    self.assertFalse(was_memory and "/" in target.split(":")[1],
                                     f"{target} was synced as memory")

    def test_without_the_flag_both_kinds_go(self):
        self.stored("alpha", "aaaa")
        self.run_it(memory=False)
        self.assertEqual(sorted(self.sent), [("s:proj", True),
                                             ("s:proj/alpha", False)])

    def test_memory_with_no_folder_to_infer_says_so(self):
        got = self.run_it(memory=True)
        self.assertIn("no one folder of a store", got)
        self.assertEqual(self.sent, [])

    def test_no_notes_at_all_says_that_instead(self):
        (self.here / "memory" / "note.md").unlink()
        self.stored("alpha", "aaaa")
        got = self.run_it(memory=True)
        self.assertIn("no notes here", got)
        self.assertEqual(self.sent, [])


class OneNamePerFolder(unittest.TestCase):
    """A name means one session within a folder.

    The filesystem used to enforce that - one file could have one name - and a
    store keyed by id cannot, so it is said out loud. It is reachable by
    renaming a session onto a name its folder already has, which is one
    /rename away, and what it produced was two rows in `ferry list` with the
    same ref and a refusal asking you to choose between two identical strings.
    """

    def setUp(self):
        self.root = Path(tempfile.mkdtemp())
        (self.root / "sessions" / "proj").mkdir(parents=True)
        self._repos, self._cache = f.repos, f.CACHE
        f.repos = lambda: {"s": {"path": str(self.root)}}
        f.CACHE = self.root / ".cache"

    def tearDown(self):
        f.repos, f.CACHE = self._repos, self._cache

    def stored(self, folder, sid, name):
        d = self.root / "sessions" / folder
        d.mkdir(parents=True, exist_ok=True)
        (d / f"{sid}.jsonl").write_text(
            f'{{"sessionId":"{sid}","uuid":"u-{sid}"}}\n'
            f'{{"type":"custom-title","customTitle":"{name}",'
            f'"sessionId":"{sid}"}}\n')

    def sending(self, sid, name):
        return tmpfile(f'{{"sessionId":"{sid}","uuid":"u-{sid}"}}\n'
                       f'{{"type":"custom-title","customTitle":"{name}",'
                       f'"sessionId":"{sid}"}}\n', name=sid)

    def send(self, path, src):
        args = argparse.Namespace(allow_plaintext=True, memory=False)
        with quiet() as (out, err):
            try:
                f.sync_send(args, self.root, "s", path, src, None, "x")
            except SystemExit:
                pass
        return out.getvalue() + err.getvalue()

    def test_a_name_the_folder_already_has_is_refused(self):
        self.stored("proj", "aaaa", "bug-hunt")
        got = self.send("proj/bug-hunt", self.sending("bbbb", "bug-hunt"))
        self.assertIn("already has a session called 'bug-hunt'", got)
        self.assertIn("aaaa", got)
        self.assertIn("bbbb", got)

    def test_the_same_session_again_is_not_a_clash(self):
        self.stored("proj", "aaaa", "bug-hunt")
        got = self.send("proj/bug-hunt", self.sending("aaaa", "bug-hunt"))
        self.assertNotIn("already has", got)

    def test_another_folder_may_hold_the_name(self):
        """The rule is per folder, as it was when the filesystem kept it."""
        self.stored("proj", "aaaa", "bug-hunt")
        got = self.send("elsewhere/bug-hunt", self.sending("bbbb", "bug-hunt"))
        self.assertNotIn("already has", got)

    def test_a_session_with_no_name_cannot_clash(self):
        self.stored("proj", "aaaa", "bug-hunt")
        src = tmpfile('{"sessionId":"bbbb","uuid":"u"}\n', name="bbbb")
        self.assertNotIn("already has", self.send("proj/whatever", src))

    def test_nothing_is_written_when_it_refuses(self):
        self.stored("proj", "aaaa", "bug-hunt")
        before = sorted(p.name for p in
                        (self.root / "sessions" / "proj").iterdir())
        self.send("proj/bug-hunt", self.sending("bbbb", "bug-hunt"))
        self.assertEqual(sorted(p.name for p in
                                (self.root / "sessions" / "proj").iterdir()),
                         before)


class StoreLayoutMarker(unittest.TestCase):
    """The marker that says which ferry wrote a store.

    Its whole purpose is the next format change, not this one: a ferry too old
    to read a store should say so, rather than misreading it. The version
    before this could not - shown an id-named session it reported the uuid as
    the session's name and the session as stored nowhere.
    """

    def setUp(self):
        self.repo = Path(tempfile.mkdtemp())

    def test_a_store_with_no_marker_is_the_layout_before_it(self):
        self.assertEqual(f.read_layout(self.repo), 1)

    def test_marking_writes_the_layout(self):
        self.assertEqual(f.mark_layout(self.repo), [f.MARKER])
        self.assertEqual(f.read_layout(self.repo), f.LAYOUT)

    def test_marking_twice_changes_nothing(self):
        f.mark_layout(self.repo)
        self.assertEqual(f.mark_layout(self.repo), [])

    def test_the_marker_is_kept_readable_without_the_key(self):
        """git-crypt encrypts everything by default, and a store you cannot
        understand is exactly the case worth being able to read."""
        (self.repo / ".gitattributes").write_text("* filter=git-crypt\n")
        changed = f.mark_layout(self.repo)
        self.assertIn(".gitattributes", changed)
        self.assertIn(f"{f.MARKER}", (self.repo / ".gitattributes").read_text())

    def test_it_does_not_rewrite_gitattributes_twice(self):
        (self.repo / ".gitattributes").write_text("* filter=git-crypt\n")
        f.mark_layout(self.repo)
        self.assertNotIn(".gitattributes", f.mark_layout(self.repo))

    def test_a_newer_store_is_refused(self):
        (self.repo / f.MARKER).write_text(f"layout {f.LAYOUT + 1}\n")
        with quiet() as (_, err), self.assertRaises(SystemExit):
            f.check_layout(self.repo)
        self.assertIn("newer ferry", err.getvalue())

    def test_this_layout_is_fine(self):
        f.mark_layout(self.repo)
        f.check_layout(self.repo)

    def test_an_older_store_is_fine(self):
        """Reading does not depend on layout - a session is found by the id
        inside it, whatever its file is called."""
        f.check_layout(self.repo)

    def test_an_unreadable_marker_is_not_a_newer_store(self):
        (self.repo / f.MARKER).write_text("this is not a layout line\n")
        f.check_layout(self.repo)
        self.assertEqual(f.read_layout(self.repo), 1)


class Catalogue(unittest.TestCase):
    """What a store holds, read from the transcripts rather than the filenames.

    A session is identified by the id inside it; what the file is called is
    storage. Reading fifty of them takes a second and a half and a listing
    cannot, so the answer is kept - and because it is a cache, it records the
    commit it was built from and is never trusted further than that.
    """

    def setUp(self):
        self.tmp = Path(tempfile.mkdtemp())
        self.repo = self.tmp / "store"
        (self.repo / "sessions" / "p").mkdir(parents=True)
        self.git("init", "-q")
        self.git("config", "user.email", "t@e")
        self.git("config", "user.name", "t")
        self._cache = f.CACHE
        f.CACHE = self.tmp / "cache"

    def tearDown(self):
        f.CACHE = self._cache

    def git(self, *args):
        return subprocess.run(["git", "-C", str(self.repo), *args],
                              capture_output=True, text=True)

    def add(self, sid, name, filename):
        (self.repo / "sessions" / "p" / f"{filename}.jsonl").write_text(
            f'{{"sessionId":"{sid}","type":"user","uuid":"u-{sid}"}}\n'
            f'{{"type":"custom-title","customTitle":"{name}",'
            f'"sessionId":"{sid}"}}\n')

    def commit(self, message="x"):
        self.git("add", "-A")
        self.git("commit", "-qm", message)

    def names(self):
        return sorted(v["name"] for v in f.catalogue(self.repo).values())

    def test_it_reads_the_name_from_inside(self):
        self.add("aaaa", "alpha", "whatever-the-file-is-called")
        self.commit()
        self.assertEqual(self.names(), ["alpha"])

    def test_the_path_is_recorded_not_assumed(self):
        self.add("aaaa", "alpha", "not-the-name")
        self.commit()
        entry = f.catalogue(self.repo)["aaaa"]
        self.assertEqual(entry["path"], "sessions/p/not-the-name.jsonl")

    def test_an_unchanged_store_is_not_read_again(self):
        self.add("aaaa", "alpha", "a")
        self.commit()
        self.assertEqual(self.names(), ["alpha"])
        # the cache is what answers now, so a file changed behind git's back
        # is not noticed - which is what makes it cheap
        (self.repo / "sessions" / "p" / "a.jsonl").write_text(
            '{"sessionId":"aaaa","type":"user","uuid":"u"}\n'
            '{"type":"custom-title","customTitle":"renamed","sessionId":"aaaa"}\n')
        self.assertEqual(self.names(), ["alpha"])
        self.commit("now committed")
        self.assertEqual(self.names(), ["renamed"])

    def test_a_session_added(self):
        self.add("aaaa", "alpha", "a"); self.commit()
        self.add("bbbb", "beta", "b"); self.commit()
        self.assertEqual(self.names(), ["alpha", "beta"])

    def test_a_session_removed(self):
        self.add("aaaa", "alpha", "a"); self.add("bbbb", "beta", "b")
        self.commit()
        self.git("rm", "-q", "sessions/p/a.jsonl"); self.commit()
        self.assertEqual(self.names(), ["beta"])

    def test_a_file_renamed_keeps_its_session(self):
        """The whole point: a session is its id, so moving the file it lives in
        changes where it is and nothing about what it is."""
        self.add("aaaa", "alpha", "alpha"); self.commit()
        self.git("mv", "sessions/p/alpha.jsonl", "sessions/p/aaaa.jsonl")
        self.commit()
        entry = f.catalogue(self.repo)["aaaa"]
        self.assertEqual((entry["name"], entry["path"]),
                         ("alpha", "sessions/p/aaaa.jsonl"))

    def test_a_cached_commit_that_no_longer_exists(self):
        """History can be rewritten under it. Nothing to diff against means
        read everything, which is slow and right rather than fast and wrong."""
        self.add("aaaa", "alpha", "a"); self.commit()
        self.names()
        f.catalogue_file(self.repo).write_text(json.dumps(
            {"head": "0" * 40, "sessions": {"zz": {"name": "ghost",
                                                   "path": "gone"}}}))
        self.assertEqual(self.names(), ["alpha"])

    def test_an_unreadable_cache(self):
        self.add("aaaa", "alpha", "a"); self.commit()
        self.names()
        f.catalogue_file(self.repo).write_text("not json at all")
        self.assertEqual(self.names(), ["alpha"])

    def test_a_store_with_no_commits_yet(self):
        self.assertEqual(self.names(), [])

    def test_two_stores_do_not_share_a_catalogue(self):
        other = self.tmp / "other"
        (other / "sessions").mkdir(parents=True)
        self.assertNotEqual(f.catalogue_file(self.repo),
                            f.catalogue_file(other))


class ForkMessages(unittest.TestCase):
    """What memory says when it will not join. Sessions are joined instead, so
    this is the only refusal left, and it has to say enough to act on."""

    def test_a_note_changed_on_both_sides_is_not_called_missing(self):
        """It is in the store - it just says something else. Reporting that as
        "not in the store" sends you looking for a note that is right there."""
        msg = f.memory_fork_message("mem", {("a.md", "h1")}, {("a.md", "h2")})
        self.assertIn("changed on both sides: a.md", msg)
        self.assertNotIn("only here", msg)
        self.assertNotIn("only there", msg)

    def test_a_note_on_one_side_only_says_which(self):
        msg = f.memory_fork_message("mem", {("a.md", "h")}, {("b.md", "h")})
        self.assertIn("only here: a.md", msg)
        self.assertIn("only there: b.md", msg)

    def test_the_three_kinds_are_kept_apart(self):
        msg = f.memory_fork_message(
            "mem",
            {("both.md", "h1"), ("mine.md", "h")},
            {("both.md", "h2"), ("theirs.md", "h")})
        self.assertIn("changed on both sides: both.md", msg)
        self.assertIn("only here: mine.md", msg)
        self.assertIn("only there: theirs.md", msg)

    def test_a_long_list_is_cut_short(self):
        ours = {(f"n{i}.md", "h") for i in range(9)}
        msg = f.memory_fork_message("mem", ours, {("x.md", "h")})
        self.assertIn("and more", msg)

    def test_it_says_why_a_note_is_not_joined(self):
        """A transcript is joined; a note cannot be, and the message has to
        say which of those you are looking at."""
        msg = f.memory_fork_message("x", {("a", "1")}, {("a", "2")})
        self.assertIn("no join that is not a guess", msg)


class Completion(unittest.TestCase):
    """Candidates the shell asks for.

    Given a machine of its own: a store with a couple of folders, and a
    projects tree holding one named session and one without. These used to run
    against whatever the developer happened to have registered and skip when
    there was nothing - which meant they tested nothing at all on CI, where
    there never is.
    """

    def setUp(self):
        import json as _json
        self.store = Path(tempfile.mkdtemp())
        for p in ("sessions/acme/bug-hunt.jsonl", "sessions/beta/deploy.jsonl",
                  "memories/acme/note.md"):
            (self.store / p).parent.mkdir(parents=True, exist_ok=True)
            (self.store / p).write_text("{}\n")

        self.projects = Path(tempfile.mkdtemp())
        here = self.projects / f.slug_dir(Path.cwd()).name
        here.mkdir(parents=True)
        (here / "named.jsonl").write_text(_json.dumps(
            {"type": "custom-title", "customTitle": "bug-hunt",
             "sessionId": "named"}) + "\n")
        (here / "nameless.jsonl").write_text(_json.dumps(
            {"type": "user", "cwd": str(Path.cwd())}) + "\n")
        (here / "memory").mkdir()
        (here / "memory" / "a-note.md").write_text("---\ndescription: x\n---\n")

        self.saved = (f.repos, f.CLAUDE_PROJECTS)
        f.repos = lambda: {"work": {"path": str(self.store)}}
        f.CLAUDE_PROJECTS = self.projects

    def tearDown(self):
        f.repos, f.CLAUDE_PROJECTS = self.saved

    def complete(self, *words):
        sys.argv = ["ferry", "complete", *words]
        with quiet() as (out, _):
            f.main()
        return out.getvalue().split()

    def test_offers_the_commands(self):
        got = self.complete("ferry", "")
        for c in ("add", "sync", "list", "update", "sessions",
                  "memory", "stores"):
            self.assertIn(c, got)

    def test_filters_commands_by_prefix(self):
        self.assertEqual(self.complete("ferry", "sy"), ["sync"])

    def test_offers_flags_for_the_command(self):
        got = self.complete("ferry", "sync", "x", "-")
        self.assertIn("--memory", got)
        self.assertIn("--allow-plaintext", got)

    def test_does_not_offer_another_commands_flags(self):
        self.assertNotIn("--allow-plaintext", self.complete("ferry", "list", "-"))

    def complete_line(self, line):
        sys.argv = ["ferry", "complete", "--line", line]
        with quiet() as (out, _):
            f.main()
        return out.getvalue().split()

    def first_argument(self, command):
        """What is offered for a command's first argument, and how."""
        return self.status_of(f"ferry {command} "), \
            self.complete_line(f"ferry {command} ")

    # add invents a name and rename's second word is one too, so there is
    # genuinely nothing to offer; stores takes no argument at all.
    OFFERS_NOTHING = {"add", "stores"}

    def test_every_command_completes_its_first_argument(self):
        """A command can be in the parser and in the flag table and still have
        no branch deciding what its argument completes to - and then it offers
        nothing at all, silently. That is how diff and reset shipped, and how
        rename and remove had gone without ever offering a store."""
        for command in sorted(f.COMMANDS):
            if command in self.OFFERS_NOTHING:
                continue
            with self.subTest(command=command):
                code, got = self.first_argument(command)
                self.assertTrue(got or code in (f.NOTHING, f.FILES),
                                f"`ferry {command} <TAB>` offers nothing and "
                                f"does not say why")

    def test_the_paired_commands_offer_the_same_things(self):
        """sync, diff and reset name one thing held in both places, so they
        take the same ref and must answer alike."""
        expected = self.first_argument("sync")
        for command in sorted(f.PAIRED - {"sync"}):
            with self.subTest(command=command):
                self.assertEqual(self.first_argument(command), expected)

    def test_a_store_name_is_offered_where_one_is_wanted(self):
        for command in sorted(f.NAMES_A_STORE):
            with self.subTest(command=command):
                _, got = self.first_argument(command)
                self.assertEqual(got, sorted(f.repos()))

    def test_line_mode_keeps_a_colon_ref_whole(self):
        """bash splits on ':', so the line is parsed here instead."""
        self.assertEqual(self.complete_line("ferry sy"), ["sync"])

    def test_line_mode_knows_a_trailing_space_starts_a_new_word(self):
        self.assertEqual(self.complete_line("ferry sy "), [])

    def test_line_mode_survives_an_unbalanced_quote(self):
        self.complete_line("ferry sync \"unclosed")

    def test_sync_offers_what_the_store_holds(self):
        """One ref, and it is a store ref - there is no first word naming a
        session here, because the store path carries the name."""
        got = self.complete_line("ferry sync store:")
        self.assertTrue(all(g.startswith("store:") for g in got), got)

    def test_sync_memory_offers_folders(self):
        """--memory says which of the two trees, the same as everywhere else."""
        got = self.complete_line("ferry sync --memory store:")
        self.assertTrue(all(g.startswith("store:") for g in got), got)
    def test_a_short_flag_never_means_two_things(self):
        """-m is --memory in four commands. A fifth where it meant --media
        would be worse than having no short form there at all."""
        import collections
        pairs = re.findall(r'add_argument\("(-[a-zA-Z])", "(--[a-z-]+)"',
                           FERRY.read_text())
        self.assertTrue(pairs, "no short flags found - did the syntax change?")
        by_letter = collections.defaultdict(set)
        for short, long in pairs:
            by_letter[short].add(long)
        clashes = {k: sorted(v) for k, v in by_letter.items() if len(v) > 1}
        self.assertEqual(clashes, {})

    def test_the_top_level_flags_are_offered(self):
        self.assertEqual(self.complete_line("ferry --vers"), ["--version"])
        self.assertEqual(self.complete_line("ferry -"), ["--help", "--version"])

    def test_a_flag_is_not_mistaken_for_a_command(self):
        """`ferry -<TAB>` wants flags; `ferry <TAB>` wants commands."""
        self.assertNotIn("save", self.complete_line("ferry -"))
        self.assertNotIn("--help", self.complete_line("ferry "))

    def status_of(self, line):
        """What `ferry complete` answers with, as its exit code."""
        sys.argv = ["ferry", "complete", "--line", line]
        with quiet():
            try:
                f.main()
            except SystemExit as e:
                return e.code or 0
        return 0

    def test_a_path_position_asks_the_shell_for_files(self):
        """--key and --path take a path on this machine. ferry cannot know it,
        but it can say that a filename is what belongs there - typed either
        way, since -k is the same flag as --key."""
        for line in ("ferry add x --key ", "ferry add x --path ",
                     "ferry add x -k ", "ferry add x -p ",
                     "ferry export -m y --media ",
                     "ferry add x --key ~/half", "ferry add x -k ~/half"):
            with self.subTest(line=line):
                self.assertEqual(self.status_of(line), f.FILES)

    def test_a_name_you_invent_gets_nothing_at_all(self):
        """The second word of `name` is one you are about to make up, so
        nothing is offered - and in particular not a filename, which is what
        an empty answer would otherwise fall back to."""
        for line in ("ferry name 6af148fd ", "ferry name 6af148fd half-typed"):
            with self.subTest(line=line):
                self.assertEqual(self.complete_line(line), [])
                self.assertNotEqual(self.status_of(line), f.FILES)

    def test_a_command_taking_no_arguments_says_so(self):
        """`ferry stores <TAB>` offering filenames is noise - nothing goes
        there, which is a different answer from having no suggestion."""
        for line in ("ferry stores ",):
            with self.subTest(line=line):
                self.assertEqual(self.status_of(line), f.NOTHING)

    def test_an_ordinary_position_answers_normally(self):
        for line in ("ferry sync ", "ferry ", "ferry list "):
            with self.subTest(line=line):
                self.assertEqual(self.status_of(line), 0)

    def test_a_flags_value_does_not_shift_the_argument(self):
        """The bug this guards: --media took a directory, and the word after it
        was counted as the ref, so the real ref was never completed."""
        for flagged, plain in (
                ("ferry export --media /tmp/pics work:", "ferry export work:"),
                ("ferry add n --key /tmp/k ", "ferry add n ")):
            with self.subTest(line=flagged):
                self.assertEqual(self.complete_line(flagged),
                                 self.complete_line(plain))

    def test_sessions_completes_directories(self):
        """The argument is a directory, so the ones holding sessions are the
        useful answers - offered without a colon, since this is not a ref.

        The status is checked first: with no sessions at all, which is the case
        on CI, this position exits FILES rather than returning an empty list,
        and complete_line would raise rather than hand back nothing.
        """
        got = self.complete_line("ferry sessions ")
        self.assertEqual(got, [f.tilde(str(Path.cwd()))])
        self.assertTrue(all(not c.endswith(":") for c in got))

    def test_a_short_flag_reaches_completion_too(self):
        """`-m` and `--memory` are the same flag, and completion only knew the
        long one - so `ferry sync -m store:` completed as though it had not
        been given at all."""
        for short, long in (("ferry sync -m work:", "ferry sync --memory work:"),
                            ("ferry export -a work:", "ferry export --all work:")):
            with self.subTest(line=short):
                self.assertEqual(self.complete_line(short),
                                 self.complete_line(long))

    def test_bunched_short_flags_count(self):
        """-ag is both of them, which a plain `in words` cannot see."""
        self.assertTrue(f.given(["ferry", "sessions", "-ag"], "--all", "-a"))
        self.assertTrue(f.given(["ferry", "sessions", "-ag"], "--global", "-g"))
        self.assertFalse(f.given(["ferry", "sessions", "-g"], "--all", "-a"))
        self.assertFalse(f.given(["ferry", "sessions"], "--all", "-a"))

    def test_a_long_flag_is_not_read_as_a_bunch(self):
        """--global contains an 'a', and must not therefore count as --all."""
        self.assertFalse(f.given(["ferry", "sessions", "--global"], "--all", "-a"))

    def test_memory_completes_directories_that_remember_something(self):
        """Not the same set as the ones holding sessions."""
        self.assertEqual(self.complete_line("ferry memory "),
                         [f.tilde(str(Path.cwd()))])

    def test_export_memory_offers_stores_as_well(self):
        """`export -m` reads from either side, like `export` itself - and a
        store is offered a level at a time, as everywhere else."""
        got = self.complete_line("ferry export -m ")
        self.assertIn("work:", got)                      # the store
        self.assertIn(f.tilde(str(Path.cwd())) + ":", got)   # and this directory
        self.assertEqual(self.complete_line("ferry export -m work:"),
                         ["work:acme/"])                 # then its memory

    def test_a_memory_ref_can_name_one_note(self):
        """The same shape a session ref has, with a note where the name goes."""
        got = self.complete_line("ferry export -m work:acme/")
        self.assertEqual(got, ["work:acme/note"])       # without the .md

    def test_a_memory_folder_carries_on_rather_than_ending(self):
        """It is both an answer and a step: a folder means all of its notes,
        and one more character reaches any one of them. So it must not get a
        space, which would strand you at the folder."""
        self.assertEqual(self.complete_line("ferry export -m work:"),
                         ["work:acme/"])
        here = f.tilde(str(Path.cwd()))
        self.assertIn(here + ":", self.complete_line("ferry export -m "))

    def test_a_local_memory_ref_names_a_note_after_the_colon(self):
        here = f.tilde(str(Path.cwd()))
        self.assertEqual(self.complete_line(f"ferry export -m {here}:"),
                         [f"{here}:a-note"])

    def test_export_memory_never_offers_a_session(self):
        self.assertNotIn("bug-hunt", self.complete_line("ferry export -m "))

    def test_completion_never_offers_a_ref_that_would_fail(self):
        """A directory with no *named* session has no ref `export` could take,
        so nothing is offered rather than a path that dead-ends. It used to
        fall through to filename completion, which walked you into one."""
        import json as _json
        bare = Path(tempfile.mkdtemp()).resolve() / "nothing-named"
        bare.mkdir(parents=True)
        d = self.projects / f.slug_dir(bare).name
        d.mkdir(parents=True)
        (d / "x.jsonl").write_text(_json.dumps(
            {"type": "user", "cwd": str(bare)}) + "\n")
        typed = f"ferry export {f.tilde(str(bare))[:-3]}"
        self.assertEqual(self.complete_line(typed), [])
        # with --all an id can name it, so then there is something to offer
        self.assertTrue(self.complete_line(f"ferry export -a "
                                           f"{f.tilde(str(bare))[:-3]}"))

    def test_sessions_still_offers_a_directory_of_unnamed_ones(self):
        """`ferry sessions <dir>` reports how many are unnamed and how to see
        them, so it is not a dead end the way an export ref would be."""
        import json as _json
        bare = Path(tempfile.mkdtemp()).resolve() / "only-unnamed"
        bare.mkdir(parents=True)
        d = self.projects / f.slug_dir(bare).name
        d.mkdir(parents=True)
        (d / "x.jsonl").write_text(_json.dumps(
            {"type": "user", "cwd": str(bare)}) + "\n")
        self.assertIn(f.tilde(str(bare)),
                      self.complete_line("ferry sessions "))

    def test_every_spelling_of_a_flag_reaches_completion(self):
        """Twice now a flag has worked long and done nothing short, because
        completion re-derives flags from the raw line rather than from
        argparse. This walks all three spellings of the ones that change what
        is offered."""
        for long, short, cluster in (
                ("ferry sync --memory work:", "ferry sync -m work:", None),
                ("ferry list --memory work:", "ferry list -m work:", None),
                ("ferry move --memory work:", "ferry move -m work:",
                 "ferry move -mf work:"),
                ("ferry export --memory ", "ferry export -m ",
                 "ferry export -tm "),
                ("ferry sessions --all ", "ferry sessions -a ",
                 "ferry sessions -ag "),
                ("ferry export --all work:", "ferry export -a work:",
                 "ferry export -ta work:")):
            with self.subTest(flag=long):
                want = self.complete_line(long)
                self.assertEqual(self.complete_line(short), want)
                if cluster:
                    self.assertEqual(self.complete_line(cluster), want)

    def test_every_value_flag_asks_for_the_right_thing(self):
        """--key takes a path either way it is spelled; --name takes a name
        you are inventing, so nothing - not even a filename."""
        for line in ("ferry add x --key ", "ferry add x -k ",
                     "ferry add x --path ", "ferry add x -p ",
                     "ferry export -m y --media "):
            with self.subTest(line=line):
                self.assertEqual(self.status_of(line), f.FILES)

    def test_a_flag_that_changes_nothing_changes_nothing(self):
        for plain, flagged in (("ferry export work:", "ferry export -r work:"),
                               ("ferry export work:", "ferry export -t work:")):
            with self.subTest(line=flagged):
                self.assertEqual(self.complete_line(flagged),
                                 self.complete_line(plain))

    def test_move_completes(self):
        self.assertEqual(self.complete_line("ferry mo"), ["move"])
        self.assertIn("--memory", self.complete_line("ferry move -"))

    def test_move_source_follows_the_memory_flag(self):
        """Like load: --memory offers folders holding memory, plain offers
        sessions. The destination is a folder either way."""
        plain = self.complete_line("ferry move work:")
        mem = self.complete_line("ferry move --memory work:")
        self.assertNotEqual(plain, mem)
        self.assertIn("work:acme", mem)

    def test_memory_flag_completes(self):
        self.assertEqual(self.complete_line("ferry sync --mem"), ["--memory"])

    def test_sync_and_sync_memory_are_mirror_images(self):
        """Neither should offer what the other takes."""
        plain = self.complete_line("ferry sync work:")
        mem = self.complete_line("ferry sync --memory work:")
        self.assertTrue(plain and mem)
        self.assertFalse([c for c in plain if c.endswith("/memory")],
                         "plain sync offered a memory directory")
        self.assertFalse([c for c in mem if c.endswith("/memory")],
                         "--memory offered the memory/ instead of its parent")

    def test_complete_is_hidden_from_help(self):
        self.assertNotIn("complete", f.USAGE)


class CommandLine(unittest.TestCase):
    """Argument parsing, stubbing the commands so nothing touches the disk."""

    def setUp(self):
        self.calls = []
        self.originals = {}
        for name in ("cmd_add", "cmd_stores", "cmd_sessions", "cmd_memory",
                     "cmd_sync", "cmd_diff", "cmd_reset", "cmd_move", "cmd_list",
                     "cmd_update", "cmd_export"):
            self.originals[name] = getattr(f, name)
            setattr(f, name, lambda args, n=name: self.calls.append((n, args)))

    def tearDown(self):
        for name, fn in self.originals.items():
            setattr(f, name, fn)

    def run_ferry(self, *argv):
        sys.argv = ["ferry", *argv]
        with quiet() as (out, err):
            f.main()
        return out.getvalue(), err.getvalue()

    def test_the_shorts_actually_parse(self):
        for argv, attr in ((["sessions", "-g"], "global_"),
                           (["sessions", "-a"], "all"),
                           (["sync", "-m", "work:x"], "memory"),
                           (["export", "-t", "x"], "tools"),
                           (["export", "-r", "x"], "raw")):
            with self.subTest(argv=argv):
                self.run_ferry(*argv)
                self.assertTrue(getattr(self.calls[-1][1], attr))

    def test_bare_ferry_prints_help(self):
        out, _ = self.run_ferry()
        self.assertIn("usage:", out)
        self.assertIn("ferry sync", out)
        self.assertEqual(self.calls, [])

    def test_diff_takes_one_ref(self):
        self.run_ferry("diff", "bug-hunt")
        name, args = self.calls[0]
        self.assertEqual((name, args.target), ("cmd_diff", "bug-hunt"))

    def test_reset_takes_one_ref(self):
        self.run_ferry("reset", "work:acme/bug-hunt")
        name, args = self.calls[0]
        self.assertEqual((name, args.target), ("cmd_reset", "work:acme/bug-hunt"))
        self.assertFalse(args.yes)

    def test_reset_yes_is_a_flag(self):
        self.run_ferry("reset", "-y", "bug-hunt")
        self.assertTrue(self.calls[0][1].yes)

    def test_diff_has_no_yes(self):
        """It writes nothing, so there is nothing to agree to."""
        with quiet(), self.assertRaises(SystemExit):
            self.run_ferry("diff", "--yes", "bug-hunt")

    def test_sync_takes_one_ref(self):
        self.run_ferry("sync", "work:acme/bug-hunt")
        name, args = self.calls[0]
        self.assertEqual(name, "cmd_sync")
        self.assertEqual(args.target, "work:acme/bug-hunt")
