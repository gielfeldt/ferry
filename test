class Completion(unittest.TestCase):
    """Candidates the shell asks for.

    Given a machine of its own: a store with a couple of folders, and a
    projects tree holding one named session and one without. These used to run
    against whatever the developer happened to have registered and skip when
    there was nothing - which meant they tested nothing at all on CI, where
    there never is.
    """

    def setUp(self):
        import json as _json
        self.store = Path(tempfile.mkdtemp())
        for p in ("sessions/acme/bug-hunt.jsonl", "sessions/beta/deploy.jsonl",
                  "memories/acme/note.md"):
            (self.store / p).parent.mkdir(parents=True, exist_ok=True)
            (self.store / p).write_text("{}\n")

        self.projects = Path(tempfile.mkdtemp())
        here = self.projects / f.slug_dir(Path.cwd()).name
        here.mkdir(parents=True)
        (here / "named.jsonl").write_text(_json.dumps(
            {"type": "custom-title", "customTitle": "bug-hunt",
             "sessionId": "named"}) + "\n")
        (here / "nameless.jsonl").write_text(_json.dumps(
            {"type": "user", "cwd": str(Path.cwd())}) + "\n")
        (here / "memory").mkdir()
        (here / "memory" / "a-note.md").write_text("---\ndescription: x\n---\n")

        self.saved = (f.repos, f.CLAUDE_PROJECTS)
        f.repos = lambda: {"work": {"path": str(self.store)}}
        f.CLAUDE_PROJECTS = self.projects

    def tearDown(self):
        f.repos, f.CLAUDE_PROJECTS = self.saved

    def complete(self, *words):
        sys.argv = ["ferry", "complete", *words]
        with quiet() as (out, _):
            f.main()
        return out.getvalue().split()

    def test_offers_the_commands(self):
        got = self.complete("ferry", "")
        for c in ("add", "save", "load", "list", "update", "sessions",
                  "memory", "stores"):
            self.assertIn(c, got)

    def test_filters_commands_by_prefix(self):
        self.assertEqual(self.complete("ferry", "lo"), ["load"])

    def test_offers_flags_for_the_command(self):
        got = self.complete("ferry", "save", "x", "-")
        self.assertIn("--memory", got)
        self.assertIn("--allow-plaintext", got)

    def test_does_not_offer_another_commands_flags(self):
        self.assertNotIn("--allow-plaintext", self.complete("ferry", "load", "-"))

    def complete_line(self, line):
        sys.argv = ["ferry", "complete", "--line", line]
        with quiet() as (out, _):
            f.main()
        return out.getvalue().split()

    def test_line_mode_keeps_a_colon_ref_whole(self):
        """bash splits on ':', so the line is parsed here instead."""
        self.assertEqual(self.complete_line("ferry lo"), ["load"])

    def test_line_mode_knows_a_trailing_space_starts_a_new_word(self):
        self.assertEqual(self.complete_line("ferry lo "), [])

    def test_line_mode_survives_an_unbalanced_quote(self):
        self.complete_line("ferry save \"unclosed")

    def test_save_offers_this_directorys_sessions_first(self):
        """The first word of `save` is a conversation here, not a store ref -
        it was offering stores, which are what the *second* word takes."""
        old = f.names_here
        f.names_here = lambda where: {"bug-hunt": None, "cto": None}
        try:
            self.assertEqual(self.complete_line("ferry save "),
                             ["bug-hunt", "cto"])
            self.assertEqual(self.complete_line("ferry save c"), ["cto"])
        finally:
            f.names_here = old

    def test_save_offers_the_connector_and_store_after_that(self):
        got = self.complete_line("ferry save bug-hunt ")
        self.assertIn("to", got)

    def test_save_memory_has_no_session_argument(self):
        """--memory takes no session, so the first word is already the
        destination."""
        old = f.names_here
        f.names_here = lambda where: {"bug-hunt": None}
        try:
            self.assertNotIn("bug-hunt", self.complete_line("ferry save --memory "))
            self.assertIn("to", self.complete_line("ferry save --memory "))
        finally:
            f.names_here = old

    def test_a_short_flag_never_means_two_things(self):
        """-m is --memory in four commands. A fifth where it meant --media
        would be worse than having no short form there at all."""
        import collections
        pairs = re.findall(r'add_argument\("(-[a-zA-Z])", "(--[a-z-]+)"',
                           FERRY.read_text())
        self.assertTrue(pairs, "no short flags found - did the syntax change?")
        by_letter = collections.defaultdict(set)
        for short, long in pairs:
            by_letter[short].add(long)
        clashes = {k: sorted(v) for k, v in by_letter.items() if len(v) > 1}
        self.assertEqual(clashes, {})

    def test_the_top_level_flags_are_offered(self):
        self.assertEqual(self.complete_line("ferry --vers"), ["--version"])
        self.assertEqual(self.complete_line("ferry -"), ["--help", "--version"])

    def test_a_flag_is_not_mistaken_for_a_command(self):
        """`ferry -<TAB>` wants flags; `ferry <TAB>` wants commands."""
        self.assertNotIn("save", self.complete_line("ferry -"))
        self.assertNotIn("--help", self.complete_line("ferry "))

    def status_of(self, line):
        """What `ferry complete` answers with, as its exit code."""
        sys.argv = ["ferry", "complete", "--line", line]
        with quiet():
            try:
                f.main()
            except SystemExit as e:
                return e.code or 0
        return 0

    def test_a_path_position_asks_the_shell_for_files(self):
        """--key and --path take a path on this machine. ferry cannot know it,
        but it can say that a filename is what belongs there."""
        for line in ("ferry add x --key ", "ferry add x --path ",
                     "ferry add x --key ~/half"):
            with self.subTest(line=line):
                self.assertEqual(self.status_of(line), f.FILES)

    def test_a_name_you_invent_gets_nothing_at_all(self):
        """--name is a name you are about to make up: no candidate, and no
        filename either."""
        for line in ("ferry load --name ", "ferry load --name half-typed"):
            with self.subTest(line=line):
                self.assertEqual(self.status_of(line), f.NOTHING)

    def test_a_command_taking_no_arguments_says_so(self):
        """`ferry stores <TAB>` offering filenames is noise - nothing goes
        there, which is a different answer from having no suggestion."""
        for line in ("ferry stores ",):
            with self.subTest(line=line):
                self.assertEqual(self.status_of(line), f.NOTHING)

    def test_an_ordinary_position_answers_normally(self):
        for line in ("ferry load ", "ferry ", "ferry save "):
            with self.subTest(line=line):
                self.assertEqual(self.status_of(line), 0)

    def test_completion_resumes_after_the_value(self):
        got = self.complete_line("ferry load --name x ")
        self.assertEqual(got, ["work:"])

    def test_sessions_completes_directories(self):
        """The argument is a directory, so the ones holding sessions are the
        useful answers - offered without a colon, since this is not a ref.

        The status is checked first: with no sessions at all, which is the case
        on CI, this position exits FILES rather than returning an empty list,
        and complete_line would raise rather than hand back nothing.
        """
        got = self.complete_line("ferry sessions ")
        self.assertEqual(got, [f.tilde(str(Path.cwd()))])
        self.assertTrue(all(not c.endswith(":") for c in got))

    def test_a_short_flag_reaches_completion_too(self):
        """`-m` and `--memory` are the same flag, and completion only knew the
        long one - so `ferry load -m store:` completed as though it had not
        been given at all."""
        for short, long in (("ferry load -m work:", "ferry load --memory work:"),
                            ("ferry export -a work:", "ferry export --all work:")):
            with self.subTest(line=short):
                self.assertEqual(self.complete_line(short),
                                 self.complete_line(long))

    def test_bunched_short_flags_count(self):
        """-ag is both of them, which a plain `in words` cannot see."""
        self.assertTrue(f.given(["ferry", "sessions", "-ag"], "--all", "-a"))
        self.assertTrue(f.given(["ferry", "sessions", "-ag"], "--global", "-g"))
        self.assertFalse(f.given(["ferry", "sessions", "-g"], "--all", "-a"))
        self.assertFalse(f.given(["ferry", "sessions"], "--all", "-a"))

    def test_a_long_flag_is_not_read_as_a_bunch(self):
        """--global contains an 'a', and must not therefore count as --all."""
        self.assertFalse(f.given(["ferry", "sessions", "--global"], "--all", "-a"))

    def test_memory_completes_directories_that_remember_something(self):
        """Not the same set as the ones holding sessions."""
        self.assertEqual(self.complete_line("ferry memory "),
                         [f.tilde(str(Path.cwd()))])

    def test_export_memory_offers_stores_as_well(self):
        """`export -m` reads from either side, like `export` itself - and a
        store is offered a level at a time, as everywhere else."""
        got = self.complete_line("ferry export -m ")
        self.assertIn("work:", got)                      # the store
        self.assertIn(f.tilde(str(Path.cwd())) + ":", got)   # and this directory
        self.assertEqual(self.complete_line("ferry export -m work:"),
                         ["work:acme/"])                 # then its memory

    def test_a_memory_ref_can_name_one_note(self):
        """The same shape a session ref has, with a note where the name goes."""
        got = self.complete_line("ferry export -m work:acme/")
        self.assertEqual(got, ["work:acme/note"])       # without the .md

    def test_a_memory_folder_carries_on_rather_than_ending(self):
        """It is both an answer and a step: a folder means all of its notes,
        and one more character reaches any one of them. So it must not get a
        space, which would strand you at the folder."""
        self.assertEqual(self.complete_line("ferry export -m work:"),
                         ["work:acme/"])
        here = f.tilde(str(Path.cwd()))
        self.assertIn(here + ":", self.complete_line("ferry export -m "))

    def test_a_local_memory_ref_names_a_note_after_the_colon(self):
        here = f.tilde(str(Path.cwd()))
        self.assertEqual(self.complete_line(f"ferry export -m {here}:"),
                         [f"{here}:a-note"])

    def test_export_memory_never_offers_a_session(self):
        self.assertNotIn("bug-hunt", self.complete_line("ferry export -m "))

    def test_move_completes(self):
        self.assertEqual(self.complete_line("ferry mo"), ["move"])
        self.assertIn("--memory", self.complete_line("ferry move -"))

    def test_move_source_follows_the_memory_flag(self):
        """Like load: --memory offers folders holding memory, plain offers
        sessions. The destination is a folder either way."""
        plain = self.complete_line("ferry move work:")
        mem = self.complete_line("ferry move --memory work:")
        self.assertNotEqual(plain, mem)
        self.assertIn("work:acme", mem)

    def test_memory_flag_completes(self):
        self.assertEqual(self.complete_line("ferry load --mem"), ["--memory"])

    def test_load_and_load_memory_are_mirror_images(self):
        """Neither should offer what the other takes."""
        plain = self.complete_line("ferry load work:")
        mem = self.complete_line("ferry load --memory work:")
        self.assertTrue(plain and mem)
        self.assertFalse([c for c in plain if c.endswith("/memory")],
                         "plain load offered a memory directory")
        self.assertFalse([c for c in mem if c.endswith("/memory")],
                         "--memory offered the memory/ instead of its parent")

    def test_complete_is_hidden_from_help(self):
        self.assertNotIn("complete", f.USAGE)


class CommandLine(unittest.TestCase):
    """Argument parsing, stubbing the commands so nothing touches the disk."""

    def setUp(self):
        self.calls = []
        self.originals = {}
        for name in ("cmd_add", "cmd_stores", "cmd_sessions", "cmd_memory",
                     "cmd_save", "cmd_load", "cmd_move", "cmd_list",
                     "cmd_update", "cmd_export"):
            self.originals[name] = getattr(f, name)
            setattr(f, name, lambda args, n=name: self.calls.append((n, args)))

    def tearDown(self):
        for name, fn in self.originals.items():
            setattr(f, name, fn)

    def run_ferry(self, *argv):
        sys.argv = ["ferry", *argv]
        with quiet() as (out, err):
            f.main()
        return out.getvalue(), err.getvalue()

    def test_the_shorts_actually_parse(self):
        for argv, attr in ((["sessions", "-g"], "global_"),
                           (["sessions", "-a"], "all"),
                           (["save", "-m", "to", "work:x"], "memory"),
                           (["load", "-f", "work:x/y"], "force"),
                           (["export", "-t", "x"], "tools"),
                           (["export", "-r", "x"], "raw")):
            with self.subTest(argv=argv):
                self.run_ferry(*argv)
                self.assertTrue(getattr(self.calls[-1][1], attr))

    def test_bare_ferry_prints_help(self):
        out, _ = self.run_ferry()
        self.assertIn("usage:", out)
        self.assertIn("ferry save", out)
        self.assertEqual(self.calls, [])

    def test_save_drops_the_word_to(self):
        self.run_ferry("save", "bug-hunt", "to", "work:acme")
        name, args = self.calls[0]
        self.assertEqual(name, "cmd_save")
        self.assertEqual(args.words, ["bug-hunt", "to", "work:acme"])
        self.assertFalse(args.memory)

    def test_save_works_without_to(self):
        self.run_ferry("save", "bug-hunt", "work:acme")
        self.assertEqual(self.calls[0][1].words, ["bug-hunt", "work:acme"])

    def test_save_memory_is_a_flag(self):
        self.run_ferry("save", "--memory", "to", "work:acme")
        self.assertTrue(self.calls[0][1].memory)

    def test_load_memory_is_a_flag(self):
        self.run_ferry("load", "--memory", "work:acme")
        name, args = self.calls[0]
        self.assertEqual(name, "cmd_load")
        self.assertTrue(args.memory)

    def test_load_drops_the_word_to(self):
        self.run_ferry("load", "work:acme/bug-hunt")
        self.assertEqual(self.calls[0][1].target, "work:acme/bug-hunt")

    def test_move_takes_two_refs(self):
        self.run_ferry("move", "work:acme/bug-hunt", "work:beta")
        name, args = self.calls[0]
        self.assertEqual(name, "cmd_move")
        self.assertEqual(args.source, "work:acme/bug-hunt")
        self.assertEqual(args.dest, "work:beta")
        self.assertFalse(args.memory)

    def test_move_memory_is_a_flag(self):
        """`acme/memory` could be either a session or a memory folder, so the
        flag decides here exactly as it does for save and load."""
        self.run_ferry("move", "--memory", "work:acme", "work:beta")
        self.assertTrue(self.calls[0][1].memory)

    def test_move_needs_both_ends(self):
        with quiet(), self.assertRaises(SystemExit):
            self.run_ferry("move", "work:acme/memory")

    def test_sessions_takes_a_directory(self):
        self.run_ferry("sessions", "/somewhere")
        name, args = self.calls[0]
        self.assertEqual(name, "cmd_sessions")
        self.assertEqual(args.where, "/somewhere")
        self.assertFalse(args.all)      # a directory says where, not what

    def test_sessions_without_one_is_here(self):
        self.run_ferry("sessions")
        self.assertIsNone(self.calls[0][1].where)

    def test_list_memory_is_a_flag(self):
        self.run_ferry("list", "--memory", "work:acme")
        name, args = self.calls[0]
        self.assertEqual(name, "cmd_list")
        self.assertTrue(args.memory)
        self.assertEqual(args.ref, "work:acme")

    def test_list_memory_needs_no_ref(self):
        self.run_ferry("list", "--memory")
        self.assertTrue(self.calls[0][1].memory)
        self.assertIsNone(self.calls[0][1].ref)

    def test_bare_list_is_the_same_as_stores(self):
        self.run_ferry("list")
        self.assertEqual(self.calls[0][0], "cmd_list")
        self.assertIsNone(self.calls[0][1].ref)

    def test_unknown_command_exits(self):
        with quiet(), self.assertRaises(SystemExit):
            sys.argv = ["ferry", "frobnicate"]
            f.main()

    def test_version_exits_cleanly(self):
        with quiet() as (out, _), self.assertRaises(SystemExit) as e:
            sys.argv = ["ferry", "--version"]
            f.main()
        self.assertEqual(e.exception.code, 0)

    def test_every_command_in_the_usage_block_is_real(self):
        """The synopsis is documentation; it should not drift from the parser."""
        commands = {line.split()[1] for line in f.USAGE.splitlines()
                    if line.strip().startswith("ferry ")}
        for c in commands:
            with self.subTest(command=c):
                with quiet(), self.assertRaises(SystemExit) as e:
                    sys.argv = ["ferry", c, "--help"]
                    f.main()
                self.assertEqual(e.exception.code, 0)


