                         ["ferry", "add", "n"])

    def test_nothing_at_all_is_nothing(self):
        self.assertEqual(f.positionals([]), [])


class FastPaths(unittest.TestCase):
    """The short-circuits the listing uses, and the rule they must obey: never
    a different answer from reading both copies in full.

    They exist because the listing compares every session against its stored
    copy, and parsing both took `sessions --global` from 0.35s to 3.8s. Bytes
    settle it in almost every case: identical files are identical records, and
    an appended-to file still opens with every byte the other has.
    """

    def pair(self, a, b):
        return tmpfile(a), tmpfile(b)

    def agrees(self, ours, theirs, expect):
        """Whatever the fast path says, the full comparison must say too."""
        slow = f.STATES[f.relation(f.line_set(ours), f.line_set(theirs))]
        self.assertEqual(slow, expect)

    def test_identical_files_are_the_same(self):
        a, b = self.pair('{"uuid":"1"}\n', '{"uuid":"1"}\n')
        self.assertTrue(f.same_bytes(a, b))
        self.agrees(a, b, "in sync")

    def test_a_different_size_is_not(self):
        a, b = self.pair('{"uuid":"1"}\n{"uuid":"2"}\n', '{"uuid":"1"}\n')
        self.assertFalse(f.same_bytes(a, b))

    def test_the_same_size_but_different_bytes_is_not(self):
        a, b = self.pair('{"uuid":"1"}\n', '{"uuid":"2"}\n')
        self.assertFalse(f.same_bytes(a, b))

    def test_an_appended_file_starts_with_the_other(self):
        a, b = self.pair('{"uuid":"1"}\n{"uuid":"2"}\n', '{"uuid":"1"}\n')
        self.assertTrue(f.starts_with(a, b))
        self.agrees(a, b, "ahead")

    def test_it_is_not_symmetric(self):
        a, b = self.pair('{"uuid":"1"}\n{"uuid":"2"}\n', '{"uuid":"1"}\n')
        self.assertFalse(f.starts_with(b, a))

    def test_equal_files_do_not_start_with_each_other(self):
        """Only ever a strict opening, so SAME is never reported as AHEAD."""
        a, b = self.pair('{"uuid":"1"}\n', '{"uuid":"1"}\n')
        self.assertFalse(f.starts_with(a, b))

    def test_a_diverged_file_does_not(self):
        a, b = self.pair('{"uuid":"1"}\n{"uuid":"2"}\n',
                         '{"uuid":"1"}\n{"uuid":"3"}\n')
        self.assertFalse(f.starts_with(a, b))
        self.assertFalse(f.starts_with(b, a))
        self.agrees(a, b, "forked")

    def test_a_truncated_last_line_is_not_an_opening(self):
        """The shorter file ends mid-record, so its last line is a fragment the
        longer one continues rather than repeats - and a fragment is not a
        record either copy holds. Taking it for an opening would report ahead
        while the store held a line this copy does not."""
        a = tmpfile('{"uuid":"1"}\n{"uuid":"22"}\n')
        b = tmpfile('{"uuid":"1"}\n{"uuid":"2')
        self.assertFalse(f.starts_with(a, b))
        self.assertEqual(f.relation(f.line_set(a), f.line_set(b)), f.FORKED)

    def test_an_empty_file_is_not_an_opening_either(self):
        a, b = self.pair('{"uuid":"1"}\n', "")
        self.assertFalse(f.starts_with(a, b))

    def test_a_missing_file_is_not_an_error(self):
        a = tmpfile('{"uuid":"1"}\n')
        gone = Path("/nonexistent/x.jsonl")
        self.assertFalse(f.same_bytes(a, gone))
        self.assertFalse(f.starts_with(a, gone))
        self.assertFalse(f.starts_with(gone, a))


