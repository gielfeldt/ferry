class Relation(unittest.TestCase):
    """Which way a sync goes, and when it may not go at all.

    This replaces the old size comparison outright. Comparing bytes said a
    longer file was the newer one, which is true right up until two machines
    both append - and then it silently wrote one over the other. Content
    cannot say that: a copy is only ever replaced by one that holds everything
    it already held.
    """

    def test_the_same_records_are_the_same(self):
        self.assertEqual(f.relation({1, 2}, {2, 1}), f.SAME)

    def test_holding_everything_theirs_and_more_is_ahead(self):
        self.assertEqual(f.relation({1, 2, 3}, {1, 2}), f.AHEAD)

    def test_holding_less_is_behind(self):
        self.assertEqual(f.relation({1}, {1, 2}), f.BEHIND)

    def test_each_holding_what_the_other_does_not_is_forked(self):
        self.assertEqual(f.relation({1, 2}, {1, 3}), f.FORKED)

    def test_two_empties_are_the_same(self):
        self.assertEqual(f.relation(set(), set()), f.SAME)

    def test_empty_against_anything_is_behind(self):
        self.assertEqual(f.relation(set(), {1}), f.BEHIND)

    def test_a_bigger_fork_is_still_a_fork(self):
        """Size is not the question - this is what the old check got wrong."""
        self.assertEqual(f.relation(set(range(100)) | {"a"},
                                    {1, 2, "b"}), f.FORKED)


class LineSet(unittest.TestCase):
    """A transcript as what it holds, rather than as bytes."""

    def test_key_order_is_not_a_difference(self):
        """Two copies of one custom-title record, same fields and values,
        written with their keys in a different order. Byte comparison calls
        that a fork; two real sessions on this machine are exactly it."""
        a = tmpfile('{"type":"custom-title","sessionId":"s","customTitle":"x"}\n')
        b = tmpfile('{"type":"custom-title","customTitle":"x","sessionId":"s"}\n')
        self.assertEqual(f.line_set(a), f.line_set(b))
        self.assertEqual(f.relation(f.line_set(a), f.line_set(b)), f.SAME)

    def test_a_repeated_record_counts_once(self):
        """mode and custom-title are written again and again through a session,
        so a copy holding five of one line knows no more than one holding
        three."""
        a = tmpfile('{"type":"mode","mode":"normal"}\n' * 5)
        b = tmpfile('{"type":"mode","mode":"normal"}\n' * 3)
        self.assertEqual(f.relation(f.line_set(a), f.line_set(b)), f.SAME)

    def test_an_extra_turn_is_a_difference(self):
        a = tmpfile('{"uuid":"1","type":"user"}\n{"uuid":"2","type":"user"}\n')
        b = tmpfile('{"uuid":"1","type":"user"}\n')
        self.assertEqual(f.relation(f.line_set(a), f.line_set(b)), f.AHEAD)

    def test_a_rename_is_a_difference_too(self):
        """Renaming appends a record carrying no uuid. Comparing only the
        conversation would call this in sync and never carry the name over."""
        a = tmpfile('{"uuid":"1","type":"user"}\n'
                    '{"type":"custom-title","customTitle":"named"}\n')
        b = tmpfile('{"uuid":"1","type":"user"}\n')
        self.assertEqual(f.relation(f.line_set(a), f.line_set(b)), f.AHEAD)

    def test_both_appending_is_a_fork(self):
        a = tmpfile('{"uuid":"1"}\n{"uuid":"2"}\n')
        b = tmpfile('{"uuid":"1"}\n{"uuid":"3"}\n')
        self.assertEqual(f.relation(f.line_set(a), f.line_set(b)), f.FORKED)

    def test_blank_lines_are_not_records(self):
        a = tmpfile('{"uuid":"1"}\n\n\n')
        b = tmpfile('{"uuid":"1"}\n')
        self.assertEqual(f.relation(f.line_set(a), f.line_set(b)), f.SAME)

    def test_an_unparseable_line_is_kept_as_it_stands(self):
        """It cannot be normalised, but it still has to count as content."""
        a = tmpfile('{"uuid":"1"}\nnot json at all\n')
        b = tmpfile('{"uuid":"1"}\n')
        self.assertEqual(f.relation(f.line_set(a), f.line_set(b)), f.AHEAD)

    def test_a_missing_file_holds_nothing(self):
        self.assertEqual(f.line_set(Path("/nonexistent/x.jsonl")), set())


class Positionals(unittest.TestCase):
    """Which argument you are typing, counted from the words before it.

    A flag's value used to count as an argument, so `ferry export --media
    /tmp/pics work:<TAB>` thought it was one ref further along than it was and
    offered nothing at all - on a command line that is otherwise perfectly
    good.
    """

    def test_a_bare_flag_is_not_an_argument(self):
        self.assertEqual(f.positionals(["ferry", "sync", "-m"]),
                         ["ferry", "sync"])

    def test_a_flags_value_is_not_one_either(self):
        self.assertEqual(f.positionals(["ferry", "export", "--media", "/tmp/x"]),
                         ["ferry", "export"])

    def test_the_short_spelling_too(self):
        for flag in ("-k", "--key", "-p", "--path"):
            with self.subTest(flag=flag):
                self.assertEqual(f.positionals(["ferry", "add", "n", flag, "/f"]),
                                 ["ferry", "add", "n"])

    def test_a_flag_taking_no_value_does_not_eat_the_next_word(self):
        """--memory is a switch, so what follows it is the argument."""
