    def test_an_unnamed_session_shows_what_claude_called_it(self):
        got = self.listing(True)
        self.assertIn("titled", got)            # the id, which is what to type
        self.assertIn("Fix the build", got)     # and what it was about

    def test_the_asterisk_is_explained_when_it_appears(self):
        self.assertIn("not a name", self.listing(True))

    def test_a_named_session_gets_no_hint(self):
        got = self.listing(True)
        line = [l for l in got.splitlines() if "bug-hunt" in l][0]
        self.assertNotIn("*", line)

    def test_named_only_says_nothing_about_asterisks(self):
        got = self.listing(False)
        self.assertIn("bug-hunt", got)
        self.assertNotIn("not a name", got)
        self.assertNotIn("Fix the build", got)


class SessionDirs(unittest.TestCase):
    """`ferry export <TAB>` offers the directories that have sessions, so the
    <dir>:<name> form is discoverable rather than something you must know."""

    def setUp(self):
        import json as _json
        self.projects = Path(tempfile.mkdtemp())
        self.old, f.CLAUDE_PROJECTS = f.CLAUDE_PROJECTS, self.projects
        self.live = Path(tempfile.mkdtemp()).resolve()
        for where in (self.live, self.live / "vanished"):
            d = self.projects / f.slug_dir(where).name
            d.mkdir(parents=True)
            (d / "a.jsonl").write_text("".join(_json.dumps(r) + "\n" for r in (
                {"type": "custom-title", "customTitle": "named", "sessionId": "a"},
                {"type": "user", "cwd": str(where)})))
        # the second directory was deleted after its sessions were recorded

    def tearDown(self):
        f.CLAUDE_PROJECTS = self.old

    def test_a_directory_that_still_exists_is_offered(self):
        self.assertIn(str(self.live), f.session_dirs())

    def test_a_directory_with_no_named_session_is_not_offered(self):
        """Completing into it would land you somewhere with nothing behind
        it - the whole point of the ref is a name to match."""
        import json as _json
        bare = Path(tempfile.mkdtemp()).resolve()
        d = self.projects / f.slug_dir(bare).name
        d.mkdir(parents=True)
        (d / "u.jsonl").write_text(_json.dumps(
            {"type": "user", "cwd": str(bare)}) + "\n")
        self.assertNotIn(str(bare), f.session_dirs())
        self.assertIn(str(bare), f.session_dirs(everything=True))

    def test_all_offers_the_id_as_the_handle(self):
        """An unnamed session has no name to type, so its id stands in."""
        import json as _json
        bare = Path(tempfile.mkdtemp()).resolve()
        d = self.projects / f.slug_dir(bare).name
        d.mkdir(parents=True)
        (d / "deadbeef.jsonl").write_text(_json.dumps(
            {"type": "user", "cwd": str(bare)}) + "\n")
        self.assertEqual(f.refs_in(d), set())
        self.assertEqual(f.refs_in(d, everything=True), {"deadbeef"})

    def test_one_that_is_gone_is_not(self):
        """It could only be offered so that <dir>:<name> could refuse it."""
        self.assertNotIn(str(self.live / "vanished"), f.session_dirs())

    def test_the_colon_comes_with_it(self):
        """As it does for a store: what follows is a session, and the colon is
        what says so."""
        self.assertTrue(all(r.endswith(":") for r in f.dir_refs()))

    def test_home_is_shortened(self):
        self.assertEqual(f.tilde(str(Path.home() / "x")), "~/x")


class RegistryWrites(unittest.TestCase):
    """The list of stores is a file three commands read, change and write
    back."""

    def setUp(self):
        self.config = Path(tempfile.mkdtemp())
        self.saved = (f.CONFIG, f.CONFIG_FILE)
        f.CONFIG, f.CONFIG_FILE = self.config, self.config / "repos.json"

    def tearDown(self):
        f.CONFIG, f.CONFIG_FILE = self.saved

    def test_a_write_leaves_no_half_file(self):
        """It is written beside and renamed in, so the file is the old one or
        the new one - never part of both."""
        f.save_repos({"a": {"path": "/x"}})
        self.assertEqual(f.repos()["a"]["path"], "/x")
        self.assertEqual([p.name for p in self.config.iterdir()
                          if p.name.startswith("repos.json.")], [])

    def test_the_lock_writes_what_the_block_changed(self):
        with f.registry() as d:
            d["b"] = {"path": "/y"}
        self.assertIn("b", f.repos())

    def test_dying_inside_the_block_writes_nothing(self):
        """`remove` refuses from inside the lock, and a refusal must not be a
        change."""
        f.save_repos({"keep": {"path": "/x"}})
        with quiet(), self.assertRaises(SystemExit):
            with f.registry() as d:
                d["gone"] = {"path": "/y"}
                f.die("changed my mind")
        self.assertEqual(sorted(f.repos()), ["keep"])

    def test_a_second_holder_waits_and_then_says_so(self):
        """Rather than hanging, or failing the instant it is contended."""
        import threading
        started, release = threading.Event(), threading.Event()

        def hold():
            with f.registry():
                started.set()
                release.wait(5)

        t = threading.Thread(target=hold, daemon=True)
        t.start()
        started.wait(5)
        try:
            with quiet() as (_, err), self.assertRaises(SystemExit):
                with f.registry(wait=0.2):
                    pass
            self.assertIn("another ferry", err.getvalue())
        finally:
            release.set()
            t.join(5)


class ReplaceDir(unittest.TestCase):
    """Memory is written by replacing a whole directory."""

    def test_the_destination_ends_up_holding_the_source(self):
        root = Path(tempfile.mkdtemp())
        src, dest = root / "src", root / "dest"
        src.mkdir(); dest.mkdir()
        (src / "new.md").write_text("new")
        (dest / "old.md").write_text("old")
        f.replace_dir(src, dest)
        self.assertEqual([p.name for p in dest.iterdir()], ["new.md"])

    def test_it_cleans_up_after_itself(self):
        """The copy and the displaced original are both temporary."""
        root = Path(tempfile.mkdtemp())
        src, dest = root / "src", root / "dest"
        src.mkdir(); (src / "a.md").write_text("a")
        f.replace_dir(src, dest)
        self.assertEqual(sorted(p.name for p in root.iterdir()),
                         ["dest", "src"])


class StoreRegistry(unittest.TestCase):
    """Adding, renaming and forgetting a store. The registry is a file of
    names; what they point at is not ferry's to delete."""

    def setUp(self):
        self.home = Path(tempfile.mkdtemp())
        self.d = {}
        self.saved = (f.repos, f.save_repos, f.Path.home)
        f.repos = lambda: dict(self.d)
        f.save_repos = lambda d: self.d.clear() or self.d.update(d)

    def tearDown(self):
        f.repos, f.save_repos, f.Path.home = self.saved

    def args(self, **kw):
        return type("A", (), kw)()

    def test_rename_moves_a_checkout_ferry_made(self):
        """So the directory goes on matching the name."""
        own = self.home / ".local/share/ferry"
        (own / "old").mkdir(parents=True)
        f.own_clone = lambda a: own / a
        self.d["old"] = {"path": str(own / "old"), "url": "", "added": ""}
        with quiet():
            f.cmd_rename(self.args(name="old", new="new"))
        self.assertIn("new", self.d)
        self.assertNotIn("old", self.d)
        self.assertTrue((own / "new").is_dir())
        self.assertFalse((own / "old").exists())

    def test_rename_leaves_a_checkout_you_adopted(self):
        """It was yours before ferry knew about it."""
        mine = self.home / "somewhere"
        mine.mkdir()
        f.own_clone = lambda a: self.home / ".local/share/ferry" / a
        self.d["old"] = {"path": str(mine), "url": "", "added": ""}
        with quiet():
            f.cmd_rename(self.args(name="old", new="new"))
        self.assertEqual(self.d["new"]["path"], str(mine))
        self.assertTrue(mine.is_dir())

    def test_rename_onto_a_taken_name_is_refused(self):
        self.d = {"a": {"path": "/x", "url": "", "added": ""},
                  "b": {"path": "/y", "url": "", "added": ""}}
        with quiet(), self.assertRaises(SystemExit):
            f.cmd_rename(self.args(name="a", new="b"))

    def repo_with(self, *commits, remote=True, dirty=False):
        """A real little repo, since this is about git state."""
        root = Path(tempfile.mkdtemp())
        origin, work = root / "origin", root / "work"
        if remote:
            subprocess.run(["git", "init", "-q", "--bare", str(origin)],
                           check=True)
            subprocess.run(["git", "clone", "-q", str(origin), str(work)],
                           check=True, capture_output=True)
        else:
            subprocess.run(["git", "init", "-q", str(work)], check=True)
        for k, v in (("user.email", "t@e"), ("user.name", "t")):
            subprocess.run(["git", "-C", str(work), "config", k, v], check=True)
        for i, pushed in enumerate(commits):
            subprocess.run(["git", "-C", str(work), "commit", "-q",
                            "--allow-empty", "-m", f"c{i}"], check=True)
            if pushed and remote:
                subprocess.run(["git", "-C", str(work), "push", "-q", "origin",
                                "HEAD"], check=True, capture_output=True)
        if dirty:
            (work / "scratch").write_text("x")
        return work

    def test_a_store_in_step_with_its_remote_is_forgotten(self):
        work = self.repo_with(True)
        self.d["s"] = {"path": str(work), "url": "", "added": ""}
        with quiet():
            f.cmd_remove(self.args(name="s", force=False))
        self.assertNotIn("s", self.d)

    def test_work_the_remote_has_not_got_stops_it(self):
        """Forgetting leaves the directory, so nothing is deleted - but a save
        that never reached the remote becomes a path you have to remember."""
        work = self.repo_with(True, False)          # one pushed, one not
        self.d["s"] = {"path": str(work), "url": "", "added": ""}
        with quiet() as (_, err), self.assertRaises(SystemExit):
            f.cmd_remove(self.args(name="s", force=False))
        self.assertIn("not on the remote", err.getvalue())
        self.assertIn("s", self.d)                  # still registered

    def test_no_remote_at_all_stops_it_too(self):
        work = self.repo_with(True, remote=False)
        self.d["s"] = {"path": str(work), "url": "", "added": ""}
        with quiet() as (_, err), self.assertRaises(SystemExit):
            f.cmd_remove(self.args(name="s", force=False))
        self.assertIn("only copy", err.getvalue())

    def test_uncommitted_changes_stop_it(self):
        work = self.repo_with(True, dirty=True)
        self.d["s"] = {"path": str(work), "url": "", "added": ""}
        with quiet() as (_, err), self.assertRaises(SystemExit):
            f.cmd_remove(self.args(name="s", force=False))
        self.assertIn("uncommitted", err.getvalue())

    def test_force_forgets_it_anyway(self):
        work = self.repo_with(True, False)
        self.d["s"] = {"path": str(work), "url": "", "added": ""}
        with quiet():
            f.cmd_remove(self.args(name="s", force=True))
        self.assertNotIn("s", self.d)

    def test_remove_forgets_without_deleting(self):
        keep = self.repo_with(True)
        self.d["gone"] = {"path": str(keep), "url": "", "added": ""}
        with quiet() as (out, _):
            f.cmd_remove(self.args(name="gone", force=False))
        self.assertNotIn("gone", self.d)
        self.assertTrue(keep.is_dir())          # the checkout is not ferry's
        self.assertIn(str(keep), out.getvalue())  # and it says where

    def test_removing_something_unknown_says_what_there_is(self):
        self.d["real"] = {"path": "/x", "url": "", "added": ""}
        with quiet() as (_, err), self.assertRaises(SystemExit):
            f.cmd_remove(self.args(name="imaginary", force=False))
        self.assertIn("real", err.getvalue())


class MemoryRef(unittest.TestCase):
    """A memory ref names a directory, and may name one note in it."""

    def setUp(self):
        self.store = Path(tempfile.mkdtemp())
        mem = self.store / "memories" / "acme"
        mem.mkdir(parents=True)
        (mem / "role.md").write_text("---\ndescription: who\n---\n\nbody\n")
        (mem / "MEMORY.md").write_text("- [Role](role.md) - who\n")
        self.saved = f.repos
        f.repos = lambda: {"work": {"path": str(self.store)}}

    def tearDown(self):
        f.repos = self.saved

    def test_a_store_folder_is_all_of_its_notes(self):
        mem, note = f.memory_source("work:acme")
        self.assertEqual(mem, self.store / "memories" / "acme")
        self.assertIsNone(note)

    def test_a_note_can_be_named_after_the_folder(self):
        mem, note = f.memory_source("work:acme/role")
        self.assertEqual(note.name, "role.md")

    def test_the_extension_is_optional(self):
        self.assertEqual(f.memory_source("work:acme/role.md")[1].name, "role.md")

    def test_a_note_that_is_not_there_says_so(self):
        with quiet(), self.assertRaises(SystemExit):
            f.memory_source("work:acme/nope")

    def test_one_note_renders_alone(self):
        mem, note = f.memory_source("work:acme/role")
        buf = io.StringIO()
        f.render_memory(mem, out=buf, note=note)
        got = buf.getvalue()
        self.assertIn("# role.md", got)
        self.assertIn("body", got)
        self.assertNotIn("MEMORY.md", got)   # just the one asked for
        self.assertNotIn("description:", got)  # frontmatter became the heading


class ExportRef(unittest.TestCase):
    """Three ways to name a session, and one rule for telling them apart."""

    def setUp(self):
        import json as _json
        self.projects = Path(tempfile.mkdtemp())
        self.old_projects, f.CLAUDE_PROJECTS = f.CLAUDE_PROJECTS, self.projects
        self.old_repos = f.repos
        self.work = Path(tempfile.mkdtemp()).resolve()
        d = self.projects / f.slug_dir(self.work).name
        d.mkdir(parents=True)
        (d / "abc.jsonl").write_text(_json.dumps(
            {"type": "custom-title", "customTitle": "bug-hunt",
             "sessionId": "abc"}) + "\n")
        self.store = Path(tempfile.mkdtemp())
        (self.store / "sessions" / "acme").mkdir(parents=True)
        (self.store / "sessions" / "acme" / "bug-hunt.jsonl").write_text("{}\n")
        f.repos = lambda: {"work": {"path": str(self.store)}}

    def tearDown(self):
        f.CLAUDE_PROJECTS = self.old_projects
        f.repos = self.old_repos

    def test_a_bare_name_is_this_directory(self):
        cwd = os.getcwd()
        try:
            os.chdir(self.work)
            self.assertEqual(f.export_source("bug-hunt").name, "abc.jsonl")
        finally:
            os.chdir(cwd)

    def test_a_known_store_before_the_colon_is_a_store(self):
        got = f.export_source("work:acme/bug-hunt")
        self.assertEqual(got, self.store / "sessions/acme/bug-hunt.jsonl")

    def test_anything_else_before_the_colon_is_a_directory(self):
        got = f.export_source(f"{self.work}:bug-hunt")
        self.assertEqual(got.name, "abc.jsonl")

    def test_a_directory_ref_takes_an_id_too(self):
        self.assertEqual(f.export_source(f"{self.work}:abc").name, "abc.jsonl")

    def test_a_missing_directory_says_so_and_lists_the_stores(self):
        with quiet() as (_, err), self.assertRaises(SystemExit):
            f.export_source("/no/such/place:bug-hunt")
        self.assertIn("no such directory", err.getvalue())
        self.assertIn("work", err.getvalue())     # in case a store was meant

    def test_the_message_names_the_directory_searched(self):
        """Not "here" - the ref pointed somewhere else."""
        with quiet() as (_, err), self.assertRaises(SystemExit):
            f.export_source(f"{self.work}:nope")
        self.assertIn(str(self.work), err.getvalue())


class ClosedPipe(unittest.TestCase):
    """`ferry export … | head` closes stdout early. Python's own traceback for
    that says something went wrong, when nothing did - and piping into a pager
    is what export is for.

    This runs the real command through a real pipeline. An earlier version
    passed ferry a file path, which it does not take, so ferry exited before
    writing anything and the test passed either way.
    """

    def test_a_closed_pipe_is_not_an_error(self):
        import json as _json
        home = Path(tempfile.mkdtemp())
        work = Path(tempfile.mkdtemp())
        slug = re.sub(r"[^a-zA-Z0-9]", "-", os.path.realpath(work))
        d = home / ".claude" / "projects" / slug
        d.mkdir(parents=True)
        # Bigger than a pipe buffer, or the writes sit in the kernel and the
        # failure never happens.
        (d / "abc.jsonl").write_text("".join(_json.dumps(r) + "\n" for r in (
            {"type": "custom-title", "customTitle": "big", "sessionId": "abc"},
            *[{"type": "assistant", "timestamp": "2026-01-01T00:00:00Z",
               "message": {"role": "assistant", "content": [
                   {"type": "text", "text": f"line {i} " + "x" * 200}]}}
              for i in range(4000)])))

        r = subprocess.run(
            ["sh", "-c", f"{shlex.quote(sys.executable)} {shlex.quote(str(FERRY))}"
                         f" export big | head -2"],
            cwd=work, env=dict(os.environ, HOME=str(home)),
            capture_output=True, text=True)
        self.assertIn("# big", r.stdout)          # it really did run
        self.assertNotIn("Traceback", r.stderr)
        self.assertNotIn("BrokenPipeError", r.stderr)


class Layout(unittest.TestCase):
    """A store keeps sessions and memory in two trees. Nothing about that
    reaches the command line, so the mapping is the whole of it."""

    def test_a_session_ref_goes_under_sessions(self):
        self.assertEqual(f.in_store("acme/bug-hunt"), "sessions/acme/bug-hunt")

    def test_a_memory_ref_goes_under_memories(self):
        self.assertEqual(f.in_store("acme", memory=True), "memories/acme")

    def test_the_top_of_a_store_is_the_tree_itself(self):
        self.assertEqual(f.in_store(""), "sessions")
        self.assertEqual(f.in_store("", memory=True), "memories")

    def test_a_session_may_be_called_memory(self):
        """The thing that needed a flag before is now just a name."""
        self.assertEqual(f.in_store("acme/memory"), "sessions/acme/memory")
        self.assertNotEqual(f.in_store("acme/memory"),
                            f.in_store("acme", memory=True))

    def test_printing_strips_the_tree_again(self):
        for ref in ("acme/bug-hunt", "acme", "acme/memory", ""):
            for mem in (False, True):
                with self.subTest(ref=ref, memory=mem):
                    self.assertEqual(f.of_store(f.in_store(ref, mem)), ref)

    def test_a_folder_of_the_same_name_is_not_stripped_twice(self):
        self.assertEqual(f.of_store("sessions/sessions/x"), "sessions/x")


class WrittenDates(unittest.TestCase):
    """The date column, read from one pass of `git log --name-status` rather
    than a `git log --follow` per session - which is what made listing a store
    take seconds, one visible line at a time."""

    def log(self, *commits):
        """(date, [status lines]) newest first, as git prints it."""
        out = []
        for date, lines in commits:
            out.append("\0" + date)
            out.extend(lines)
        return "\n".join(out) + "\n"

    def test_the_newest_write_wins(self):
        got = f.written_dates(self.log(
            ("2026-08-16", ["M\tsessions/acme/bug-hunt.jsonl"]),
            ("2026-08-01", ["A\tsessions/acme/bug-hunt.jsonl"])))
        self.assertEqual(got["sessions/acme/bug-hunt.jsonl"], "2026-08-16")

    def test_a_rename_keeps_the_date_it_was_written(self):
        """Migrating a store must not restamp every session with today."""
        got = f.written_dates(self.log(
            ("2026-08-17", ["R100\tacme/bug-hunt.jsonl\t"
                            "sessions/acme/bug-hunt.jsonl"]),
            ("2026-08-16", ["M\tacme/bug-hunt.jsonl"])))
        self.assertEqual(got, {"sessions/acme/bug-hunt.jsonl": "2026-08-16"})

    def test_renames_chain(self):
        got = f.written_dates(self.log(
            ("2026-08-17", ["R100\tb.jsonl\tc.jsonl"]),
            ("2026-08-10", ["R100\ta.jsonl\tb.jsonl"]),
            ("2026-08-01", ["A\ta.jsonl"])))
        self.assertEqual(got, {"c.jsonl": "2026-08-01"})

    def test_several_files_in_one_commit(self):
        got = f.written_dates(self.log(
            ("2026-08-16", ["A\tone.jsonl", "A\ttwo.jsonl"])))
        self.assertEqual(got, {"one.jsonl": "2026-08-16",
                               "two.jsonl": "2026-08-16"})

    def test_an_empty_log_is_empty(self):
        self.assertEqual(f.written_dates(""), {})


class BashCompletion(unittest.TestCase):
    """The completion script itself, run by a real bash.

    Worth the subprocess: this is shell, so none of the Python tests can see
    it, and the one bug it had - every candidate arriving as a single word,
    which readline then pasted onto the command line - was invisible until you
    counted the array rather than printing it.
    """

    SCRIPT = FERRY.parent / "completions" / "ferry.bash"

    def bashes(self):
        """Every bash on the machine, not just the first on PATH.

        macOS keeps 3.2 at /bin/bash and a modern one in brew, and the two do
        not agree about quoting inside a parameter expansion - so testing only
        the one PATH happens to find is how a shell bug ships.
        """
        found, seen = [], set()
        for b in (shutil.which("bash"), "/bin/bash", "/usr/local/bin/bash",
                  "/opt/homebrew/bin/bash"):
            if b and os.access(b, os.X_OK):
                real = os.path.realpath(b)
                if real not in seen:
                    seen.add(real)
                    found.append(b)
        return found

    def complete(self, line, candidates, bash=None):
        """COMPREPLY after _ferry, with `ferry complete` stubbed out."""
        if not self.SCRIPT.exists():
            self.skipTest("no completion script")
        if bash is None:
            bashes = self.bashes()
            if not bashes:
                self.skipTest("no bash")
            bash = bashes[0]
        d = Path(tempfile.mkdtemp())
        stub = d / "ferry"
        stub.write_text("#!/bin/sh\nprintf '%s\\n' " +
                        " ".join(f"'{c}'" for c in candidates) + "\n")
        stub.chmod(0o755)
        env = dict(os.environ, PATH=f"{d}:{os.environ['PATH']}")
        r = subprocess.run(
            [bash, "--norc", "-c",
             f'. "{self.SCRIPT}"; COMP_LINE={shlex.quote(line)}; '
             f'COMP_POINT=${{#COMP_LINE}}; _ferry ferry "" ""; '
             f'printf "%s\\n" "${{#COMPREPLY[@]}}"; '
             f'printf "%s\\n" "${{COMPREPLY[@]}}"'],
            capture_output=True, text=True, env=env)
        out = r.stdout.splitlines()
        return int(out[0]), out[1:]

    def test_each_candidate_stays_its_own_word(self):
        """One word per candidate, or readline pastes the lot onto the line."""
        for b in self.bashes() or [None]:
            with self.subTest(bash=b):
                n, got = self.complete(
                    "ferry sync store:",
                    ["store:alpha/", "store:beta/", "store:gamma/"], b)
                self.assertEqual(n, 3)
                self.assertEqual(got, ["alpha/", "beta/", "gamma/"])

    def test_the_store_prefix_is_trimmed_off(self):
        """bash replaces only the text after the last colon, so only that part
        may be handed back."""
        _, got = self.complete("ferry sync store:be", ["store:acme/"])
        self.assertEqual(got, ["acme/"])          # a folder: no space

    def test_a_path_keeps_everything_after_the_colon(self):
        _, got = self.complete("ferry sync store:acme/b",
                               ["store:acme/bug-hunt"])
        self.assertEqual(got, ["acme/bug-hunt "])   # lone match, so a space

    def test_a_word_with_no_colon_is_left_alone(self):
        _, got = self.complete("ferry lis", ["list"])
        self.assertEqual(got, ["list "])            # lone match, so a space

    def test_a_finished_word_gets_its_space(self):
        """-o nospace is set for the whole command so a folder can be walked
        into, which otherwise leaves TAB redrawing a finished word forever."""
        _, got = self.complete("ferry sync store:acme/bug",
                               ["store:acme/bug-hunt"])
        self.assertEqual(got, ["acme/bug-hunt "])

    def test_a_folder_does_not_get_one(self):
        """The next TAB has to be able to carry on into it."""
        _, got = self.complete("ferry sync store:acm", ["store:acme/"])
        self.assertEqual(got, ["acme/"])

    def test_a_store_name_does_not_get_one_either(self):
        """`store:` is a store waiting for a path, not a finished word - a
        space there breaks the ref outright."""
        _, got = self.complete("ferry sync --memory priv", ["private:"])
        self.assertEqual(got, ["private:"])

    def test_nothing_is_appended_while_the_choice_is_open(self):
        _, got = self.complete("ferry sync store:b",
                               ["store:acme/", "store:widgets/"])
        self.assertEqual(got, ["acme/", "widgets/"])

    def test_a_lone_command_gets_its_space_too(self):
        _, got = self.complete("ferry syn", ["sync"])
        self.assertEqual(got, ["sync "])

    def test_it_is_bound_to_a_checkout_run_by_path_too(self):
        """`./ferry` is how you run a checkout, and bash matches the word as
        typed - so registering only `ferry` leaves a checkout with no
        completion at all."""
        for b in self.bashes() or [None]:
            with self.subTest(bash=b):
                r = subprocess.run(
                    [b or "bash", "--norc", "-c",
                     f'. "{self.SCRIPT}"; complete -p ./ferry'],
                    capture_output=True, text=True)
                self.assertEqual(r.returncode, 0, r.stderr)
                self.assertIn("_ferry", r.stdout)

    def test_it_asks_the_ferry_that_was_typed(self):
        """Not whichever is on PATH: a checkout answers for itself, or
        completion describes the installed release while you run the working
        copy."""
        d = Path(tempfile.mkdtemp())
        # two "ferry"s, saying different things, to tell which one was asked
        for name, said in (("ferry", "FROM-PATH"), ("mine", "FROM-TYPED")):
            p = d / name
            p.write_text(f"#!/bin/sh\nprintf '%s\\n' {said}\n")
            p.chmod(0o755)
        env = dict(os.environ, PATH=f"{d}:{os.environ['PATH']}")
        r = subprocess.run(
            [(self.bashes() or ["bash"])[0], "--norc", "-c",
             f'. "{self.SCRIPT}"; COMP_LINE="{d}/mine sync "; '
             f'COMP_POINT=${{#COMP_LINE}}; COMP_WORDS=("{d}/mine" sync ""); '
             f'_ferry "{d}/mine" "" sync; printf "%s\\n" "${{COMPREPLY[@]}}"'],
            capture_output=True, text=True, env=env)
        self.assertIn("FROM-TYPED", r.stdout)
        self.assertNotIn("FROM-PATH", r.stdout)

    def test_a_name_that_cannot_run_falls_back(self):
        """An alias or a function cannot be run from a variable - expansion
        happens after alias expansion - so asking it would offer nothing at
        all, which is worse than asking the installed one."""
        d = Path(tempfile.mkdtemp())
        p = d / "ferry"
        p.write_text("#!/bin/sh\nprintf 'FELL-BACK\\n'\n")
        p.chmod(0o755)
        env = dict(os.environ, PATH=f"{d}:{os.environ['PATH']}")
        r = subprocess.run(
            [(self.bashes() or ["bash"])[0], "--norc", "-c",
             f'. "{self.SCRIPT}"; COMP_LINE="f sync "; '
             f'COMP_POINT=${{#COMP_LINE}}; COMP_WORDS=(f sync ""); '
             f'_ferry f "" sync; printf "%s\\n" "${{COMPREPLY[@]}}"'],
            capture_output=True, text=True, env=env)
        self.assertIn("FELL-BACK", r.stdout)

    def test_no_candidates_is_not_an_error(self):
        n, _ = self.complete("ferry sync store:zz", [])
        self.assertEqual(n, 0)


class ZshCompletion(unittest.TestCase):
    """The zsh script, run by a real zsh.

    It had never run at all. It shipped with `#compdef ferry` on line 3 behind
    two comment lines - compinit reads the first line of an `_*` file and no
    further, so nothing was ever bound to the ferry command - and behind that,
    `local raw status`: zsh keeps `status` read-only as a synonym for `$?`, so
    the function aborted on its second line. Two bugs, both invisible to
    reading, neither reachable by any Python test.
    """

    SCRIPT = FERRY.parent / "completions" / "ferry.zsh"

    # compadd takes array *names*, so the stub has to expand them; -S '' is how
    # the script says "no space after this one".
    DRIVER = """
compadd() {
    local nospace=0 name=""
    while (( $# )); do
        case $1 in
            -S) nospace=1; shift 2 ;;
            -a) name=$2; shift 2 ;;
            *) shift ;;
        esac
    done
    local i
    for i in ${(P)name}; do print -r -- "$nospace $i"; done
}
_files() { print -r -- "FILES" }
BUFFER=$1
. $2
print -r -- "RC=$?"
"""

    def zsh(self):
        z = shutil.which("zsh") or "/bin/zsh"
        if not os.access(z, os.X_OK):
            self.skipTest("no zsh")
        if not self.SCRIPT.exists():
            self.skipTest("no completion script")
        return z

    def complete(self, line, candidates, exit=0):
        """What _ferry offers, with `ferry complete` stubbed out.

        Returns (rc, [(nospace, candidate)], stderr) - stderr matters here,
        because the read-only-status bug showed up only as a message.
        """
        z = self.zsh()
        d = Path(tempfile.mkdtemp())
        (d / "driver.zsh").write_text(self.DRIVER)
        stub = d / "ferry"
        stub.write_text("#!/bin/sh\n" +
                        ("printf '%s\\n' " +
                         " ".join(f"'{c}'" for c in candidates) + "\n"
                         if candidates else "") +
                        f"exit {exit}\n")
        stub.chmod(0o755)
        r = subprocess.run(
            [z, "-f", str(d / "driver.zsh"), line, str(self.SCRIPT)],
            capture_output=True, text=True,
            env=dict(os.environ, PATH=f"{d}:{os.environ['PATH']}"))
        added, rc = [], None
        for l in r.stdout.splitlines():
            if l.startswith("RC="):
                rc = int(l[3:])
            elif l == "FILES":
                added.append((None, "FILES"))
            elif l:
                n, _, c = l.partition(" ")
                added.append((int(n), c))
        return rc, added, r.stderr

    def test_the_function_runs_without_complaint(self):
        """The whole of what the read-only `status` bug looked like: a message
        on stderr and not one candidate."""
        rc, added, err = self.complete("ferry sess", ["sessions"])
        self.assertEqual(err, "")
        self.assertEqual(added, [(0, "sessions")])

    def test_compinit_registers_the_function(self):
        """Installed under fpath as `_ferry`, compinit has to bind it to the
        ferry command - the whole of what installing it is for."""
        z, d = self.zsh(), Path(tempfile.mkdtemp())
        (d / "sf").mkdir()
        shutil.copy(self.SCRIPT, d / "sf" / "_ferry")
        r = subprocess.run(
            [z, "-f", "-c",
             f'fpath=({d}/sf $fpath); autoload -Uz compinit; '
             f'compinit -u -d {d}/dump; print -r -- "${{_comps[ferry]:-none}}"'],
            capture_output=True, text=True)
        self.assertEqual(r.stdout.strip(), "_ferry",
                         "compinit did not bind ferry: " + r.stderr)

    def test_the_compdef_tag_is_the_first_line(self):
        """Said plainly, so the reason survives an edit to the header. What
        the tag names may grow; where it sits may not."""
        first = self.SCRIPT.read_text().splitlines()[0]
        self.assertTrue(first.startswith("#compdef "), first)
        self.assertIn("ferry", first.split())

    def test_it_is_bound_to_a_checkout_run_by_path_too(self):
