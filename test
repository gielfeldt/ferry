#!/usr/bin/env python3
"""ferry's tests.

    ./test            run everything
    ./test -v         with each case named

Self-contained on purpose: no git, no network, no ~/.claude, nothing installed.
Everything here is either a pure function or a file in a temporary directory,
so it runs the same on a laptop and on a fresh CI machine.

That rules out end-to-end coverage of the git side, which is deliberate for
now - those tests need a real repo and git-crypt, and they belong in a separate
script that CI can skip.
"""
import contextlib
import importlib.util
import io
import sys
import tempfile
import unittest
from pathlib import Path

FERRY = Path(__file__).resolve().parent / "ferry"


def load():
    """Import ferry, which has no .py suffix, as a module."""
    spec = importlib.util.spec_from_loader("ferry", loader=None)
    mod = importlib.util.module_from_spec(spec)
    mod.__file__ = str(FERRY)
    exec(compile(FERRY.read_text(), str(FERRY), "exec"), mod.__dict__)
    return mod


f = load()


@contextlib.contextmanager
def quiet():
    """Swallow the output of a command under test."""
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        yield out, err


def tmpfile(text, suffix=".jsonl"):
    fh = tempfile.NamedTemporaryFile("w", suffix=suffix, delete=False)
    fh.write(text)
    fh.close()
    return Path(fh.name)


class Slug(unittest.TestCase):
    """The name Claude Code derives for a directory. Getting this wrong means
    looking in the wrong place, silently."""

    def test_replaces_every_non_alphanumeric(self):
        self.assertEqual(f.slug_dir("/home/user/dev/my-app").name,
                         "-home-user-dev-my-app")

    def test_keeps_case_and_digits(self):
        self.assertEqual(f.slug_dir("/srv/App2/Thing_X").name,
                         "-srv-App2-Thing-X")

    def test_long_paths_are_truncated_with_a_hash(self):
        long = "/" + "/".join("segment%02d" % i for i in range(40))
        name = f.slug_dir(long).name
        self.assertLessEqual(len(name), f.SLUG_MAX + 16)
        self.assertGreater(len(name), f.SLUG_MAX)
        self.assertTrue(name.startswith("-segment00-"))

    def test_the_hash_is_stable_and_path_specific(self):
        a = "/" + "x" * 300
        b = "/" + "x" * 299 + "y"
        self.assertEqual(f.slug_dir(a).name, f.slug_dir(a).name)
        self.assertNotEqual(f.slug_dir(a).name, f.slug_dir(b).name)


class SplitRef(unittest.TestCase):
    """<store>:<path> parsing, including the paths it must refuse."""

    def test_splits_store_from_path(self):
        self.assertEqual(f.split_ref("work:acme/bug-hunt"),
                         ("work", "acme/bug-hunt"))

    def test_strips_surrounding_slashes(self):
        self.assertEqual(f.split_ref("work:/acme/"), ("work", "acme"))

    def test_requires_a_colon(self):
        with quiet(), self.assertRaises(SystemExit):
            f.split_ref("acme/bug-hunt")

    def test_rejects_escaping_the_store(self):
        for bad in ("work:../secrets", "work:acme/../../etc", "work:.ssh"):
            with self.subTest(bad=bad), quiet(), self.assertRaises(SystemExit):
                f.split_ref(bad)

    def test_empty_path_is_the_top_of_the_store_only_for_directories(self):
        self.assertEqual(f.split_ref("work:", directory=True), ("work", ""))
        with quiet(), self.assertRaises(SystemExit):
            f.split_ref("work:")


class NoteDescription(unittest.TestCase):
    """What `ferry memory` shows for each note."""

    def test_reads_frontmatter(self):
        p = tmpfile("---\nname: x\ndescription: Keeps it short\n---\n\nbody\n",
                    ".md")
        self.assertEqual(f.note_description(p), "Keeps it short")

    def test_unquotes_and_unescapes(self):
        p = tmpfile('---\ndescription: "He said \\"no\\""\n---\n', ".md")
        self.assertEqual(f.note_description(p), 'He said "no"')

    def test_falls_back_to_the_first_heading(self):
        p = tmpfile("---\nname: x\n---\n\n# A heading\n\ntext\n", ".md")
        self.assertEqual(f.note_description(p), "A heading")

    def test_falls_back_to_the_first_line(self):
        p = tmpfile("just a note\nmore\n", ".md")
        self.assertEqual(f.note_description(p), "just a note")

    def test_empty_file_is_empty(self):
        self.assertEqual(f.note_description(tmpfile("", ".md")), "")

    def test_missing_file_does_not_raise(self):
        self.assertEqual(f.note_description(Path("/nonexistent/x.md")), "")


class Layout(unittest.TestCase):
    """A store keeps sessions and memory in two trees. Nothing about that
    reaches the command line, so the mapping is the whole of it."""

    def test_a_session_ref_goes_under_sessions(self):
        self.assertEqual(f.in_store("acme/bug-hunt"), "sessions/acme/bug-hunt")

    def test_a_memory_ref_goes_under_memories(self):
        self.assertEqual(f.in_store("acme", memory=True), "memories/acme")

    def test_the_top_of_a_store_is_the_tree_itself(self):
        self.assertEqual(f.in_store(""), "sessions")
        self.assertEqual(f.in_store("", memory=True), "memories")

    def test_a_session_may_be_called_memory(self):
        """The thing that needed a flag before is now just a name."""
        self.assertEqual(f.in_store("acme/memory"), "sessions/acme/memory")
        self.assertNotEqual(f.in_store("acme/memory"),
                            f.in_store("acme", memory=True))

    def test_printing_strips_the_tree_again(self):
        for ref in ("acme/bug-hunt", "acme", "acme/memory", ""):
            for mem in (False, True):
                with self.subTest(ref=ref, memory=mem):
                    self.assertEqual(f.of_store(f.in_store(ref, mem)), ref)

    def test_a_folder_of_the_same_name_is_not_stripped_twice(self):
        self.assertEqual(f.of_store("sessions/sessions/x"), "sessions/x")


class OldLayout(unittest.TestCase):
    """A store written before the split must be named, not read as empty."""

    def store(self, *paths):
        d = Path(tempfile.mkdtemp())
        for p in paths:
            (d / p).parent.mkdir(parents=True, exist_ok=True)
            (d / p).write_text("x")
        return d

    def test_transcripts_in_the_old_place_are_found(self):
        d = self.store("acme/bug-hunt.jsonl", "acme/memory/note.md")
        self.assertEqual([p.name for p in f.old_layout(d)], ["bug-hunt.jsonl"])

    def test_a_split_store_is_not_flagged(self):
        d = self.store("sessions/acme/bug-hunt.jsonl", "memories/acme/note.md")
        self.assertEqual(f.old_layout(d), [])

    def test_an_empty_store_is_not_flagged(self):
        self.assertEqual(f.old_layout(Path(tempfile.mkdtemp())), [])

    def test_the_check_explains_what_to_run(self):
        d = self.store("acme/bug-hunt.jsonl")
        with quiet() as (_, err), self.assertRaises(SystemExit):
            f.check_layout(d, "work")
        self.assertIn("ferry migrate work", err.getvalue())


class PrintNotes(unittest.TestCase):
    """One printer for both `memory` here and `list` in a store, so a memory
    folder reads the same either way."""

    def mem(self):
        d = Path(tempfile.mkdtemp())
        (d / "one.md").write_text("---\ndescription: The first\n---\n")
        (d / "two.md").write_text("---\ndescription: The second\n---\n")
        return d

    def test_lists_the_notes_with_their_descriptions(self):
        with quiet() as (out, _):
            f.print_notes(self.mem())
        text = out.getvalue()
        self.assertIn("one.md", text)
        self.assertIn("The first", text)
        self.assertIn("two.md", text)

    def test_counts_the_index_without_listing_it_as_a_note(self):
        d = self.mem()
        (d / "MEMORY.md").write_text("- [One](one.md) - a\n- [Two](two.md) - b\n")
        with quiet() as (out, _):
            f.print_notes(d)
        text = out.getvalue()
        self.assertIn("index of 2 note(s)", text)
        self.assertEqual(text.count("MEMORY.md"), 1)

    def test_an_index_alone_still_prints(self):
        d = Path(tempfile.mkdtemp())
        (d / "MEMORY.md").write_text("- [One](one.md) - a\n")
        with quiet() as (out, _):
            f.print_notes(d)
        self.assertIn("index of 1 note(s)", out.getvalue())


class TranscriptFields(unittest.TestCase):
    """Reading identity out of a transcript, which is what makes the sidecar
    unnecessary and the collision check possible."""

    def test_finds_the_session_id(self):
        p = tmpfile('{"type":"mode"}\n{"sessionId":"abc-123","type":"user"}\n')
        self.assertEqual(f.session_id_of(p), "abc-123")

    def test_returns_none_without_one(self):
        self.assertIsNone(f.session_id_of(tmpfile('{"type":"mode"}\n')))

    def test_survives_malformed_lines(self):
        p = tmpfile('not json at all\n{"sessionId":"abc-123"}\n')
        self.assertEqual(f.session_id_of(p), "abc-123")

    def test_finds_the_session_name(self):
        p = tmpfile('{"type":"mode"}\n'
                    '{"type":"custom-title","customTitle":"bug-hunt"}\n')
        self.assertEqual(f.session_name(p), "bug-hunt")

    def test_the_last_name_wins(self):
        p = tmpfile('{"type":"custom-title","customTitle":"first"}\n'
                    '{"type":"custom-title","customTitle":"second"}\n')
        self.assertEqual(f.session_name(p), "second")

    def test_an_unnamed_session_has_no_name(self):
        self.assertIsNone(f.session_name(tmpfile('{"type":"mode"}\n')))

    def test_a_branch_argument_is_not_this_sessions_name(self):
        """A /branch names the child; only custom-title names this one."""
        p = tmpfile('{"type":"system","subtype":"local_command","content":'
                    '"<command-name>/branch</command-name><command-args>'
                    'child-name</command-args>"}\n'
                    '{"type":"custom-title","customTitle":"my-name"}\n')
        self.assertEqual(f.session_name(p), "my-name")

    def test_finds_the_ai_title(self):
        p = tmpfile('{"a":1}\n{"aiTitle":"Fix the parser"}\n')
        self.assertEqual(f.ai_title(p), "Fix the parser")

    def test_first_prompt_is_the_opening_line(self):
        p = tmpfile('{"type":"mode"}\n'
                    '{"type":"user","message":{"content":"Fix the parser"}}\n')
        self.assertEqual(f.first_prompt(p), "Fix the parser")

    def test_first_prompt_skips_injected_context(self):
        """<system-reminder> and friends are not something the user typed."""
        p = tmpfile('{"type":"user","message":{"content":"<system-reminder>x"}}\n'
                    '{"type":"user","message":{"content":"the real one"}}\n')
        self.assertEqual(f.first_prompt(p), "the real one")

    def test_first_prompt_collapses_whitespace(self):
        p = tmpfile('{"type":"user","message":{"content":"a\\n\\n  b   c"}}\n')
        self.assertEqual(f.first_prompt(p), "a b c")

    def test_first_prompt_none_when_nothing_was_said(self):
        self.assertIsNone(f.first_prompt(tmpfile('{"type":"mode"}\n')))

    def test_no_ai_title_is_none(self):
        self.assertIsNone(f.ai_title(tmpfile('{"a":1}\n')))


class SizeDelta(unittest.TestCase):
    """What a command reports having done, in place of an unchanging id."""

    def test_new_file(self):
        self.assertIn("new", f.size_delta(tmpfile("x" * 10),
                                          Path("/nonexistent/x.jsonl")))

    def test_unchanged(self):
        a, b = tmpfile("x" * 10), tmpfile("y" * 10)
        self.assertIn("unchanged", f.size_delta(a, b))

    def test_small_growth_is_bytes(self):
        a, b = tmpfile("x" * 1102), tmpfile("y" * 1000)
        self.assertIn("+102 bytes", f.size_delta(a, b))

    def test_large_growth_is_megabytes(self):
        a, b = tmpfile("x" * 2_000_000), tmpfile("y" * 1_000_000)
        self.assertIn("+1.0 MB", f.size_delta(a, b))

    def test_shrinking_is_reported_signed(self):
        a, b = tmpfile("x" * 10), tmpfile("y" * 100)
        self.assertIn("-90 bytes", f.size_delta(a, b))


class RefuseShrink(unittest.TestCase):
    """Transcripts only grow, so a shorter replacement means lost turns."""

    def setUp(self):
        self.small = tmpfile("x" * 10)
        self.big = tmpfile("x" * 100)

    def test_refuses_a_smaller_source(self):
        with quiet(), self.assertRaises(SystemExit):
            f.refuse_shrink(self.small, self.big, False, "saving")

    def test_allows_a_larger_source(self):
        f.refuse_shrink(self.big, self.small, False, "saving")

    def test_allows_the_same_size(self):
        f.refuse_shrink(self.small, self.small, False, "saving")

    def test_force_overrides(self):
        f.refuse_shrink(self.small, self.big, True, "saving")

    def test_a_missing_destination_is_fine(self):
        f.refuse_shrink(self.small, Path("/nonexistent/x.jsonl"), False, "saving")


class Completion(unittest.TestCase):
    """Candidates the shell asks for. Never reads a transcript, so it stays
    fast enough for a TAB press."""

    def complete(self, *words):
        sys.argv = ["ferry", "complete", *words]
        with quiet() as (out, _):
            f.main()
        return out.getvalue().split()

    def test_offers_the_commands(self):
        got = self.complete("ferry", "")
        for c in ("add", "save", "load", "list", "update", "sessions",
                  "memory", "stores"):
            self.assertIn(c, got)

    def test_filters_commands_by_prefix(self):
        self.assertEqual(self.complete("ferry", "lo"), ["load"])

    def test_offers_flags_for_the_command(self):
        got = self.complete("ferry", "save", "x", "-")
        self.assertIn("--memory", got)
        self.assertIn("--allow-plaintext", got)

    def test_does_not_offer_another_commands_flags(self):
        self.assertNotIn("--allow-plaintext", self.complete("ferry", "load", "-"))

    def complete_line(self, line):
        sys.argv = ["ferry", "complete", "--line", line]
        with quiet() as (out, _):
            f.main()
        return out.getvalue().split()

    def test_line_mode_keeps_a_colon_ref_whole(self):
        """bash splits on ':', so the line is parsed here instead."""
        self.assertEqual(self.complete_line("ferry lo"), ["load"])

    def test_line_mode_knows_a_trailing_space_starts_a_new_word(self):
        self.assertEqual(self.complete_line("ferry lo "), [])

    def test_line_mode_survives_an_unbalanced_quote(self):
        self.complete_line("ferry save \"unclosed")

    def test_move_completes(self):
        self.assertEqual(self.complete_line("ferry mo"), ["move"])
        self.assertIn("--memory", self.complete_line("ferry move -"))

    def test_move_source_follows_the_memory_flag(self):
        """Like load: --memory offers folders holding memory, plain offers
        sessions. The destination is a folder either way."""
        plain = self.complete_line("ferry move store:")
        mem = self.complete_line("ferry move --memory store:")
        if not plain and not mem:
            self.skipTest("no store registered in this environment")
        self.assertNotEqual(plain, mem)

    def test_memory_flag_completes(self):
        self.assertEqual(self.complete_line("ferry load --mem"), ["--memory"])

    def test_load_and_load_memory_are_mirror_images(self):
        """Neither should offer what the other takes."""
        plain = self.complete_line("ferry load store:")
        mem = self.complete_line("ferry load --memory store:")
        if not plain and not mem:
            self.skipTest("no store registered in this environment")
        self.assertFalse([c for c in plain if c.endswith("/memory")],
                         "plain load offered a memory directory")
        self.assertFalse([c for c in mem if c.endswith("/memory")],
                         "--memory offered the memory/ instead of its parent")

    def test_complete_is_hidden_from_help(self):
        self.assertNotIn("complete", f.USAGE)


class CommandLine(unittest.TestCase):
    """Argument parsing, stubbing the commands so nothing touches the disk."""

    def setUp(self):
        self.calls = []
        self.originals = {}
        for name in ("cmd_add", "cmd_stores", "cmd_sessions", "cmd_memory",
                     "cmd_save", "cmd_load", "cmd_move", "cmd_list",
                     "cmd_update", "cmd_migrate"):
            self.originals[name] = getattr(f, name)
            setattr(f, name, lambda args, n=name: self.calls.append((n, args)))

    def tearDown(self):
        for name, fn in self.originals.items():
            setattr(f, name, fn)

    def run_ferry(self, *argv):
        sys.argv = ["ferry", *argv]
        with quiet() as (out, err):
            f.main()
        return out.getvalue(), err.getvalue()

    def test_bare_ferry_prints_help(self):
        out, _ = self.run_ferry()
        self.assertIn("usage:", out)
        self.assertIn("ferry save", out)
        self.assertEqual(self.calls, [])

    def test_save_drops_the_word_to(self):
        self.run_ferry("save", "bug-hunt", "to", "work:acme")
        name, args = self.calls[0]
        self.assertEqual(name, "cmd_save")
        self.assertEqual(args.words, ["bug-hunt", "to", "work:acme"])
        self.assertFalse(args.memory)

    def test_save_works_without_to(self):
        self.run_ferry("save", "bug-hunt", "work:acme")
        self.assertEqual(self.calls[0][1].words, ["bug-hunt", "work:acme"])

    def test_save_memory_is_a_flag(self):
        self.run_ferry("save", "--memory", "to", "work:acme")
        self.assertTrue(self.calls[0][1].memory)

    def test_load_memory_is_a_flag(self):
        self.run_ferry("load", "--memory", "work:acme")
        name, args = self.calls[0]
        self.assertEqual(name, "cmd_load")
        self.assertTrue(args.memory)

    def test_load_drops_the_word_to(self):
        self.run_ferry("load", "work:acme/bug-hunt")
        self.assertEqual(self.calls[0][1].target, "work:acme/bug-hunt")

    def test_move_takes_two_refs(self):
        self.run_ferry("move", "work:acme/bug-hunt", "work:beta")
        name, args = self.calls[0]
        self.assertEqual(name, "cmd_move")
        self.assertEqual(args.source, "work:acme/bug-hunt")
        self.assertEqual(args.dest, "work:beta")
        self.assertFalse(args.memory)

    def test_move_memory_is_a_flag(self):
        """`acme/memory` could be either a session or a memory folder, so the
        flag decides here exactly as it does for save and load."""
        self.run_ferry("move", "--memory", "work:acme", "work:beta")
        self.assertTrue(self.calls[0][1].memory)

    def test_move_needs_both_ends(self):
        with quiet(), self.assertRaises(SystemExit):
            self.run_ferry("move", "work:acme/memory")

    def test_list_memory_is_a_flag(self):
        self.run_ferry("list", "--memory", "work:acme")
        name, args = self.calls[0]
        self.assertEqual(name, "cmd_list")
        self.assertTrue(args.memory)
        self.assertEqual(args.ref, "work:acme")

    def test_list_memory_needs_no_ref(self):
        self.run_ferry("list", "--memory")
        self.assertTrue(self.calls[0][1].memory)
        self.assertIsNone(self.calls[0][1].ref)

    def test_migrate_takes_a_store(self):
        self.run_ferry("migrate", "work")
        self.assertEqual(self.calls[0][0], "cmd_migrate")
        self.assertEqual(self.calls[0][1].name, "work")

    def test_bare_list_is_the_same_as_stores(self):
        self.run_ferry("list")
        self.assertEqual(self.calls[0][0], "cmd_list")
        self.assertIsNone(self.calls[0][1].ref)

    def test_unknown_command_exits(self):
        with quiet(), self.assertRaises(SystemExit):
            sys.argv = ["ferry", "frobnicate"]
            f.main()

    def test_version_exits_cleanly(self):
        with quiet() as (out, _), self.assertRaises(SystemExit) as e:
            sys.argv = ["ferry", "--version"]
            f.main()
        self.assertEqual(e.exception.code, 0)

    def test_every_command_in_the_usage_block_is_real(self):
        """The synopsis is documentation; it should not drift from the parser."""
        commands = {line.split()[1] for line in f.USAGE.splitlines()
                    if line.strip().startswith("ferry ")}
        for c in commands:
            with self.subTest(command=c):
                with quiet(), self.assertRaises(SystemExit) as e:
                    sys.argv = ["ferry", c, "--help"]
                    f.main()
                self.assertEqual(e.exception.code, 0)


if __name__ == "__main__":
    unittest.main(verbosity=2 if "-v" in sys.argv else 1)
